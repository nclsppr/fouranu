---
import { localeFromPath, type Locale } from "@/i18n/config";
import { PROOF_COPY } from "@/i18n/common";

interface Props {
  code: "FAB" | "T-MES" | "T-OBS" | "FAN-SYN" | "FAN-INF";
  locale?: Locale;
}

const { code, locale = localeFromPath(Astro.url.pathname) } = Astro.props;
const { names, labels } = PROOF_COPY[locale];
---

<span
  class="proof-label"
  aria-label={names[code]}
  title={names[code]}
>
  {labels[code]}
</span>
