---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { staticAlternates, staticRoute, type Locale } from "@/i18n/config";
import { PRIVACY_COPY } from "@/i18n/trust-pages";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = PRIVACY_COPY[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={staticRoute("privacy", locale)}
  alternatePaths={staticAlternates("privacy")}
  indexable={true}
>
  <div class="page-shell">
    <Breadcrumbs locale={locale} items={[{ label: copy.home, href: staticRoute("home", locale) }, { label: copy.breadcrumb }]} />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="page-intro__lede">{copy.lead}</p>
      </div>
      <p class="page-intro__aside">{copy.aside}</p>
    </header>

    <section class="privacy-grid" aria-label={copy.gridAria}>
      <article><span>01</span><h2>{copy.items[0].heading}</h2><p>{copy.items[0].body}</p></article>
      <article><span>02</span><h2>{copy.items[1].heading}</h2><p>{copy.items[1].body}</p></article>
      <article><span>03</span><h2>{copy.items[2].heading}</h2><p>{copy.items[2].body}</p></article>
      <article><span>04</span><h2>{copy.items[3].heading}</h2><p>{copy.items[3].bodyBeforePartner}<strong>{copy.items[3].partnerId}</strong>{copy.items[3].bodyAfterPartner}</p></article>
    </section>

    <section class="privacy-contact">
      <div><p class="eyebrow">{copy.contactEyebrow}</p><h2>{copy.contactHeading}</h2></div>
      <div><p>{copy.contactBody}</p><a href="https://github.com/nclsppr/fouranu/issues/new" rel="external">{copy.githubLink}</a><br /><a href="https://www.cloudflare.com/policies/privacy/" rel="external">{copy.cloudflareLink}</a></div>
    </section>
  </div>
</BaseLayout>

<style>
  .privacy-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-block: 4rem;
  }

  .privacy-grid article {
    padding: 1.5rem;
    border-top: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
  }

  .privacy-grid article:nth-child(even) {
    border-right: 0;
  }

  .privacy-grid span {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.75rem;
  }

  .privacy-grid h2 {
    margin: 2rem 0 0.75rem;
    font-size: clamp(2rem, 3.3vw, 3rem);
    line-height: 1;
  }

  .privacy-grid p,
  .privacy-contact p {
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .privacy-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 2rem;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .privacy-contact .eyebrow,
  .privacy-contact a {
    color: var(--color-reading);
  }

  .privacy-contact h2 {
    margin: 0;
    font-size: clamp(2.7rem, 5vw, 4.7rem);
    line-height: 0.95;
  }

  .privacy-contact p {
    color: var(--color-carbon-muted);
  }

  .privacy-contact a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }

  @media (max-width: 48rem) {
    .privacy-grid,
    .privacy-contact {
      grid-template-columns: 1fr;
    }

    .privacy-grid article {
      border-right: 0;
    }

    .privacy-grid h2 {
      margin-top: 1.5rem;
    }

    .privacy-grid {
      padding-block: 3rem;
    }

    .privacy-contact {
      gap: 1.5rem;
      padding: 1.5rem;
    }
  }
</style>
