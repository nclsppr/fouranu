---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import AuthorPortrait from "@/components/AuthorPortrait.astro";
import { SITE } from "@/config/site";
import { localizedSite } from "@/i18n/common";
import { staticAlternates, staticRoute, type Locale } from "@/i18n/config";
import { AUTHORS_COPY } from "@/i18n/trust-pages";
import { assertMediaAllowedAtPath } from "@/lib/media-rights.mjs";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = AUTHORS_COPY[locale];
const localized = localizedSite(locale);
const canonical = new URL(staticRoute("authors", locale), SITE.url).toString();
const analyses = (await getCollection("analyses"))
  .filter((entry) => entry.data.locale === locale && entry.data.status === "publishable" && entry.data.indexable);
const authors = Object.entries(localized.authors).map(([id, author]) => ({
  id,
  ...author,
  articleCount: analyses.filter((entry) => entry.data.author === id).length,
}));
for (const author of authors) {
  assertMediaAllowedAtPath(author.portrait.large, locale, "schema-image", canonical);
}
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonical}#collection`,
  url: canonical,
  name: localized.editorialAuthor.name,
  inLanguage: localized.language,
  isPartOf: { "@id": `${SITE.url}/#website` },
  mainEntity: {
    "@type": "ItemList",
    itemListElement: authors.map((author, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Person",
        "@id": `${new URL(author.url, SITE.url).toString()}#person`,
        name: author.name,
        url: new URL(author.url, SITE.url).toString(),
        image: new URL(author.portrait.large, SITE.url).toString(),
      },
    })),
  },
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={canonical}
  alternatePaths={staticAlternates("authors")}
  indexable={true}
  schema={schema}
>
  <div class="page-shell">
    <Breadcrumbs locale={locale} items={[{ label: copy.home, href: staticRoute("home", locale) }, { label: copy.about, href: staticRoute("about", locale) }, { label: copy.breadcrumb }]} />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">{copy.introEyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="page-intro__lede">{copy.lead}</p>
      </div>
      <p class="page-intro__aside">{copy.aside}</p>
    </header>

    <section class="author-scope" aria-labelledby="author-scope-title">
      <div>
        <p class="eyebrow">{copy.scopeEyebrow}</p>
        <h2 id="author-scope-title">{copy.scopeHeading}</h2>
      </div>
      <div class="author-names">
        {authors.map((author) => (
          <article id={author.id}>
            <AuthorPortrait portrait={author.portrait} variant="hub" />
            <p>{author.role}</p>
            <h3>{author.name}</h3>
            <p>{author.summary}</p>
            <a href={author.url}>
              {copy.profileLink(author.name, author.articleCount)}
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="author-controls" aria-label={copy.controlsAria}>
      {copy.controls.map((control, index) => (
        <article><span>{String(index + 1).padStart(2, "0")}</span><h2>{control.heading}</h2><p>{control.body}</p></article>
      ))}
    </section>

    <nav class="author-links" aria-label={copy.linksAria}>
      <a href={staticRoute("method", locale)}>{copy.methodLink}</a>
      <a href={staticRoute("transparency", locale)}>{copy.transparencyLink}</a>
      <a href={staticRoute("corrections", locale)}>{copy.correctionsLink}</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .author-scope {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 2rem;
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .author-scope h2 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    line-height: 0.96;
  }

  .author-scope > div:last-child {
    max-width: none;
    color: var(--color-graphite);
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .author-names {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-carbon);
  }

  .author-names article {
    display: flex;
    min-height: 21rem;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.1rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: 1.5rem;
  }

  .author-names article:last-child {
    border-right: 0;
  }

  .author-names h3 {
    margin: 0.35rem 0 0.8rem;
    font-size: 2rem;
  }

  .author-names p {
    margin: 0;
    color: var(--color-graphite);
  }

  .author-names article > p:first-of-type {
    margin-top: 1.25rem;
    font-family: var(--font-data);
    font-size: 0.72rem;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .author-names a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: auto;
    padding-top: 1rem;
    color: var(--color-probe);
    font-weight: 600;
  }

  .author-controls {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-carbon);
  }

  .author-controls article {
    min-height: 14rem;
    padding: 1.5rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .author-controls article:last-child {
    border-right: 0;
  }

  .author-controls span {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.75rem;
  }

  .author-controls h2 {
    margin: 2.5rem 0 0.8rem;
    font-size: 2rem;
  }

  .author-controls p {
    color: var(--color-graphite);
    line-height: 1.6;
  }

  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: clamp(2.5rem, 4vw, 4rem);
    padding: 1rem;
    border-top: 2px solid var(--color-probe);
    border-bottom: 1px solid var(--color-line);
  }

  .author-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-probe);
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .author-scope,
    .author-controls,
    .author-names {
      grid-template-columns: 1fr;
    }

    .author-names article {
      min-height: auto;
      border-right: 0;
    }

    .author-names a {
      margin-top: 1rem;
    }

    .author-controls article {
      min-height: auto;
      border-right: 0;
    }

    .author-controls h2 {
      margin-top: 2.5rem;
    }
  }
</style>
