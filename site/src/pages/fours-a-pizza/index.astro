---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import DecisionFinder from "@/components/DecisionFinder.astro";
import { SITE } from "@/config/site";
import { isPublishedAnalysis } from "@/data/article-taxonomy";
import {
  articleRoute,
  staticAlternates,
  staticRoute,
  type ArticleId,
  type Locale,
} from "@/i18n/config";
import { localizedSite } from "@/i18n/common";
import { HUB_COPY } from "@/i18n/hubs";
import { assertResponsiveMediaAllowedAtPath } from "@/lib/media-rights.mjs";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = HUB_COPY.ovens[locale];
const localized = localizedSite(locale);

const modelDossiers = (await getCollection("analyses"))
  .filter(isPublishedAnalysis)
  .filter(
    (entry) =>
      entry.data.locale === locale &&
      entry.data.brand === "fours" &&
      entry.data.category === "oven",
  )
  .sort((a, b) => a.data.articleId.localeCompare(b.data.articleId));

if (modelDossiers.length === 0) {
  throw new Error(
    `Le guide Fours à pizza ${locale} exige des dossiers publiés.`,
  );
}
for (const entry of modelDossiers) {
  if (entry.data.image) {
    assertResponsiveMediaAllowedAtPath(entry.data.image.src, locale, "hub-list", staticRoute("ovens", locale));
  }
}

const canonical = new URL(staticRoute("ovens", locale), SITE.url).toString();
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      url: canonical,
      name: copy.schemaName,
      description: copy.schemaDescription,
      inLanguage: localized.language,
      isPartOf: { "@id": `${SITE.url}/#website` },
      mainEntity: { "@id": `${canonical}#dossiers` },
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#dossiers`,
      numberOfItems: modelDossiers.length,
      itemListElement: modelDossiers.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: new URL(articleRoute(entry.data.articleId as ArticleId, locale), SITE.url).toString(),
        name: entry.data.title,
      })),
    },
  ],
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={canonical}
  alternatePaths={staticAlternates("ovens")}
  indexable={true}
  schema={schema}
>
  <div class="page-shell">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: copy.home, href: staticRoute("home", locale) },
        { label: copy.breadcrumb },
      ]}
    />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">{copy.introEyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="page-intro__lede">{copy.lead}</p>
      </div>
      <p class="page-intro__aside">{copy.aside}</p>
    </header>

    <DecisionFinder locale={locale} />

    <div class="constraint-list">
      {copy.constraints.map((constraint) => (
        <section id={constraint.id}>
          <span>{constraint.label}</span>
          <div>
            <h2>{constraint.heading}</h2>
            <p>{constraint.body}</p>
          </div>
          {"link" in constraint ? (
            <a href={articleRoute("OONI-004", locale)}>{constraint.link} <span aria-hidden="true">↗</span></a>
          ) : (
            <p class="constraint-list__check">{constraint.check}</p>
          )}
        </section>
      ))}
    </div>

    <section class="model-dossiers" aria-labelledby="model-dossiers-title">
      <header class="model-dossiers__head">
        <p class="eyebrow">{copy.dossiersEyebrow}</p>
        <h2 id="model-dossiers-title">{copy.dossiersHeading}</h2>
        <p>{copy.dossiersBody}</p>
      </header>

      <div class="model-dossiers__list">
        {modelDossiers.map((entry) => (
          <a class:list={["model-dossier", !entry.data.image && "model-dossier--text"]} href={articleRoute(entry.data.articleId as ArticleId, locale)}>
            {entry.data.image && <span class="model-dossier__image">
              <img
                src={entry.data.image.src}
                srcset={`${entry.data.image.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image.src} 1600w`}
                sizes="(max-width: 48rem) 100vw, 36vw"
                alt={entry.data.image.alt}
                width="1600"
                height="900"
                loading="lazy"
              />
            </span>}
            <span class="model-dossier__copy">
              <span class="eyebrow">{entry.data.model}</span>
              <strong>{entry.data.title}</strong>
              <span>{entry.data.summary}</span>
              <span class="model-dossier__meta">
                {copy.by} {localized.authors[entry.data.author].name}
                <b>{copy.read} <span aria-hidden="true">↗</span></b>
              </span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <aside class="next-step">
      <p class="eyebrow">{copy.nextEyebrow}</p>
      <h2>{copy.nextHeading}</h2>
      <p>{copy.nextBody}</p>
      <div class="next-step__links">
        <a class="button-link" href={staticRoute("ooni", locale)}>{copy.ooniLink}</a>
        <a class="button-link button-link--quiet" href={staticRoute("gozney", locale)}>{copy.gozneyLink}</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .constraint-list {
    border-top: 1px solid var(--color-carbon);
  }

  .constraint-list section {
    display: grid;
    grid-template-columns: 1fr 5fr 3fr;
    gap: 1.5rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: 2rem;
  }

  .constraint-list section > span,
  .constraint-list__check {
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .constraint-list h2 {
    max-width: 19ch;
    margin-bottom: 0.5rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
  }

  .constraint-list section > div p {
    max-width: 48rem;
    margin-bottom: 0;
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .constraint-list section > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-self: end;
    align-items: center;
    color: var(--color-probe);
    font-weight: 600;
  }

  .model-dossiers {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--color-carbon);
  }

  .model-dossiers__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .model-dossiers__head .eyebrow {
    grid-column: 1 / -1;
  }

  .model-dossiers__head h2 {
    grid-column: 1 / span 8;
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 5rem);
    line-height: 0.96;
  }

  .model-dossiers__head > p:last-child {
    grid-column: 9 / -1;
    max-width: 60ch;
    margin: 0;
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .model-dossiers__list {
    border-top: 1px solid var(--color-carbon);
  }

  .model-dossier {
    display: grid;
    grid-template-columns: minmax(16rem, 5fr) minmax(0, 7fr);
    gap: 1.5rem;
    min-height: 2.75rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .model-dossier--text { grid-template-columns: minmax(0, 1fr); }
  .model-dossier--text .model-dossier__copy strong { max-width: 30ch; }

  .model-dossier:focus-visible {
    outline: 2px solid var(--color-probe);
    outline-offset: 4px;
  }

  .model-dossier__image {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-steel-soft);
  }

  .model-dossier__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 180ms ease;
  }

  .model-dossier__copy {
    display: grid;
    align-content: start;
    gap: 0.9rem;
  }

  .model-dossier__copy strong {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 4.2rem);
    font-weight: 600;
    line-height: 0.96;
  }

  .model-dossier__copy > span:not(.eyebrow, .model-dossier__meta) {
    max-width: 60ch;
    color: var(--color-graphite);
    font-family: var(--font-body);
    line-height: 1.6;
  }

  .model-dossier__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .model-dossier__meta b {
    color: var(--color-probe);
    font-weight: 600;
  }

  .model-dossier:hover .model-dossier__image img {
    transform: scale(1.015);
  }

  @media (prefers-reduced-motion: reduce) {
    .model-dossier__image img {
      transition: none;
    }

    .model-dossier:hover .model-dossier__image img {
      transform: none;
    }
  }

  .next-step {
    display: grid;
    grid-template-columns: 4fr 4fr 3fr;
    gap: 1.5rem;
    align-items: end;
    margin-top: 4rem;
    padding: 2rem;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .next-step .eyebrow {
    grid-column: 1 / -1;
    color: var(--color-reading);
  }

  .next-step h2 {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    line-height: 0.95;
  }

  .next-step > p:not(.eyebrow) {
    margin: 0;
    color: var(--color-carbon-muted);
    line-height: 1.6;
  }

  .next-step .button-link {
    color: var(--color-carbon);
    border-color: var(--color-reading);
    background: var(--color-reading);
  }

  .next-step__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .next-step .button-link--quiet {
    color: var(--color-white);
    border-color: var(--color-carbon-line);
    background: transparent;
  }

  .next-step .button-link--quiet:hover {
    color: var(--color-carbon);
    border-color: var(--color-reading);
    background: var(--color-reading);
  }

  @media (max-width: 64rem) {
    .constraint-list section {
      grid-template-columns: 4.5rem minmax(0, 1fr);
    }

    .constraint-list__check,
    .constraint-list section > a {
      grid-column: 2;
      justify-self: start;
    }

    .constraint-list section > a {
      align-self: start;
    }
  }

  @media (max-width: 48rem) {
    .constraint-list section,
    .next-step,
    .model-dossiers__head,
    .model-dossier {
      grid-template-columns: 1fr;
    }

    .constraint-list section {
      gap: 1rem;
      padding-block: 1.5rem;
    }

    .constraint-list__check,
    .constraint-list section > a {
      grid-column: 1;
    }

    .next-step .eyebrow {
      grid-column: 1;
    }

    .model-dossiers__head .eyebrow,
    .model-dossiers__head h2,
    .model-dossiers__head > p:last-child {
      grid-column: 1;
    }

    .model-dossier {
      gap: 1rem;
    }

    .next-step {
      margin-top: 3rem;
      padding: 1.5rem;
    }
  }
</style>
