---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { SITE } from "@/config/site";

const analyses = (await getCollection("analyses"))
  .filter((entry) => entry.data.status === "publishable");
const modelEntries = analyses.filter((entry) => entry.data.type === "model");
const entriesById = new Map(modelEntries.map((entry) => [entry.id, entry]));
const dateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const ranges = [
  {
    id: "koda",
    name: "Koda",
    energy: "Gaz",
    articleIds: ["koda-2", "koda-2-pro", "koda-2-max", "koda-12", "koda-16"],
  },
  {
    id: "karu",
    name: "Karu",
    energy: "Multi-combustible",
    articleIds: ["karu-2", "karu-2-pro", "karu-12"],
  },
  {
    id: "volt",
    name: "Volt",
    energy: "Électrique",
    articleIds: ["volt-2"],
  },
].map((range) => ({
  ...range,
  models: range.articleIds.map((articleId) => {
    const entry = entriesById.get(articleId);
    if (!entry) throw new Error(`Dossier Ooni absent : ${articleId}`);
    return entry;
  }),
}));

if (modelEntries.length !== 9) {
  throw new Error(`La page Ooni exige neuf fiches modèle, ${modelEntries.length} trouvée(s).`);
}

const canonical = new URL("/ooni/", SITE.url).toString();
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      url: canonical,
      name: "Les neuf fours Ooni vendus en France",
      description:
        "Dossiers documentaires sur les fours Ooni Koda, Karu et Volt vendus en France.",
      inLanguage: SITE.language,
      isPartOf: { "@id": `${SITE.url}/#website` },
      mainEntity: { "@id": `${canonical}#models` },
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#models`,
      numberOfItems: modelEntries.length,
      itemListElement: ranges.flatMap((range) => range.models).map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: new URL(`/ooni/${entry.id}/`, SITE.url).toString(),
        name: entry.data.title,
      })),
    },
  ],
};
---

<BaseLayout
  title="Fours Ooni 2026 : les 9 modèles de la gamme | Four à Nu"
  description="Les neuf fours Ooni vendus en France, classés par énergie et format avec un dossier sourcé pour chaque modèle Koda, Karu et Volt."
  indexable={true}
  schema={schema}
>
  <div class="page-shell">
    <Breadcrumbs items={[{ label: "Accueil", href: "/" }, { label: "Ooni" }]} />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">Catalogue France · vérifié le 23.08.2026</p>
        <h1>Comprendre la gamme Ooni avant de choisir un modèle.</h1>
        <p class="page-intro__lede">
          Les neuf fours autonomes vendus en France sont classés ici par
          énergie et format. Chaque lien ouvre un dossier daté qui sépare les
          annonces Ooni des mesures et observations publiées par des tiers.
        </p>
      </div>
      <p class="page-intro__aside">
        9 fiches modèle, 2 guides transversaux. Aucun classement général ni note
        ne masque les différences de protocole entre les sources.
      </p>
    </header>

    <section class="lead-analysis" aria-labelledby="lead-analysis-title">
      <p class="eyebrow">Deux guides d'abord</p>
      <h2 id="lead-analysis-title">Les décisions transversales avant les fiches produit.</h2>
      <div>
        <a class="link-row" href="/ooni/quel-four-ooni-choisir/">
          <span class="link-row__title">Quel four Ooni choisir en 2026&nbsp;?</span>
          <span class="link-row__meta">OONI-001 · Guide de gamme</span>
          <span class="link-row__arrow" aria-hidden="true">↗</span>
        </a>
        <a class="link-row" href="/ooni/gaz-electrique-ou-multicombustible/">
          <span class="link-row__title">Gaz, électrique ou multi-combustible&nbsp;?</span>
          <span class="link-row__meta">OONI-004 · Choix de l'énergie</span>
          <span class="link-row__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="ranges" aria-labelledby="ranges-title">
      <div class="ranges__head">
        <p class="eyebrow">Catalogue actuel</p>
        <h2 id="ranges-title">Trois familles</h2>
        <p>Chaque modèle renvoie vers un dossier sourcé et daté, sans classement artificiel.</p>
      </div>

      {ranges.map((range) => (
        <article class="range" id={range.id}>
          <header>
            <span>{String(range.models.length).padStart(2, "0")}</span>
            <h3>{range.name}</h3>
            <p>{range.energy}</p>
          </header>
          <div class="range__models">
            {range.models.map((entry: CollectionEntry<"analyses">) => (
              <a href={`/ooni/${entry.id}/`}>
                <span class="range__model-copy">
                  <strong>{entry.data.model}</strong>
                  <small>{entry.data.summary}</small>
                </span>
                <time datetime={entry.data.updatedAt.toISOString()}>
                  Mis à jour {dateFormatter.format(entry.data.updatedAt)}
                </time>
                <span class="range__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .lead-analysis {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-bottom: 1px solid var(--color-line);
  }

  .lead-analysis h2 {
    max-width: 18ch;
    margin-bottom: 3rem;
    font-size: clamp(2.7rem, 5vw, 4.7rem);
    line-height: 0.98;
  }

  .ranges {
    padding-top: clamp(4rem, 8vw, 7rem);
  }

  .ranges__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    margin-bottom: 3rem;
  }

  .ranges__head .eyebrow {
    grid-column: 1 / -1;
  }

  .ranges__head h2 {
    grid-column: 1 / span 7;
    margin: 0;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.95;
  }

  .ranges__head > p:last-child {
    grid-column: 9 / -1;
    align-self: end;
    margin: 0;
    color: var(--color-graphite);
  }

  .range {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 1.5rem;
    padding-block: 3rem;
    border-top: 1px solid var(--color-carbon);
    scroll-margin-top: 2rem;
  }

  .range header {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-content: start;
    gap: 0.2rem 1rem;
  }

  .range header > span,
  .range header p,
  .range__models span {
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .range header h3 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.9;
  }

  .range header p {
    grid-column: 2;
    margin: 0;
  }

  .range__models {
    border-top: 1px solid var(--color-line);
  }

  .range__models a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(9rem, auto) auto;
    gap: 1rem;
    align-items: center;
    min-height: 7rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .range__model-copy {
    display: grid;
    gap: 0.35rem;
  }

  .range__model-copy strong {
    font-family: var(--font-display);
    font-size: 1.45rem;
  }

  .range__model-copy small {
    max-width: 58ch;
    color: var(--color-graphite);
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.5;
    text-transform: none;
  }

  .range__models time,
  .range__arrow {
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.66rem;
    line-height: 1.4;
    text-align: right;
    text-transform: uppercase;
  }

  .range__models a:hover strong,
  .range__models a:hover .range__arrow {
    color: var(--color-probe);
  }

  @media (max-width: 48rem) {
    .ranges__head,
    .range {
      grid-template-columns: 1fr;
    }

    .ranges__head .eyebrow,
    .ranges__head h2,
    .ranges__head > p:last-child {
      grid-column: 1;
    }

    .range {
      gap: 2rem;
    }

    .range__models a {
      grid-template-columns: 1fr auto;
      min-height: 0;
      padding-block: 1.25rem;
    }

    .range__models time {
      grid-column: 1;
      grid-row: 2;
      text-align: left;
    }

    .range__arrow {
      grid-column: 2;
      grid-row: 1 / span 2;
    }
  }
</style>
