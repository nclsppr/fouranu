---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/config/site";

const analyses = (await getCollection("analyses"))
  .filter((entry) => entry.data.status === "publishable")
  .sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
const lead = analyses.find(
  (entry) => entry.data.brand === "ooni" && entry.id === "quel-four-ooni-choisir",
);
const energyGuide = analyses.find(
  (entry) => entry.data.brand === "ooni" && entry.id === "gaz-electrique-ou-multicombustible",
);
const models = analyses.filter(
  (entry) =>
    entry.data.brand === "ooni" &&
    entry.data.category === "oven" &&
    entry.data.type === "model",
);
const newDossierRefs = [
  { brand: "gozney", id: "quel-four-gozney-choisir" },
  { brand: "gozney", id: "dome-gen-2" },
  { brand: "gozney", id: "arc" },
  { brand: "gozney", id: "roccbox" },
] as const;
const newDossiers = newDossierRefs
  .map((reference) => analyses.find(
    (entry) => entry.data.brand === reference.brand && entry.id === reference.id,
  ))
  .filter((entry) => entry !== undefined);
const featuredModelIds = ["koda-2", "volt-2", "karu-2", "koda-2-max"];
const featuredModels = featuredModelIds
  .map((id) => models.find((entry) => entry.id === id))
  .filter((entry) => entry !== undefined);
const remainingModels = models.filter(
  (entry) => !featuredModelIds.includes(entry.id),
);
const citedEvidenceCount = new Set(
  analyses.flatMap((entry) => entry.data.evidenceIds),
).size;
const latestUpdate = new Date(
  Math.max(...analyses.map((entry) => entry.data.updatedAt.valueOf())),
);
const shortDateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
  timeZone: "UTC",
});
const longDateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const brandLabels = { ooni: "Ooni", gozney: "Gozney" } as const;
const categoryLabels = { oven: "Four à pizza", mixer: "Pétrins" } as const;

if (
  !lead ||
  !energyGuide ||
  featuredModels.length !== featuredModelIds.length ||
  newDossiers.length !== newDossierRefs.length
) {
  throw new Error("Les dossiers mis en avant sur l'accueil sont requis.");
}

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      alternateName: SITE.alternateName,
      inLanguage: SITE.language,
      description: SITE.description,
      publisher: { "@id": `${SITE.url}/#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${SITE.url}/#organization`,
      name: SITE.name,
      alternateName: SITE.alternateName,
      url: `${SITE.url}/`,
      description:
        "Média francophone indépendant qui publie des guides sourcés et vise à tester progressivement les fours à pizza vendus en France, les accessoires utiles et différents pétrins.",
      publishingPrinciples: `${SITE.url}/methode/`,
      logo: {
        "@type": "ImageObject",
        url: `${SITE.url}/brand/logo-fouranu.png`,
        contentUrl: `${SITE.url}/brand/logo-fouranu.png`,
        width: 480,
        height: 172,
      },
    },
  ],
};
---

<BaseLayout
  socialTitle="Notre ambition : tester tous les fours à pizza vendus en France"
  indexable={true}
  schema={schema}
>
  <section class="editorial-hero page-shell" aria-labelledby="home-title">
    <article class="lead-feature">
      <div class="lead-feature__copy">
        <p class="feature-kicker">Notre ambition</p>
        <h1 id="home-title">Tester tous les fours à pizza vendus en France.</h1>
        <p class="lead-feature__mission">
          Nous voulons couvrir les modèles des marques de référence, les
          accessoires qui comptent vraiment et différents pétrins. Aujourd’hui,
          nos guides sont des analyses documentaires sourcées&nbsp;; chaque futur
          essai mené par Four à Nu sera clairement signalé.
        </p>
        <h2 class="lead-feature__story-title">{lead.data.title}</h2>
        <p class="lead-feature__summary">{lead.data.summary}</p>
        <div class="lead-feature__filters" aria-label="Les premiers critères du guide">
          <span>Lieu</span>
          <span>Énergie</span>
          <span>Format</span>
          <span>Poids</span>
        </div>
        <a class="feature-action" href={`/${lead.data.brand}/${lead.id}/`}>
          Lire le guide
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="lead-feature__visual lead-feature__visual--documentary">
        <div class="lead-feature__visual-frame">
          <img
            src={lead.data.image.src}
            srcset={`${lead.data.image.src.replace("-1600.webp", "-960.webp")} 960w, ${lead.data.image.src} 1600w`}
            sizes="(max-width: 40rem) 100vw, 42vw"
            alt={lead.data.image.alt}
            width="1600"
            height="900"
            fetchpriority="high"
          />
        </div>
        <figcaption>{lead.data.image.caption}</figcaption>
      </figure>
    </article>

    <div class="hero-side">
      <a class="side-story" href={`/${energyGuide.data.brand}/${energyGuide.id}/`}>
        <span class="side-story__meta">Comparatif par usage · 01</span>
        <h2>{energyGuide.data.title}</h2>
        <p>{energyGuide.data.summary}</p>
        <span class="side-story__link">Comparer les énergies <span aria-hidden="true">→</span></span>
      </a>

      <a class="side-story side-story--dark" href="/fours-a-pizza/">
        <span class="side-story__meta">Guide de choix · 02</span>
        <h2>Quel four selon votre espace et votre façon de cuire&nbsp;?</h2>
        <p>Commencez par ce qui est possible chez vous. La marque et le chrono viennent après.</p>
        <span class="side-story__link">Partir de votre usage <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <section class="corpus-strip page-shell" aria-label="Repères Four à Nu">
    <div>
      <strong>{analyses.length}</strong>
      <span>guides disponibles</span>
    </div>
    <div>
      <strong>{citedEvidenceCount}</strong>
      <span>repères sourcés</span>
    </div>
    <div>
      <strong>Sans note</strong>
      <span>les usages comptent davantage</span>
    </div>
    <div>
      <strong>{longDateFormatter.format(latestUpdate)}</strong>
      <span>dernière mise à jour</span>
    </div>
  </section>

  {newDossiers.length > 0 && (
    <section class="new-dossiers page-shell" aria-labelledby="new-dossiers-title">
      <header>
        <p class="feature-kicker">Nouveaux guides</p>
        <h2 id="new-dossiers-title">Toute la gamme Gozney, sans vous noyer dans le catalogue.</h2>
        <p>
          Commencez par le guide complet, puis ouvrez seulement le dossier du
          format qui correspond à votre place, vos pizzas et votre budget.
        </p>
      </header>

      <div class="new-dossiers__list">
        {newDossiers.map((entry) => (
          <a href={`/${entry.data.brand}/${entry.id}/`}>
            <span class="new-dossiers__media">
              <img
                src={entry.data.image.src}
                srcset={`${entry.data.image.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image.src} 1600w`}
                sizes="(max-width: 48rem) 100vw, 11rem"
                alt={entry.data.image.alt}
                width="960"
                height="540"
                loading="lazy"
              />
            </span>
            <span class="new-dossiers__copy">
              <small>{brandLabels[entry.data.brand]} · {categoryLabels[entry.data.category]}</small>
              <strong>{entry.data.title}</strong>
              <span>{entry.data.summary}</span>
              <b>Par {SITE.authors[entry.data.author].name} · Lire →</b>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="featured-dossiers page-shell" aria-labelledby="featured-title">
    <header class="section-bar">
      <h2 id="featured-title">Choisir un modèle</h2>
      <a href="/ooni/">Voir les neuf modèles Ooni <span aria-hidden="true">→</span></a>
    </header>

    <div class="dossier-grid">
      {featuredModels.map((entry, index) => (
        <a class="dossier-card" href={`/${entry.data.brand}/${entry.id}/`}>
          <span class="dossier-card__media">
            <img
              src={entry.data.image.src}
              srcset={`${entry.data.image.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image.src} 1600w`}
              sizes="(max-width: 32rem) 100vw, (max-width: 56rem) 50vw, 25vw"
              alt={entry.data.image.alt}
              width="960"
              height="540"
              loading="lazy"
            />
            <span class="dossier-card__index">{String(index + 1).padStart(2, "0")}</span>
          </span>
          <span class="dossier-card__content">
            <span class="dossier-card__type">Guide d'achat</span>
            <h3>{entry.data.title}</h3>
            <span class="dossier-card__summary">{entry.data.summary}</span>
            <span class="dossier-card__meta">
              <span>Par {SITE.authors[entry.data.author].name}</span>
              <span>{shortDateFormatter.format(entry.data.updatedAt)}</span>
            </span>
            <span class="dossier-card__link">Lire <span aria-hidden="true">→</span></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="choice-guide">
    <div class="page-shell choice-guide__grid">
      <div class="choice-guide__intro">
        <p class="feature-kicker">Guide d'achat</p>
        <h2>Quatre questions pour réduire la liste.</h2>
        <p>
          Où pouvez-vous cuire et avec quelle énergie ? Le nombre de pizzas et
          le budget total départagent ensuite les modèles qui restent.
        </p>
        <a href="/fours-a-pizza/">Ouvrir le guide de choix <span aria-hidden="true">→</span></a>
      </div>

      <nav aria-label="Choisir un four à pizza par contrainte">
        <a href="/fours-a-pizza/#lieu">
          <span>01</span>
          <strong>Lieu</strong>
          <small>Intérieur, balcon, terrasse ou jardin</small>
          <b aria-hidden="true">→</b>
        </a>
        <a href="/fours-a-pizza/#energie">
          <span>02</span>
          <strong>Énergie</strong>
          <small>Électrique, gaz, bois ou charbon</small>
          <b aria-hidden="true">→</b>
        </a>
        <a href="/fours-a-pizza/#debit">
          <span>03</span>
          <strong>Rythme</strong>
          <small>Une pizza à la fois ou une série pour les invités</small>
          <b aria-hidden="true">→</b>
        </a>
        <a href="/fours-a-pizza/#cout">
          <span>04</span>
          <strong>Budget total</strong>
          <small>Four, table, pelle, énergie et entretien</small>
          <b aria-hidden="true">→</b>
        </a>
      </nav>
    </div>
  </section>

  <section class="reading-desk page-shell" aria-labelledby="reading-title">
    <div class="reading-desk__list">
      <header class="section-bar">
        <h2 id="reading-title">À parcourir ensuite</h2>
        <a href="/ooni/">Tous les dossiers <span aria-hidden="true">→</span></a>
      </header>

      <div class="compact-list">
        {remainingModels.map((entry) => (
          <a href={`/${entry.data.brand}/${entry.id}/`}>
            <span class="compact-list__media">
              <img
                src={entry.data.image.src}
                srcset={`${entry.data.image.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image.src} 1600w`}
                sizes="7.5rem"
                alt=""
                width="320"
                height="180"
                loading="lazy"
              />
            </span>
            <span class="compact-list__copy">
              <strong>{entry.data.title}</strong>
              <small>{entry.data.summary}</small>
              <small class="compact-list__byline">
                Par {SITE.authors[entry.data.author].name} · {shortDateFormatter.format(entry.data.updatedAt)}
              </small>
            </span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>

    <aside class="rss-panel">
      <p class="feature-kicker">Suivre Four à Nu</p>
      <h2>Les nouveaux dossiers, sans boîte mail à remplir.</h2>
      <p>
        Le flux RSS publie les nouveaux guides dès qu’ils sont prêts.
        Aucun formulaire, aucune promesse de fréquence.
      </p>
      <a class="feature-action" href="/rss.xml">
        Ouvrir le flux RSS
        <span aria-hidden="true">↗</span>
      </a>
      <small>Compatible avec votre lecteur RSS habituel.</small>
    </aside>
  </section>

  <section class="method-strip page-shell" aria-labelledby="method-title">
    <header class="section-bar">
      <div>
        <p class="feature-kicker">La méthode Four à Nu</p>
        <h2 id="method-title">Ce qu'annonce une marque n'est pas une mesure.</h2>
      </div>
      <a href="/methode/">Voir comment nous vérifions <span aria-hidden="true">→</span></a>
    </header>

    <div class="method-grid">
      <div>
        <span class="method-step">01</span>
        <h3>Nous attribuons chaque chiffre.</h3>
        <p>Une dimension ou une fonction annoncée renvoie à la marque qui la publie.</p>
      </div>
      <div>
        <span class="method-step">02</span>
        <h3>Nous gardons le contexte.</h3>
        <p>La durée, la météo et la façon de mesurer restent visibles lorsqu’elles comptent.</p>
      </div>
      <div>
        <span class="method-step">03</span>
        <h3>Une conclusion reste une conclusion.</h3>
        <p>Nous expliquons notre choix et ce que les sources ne permettent pas d’affirmer.</p>
      </div>
    </div>

    <nav class="trust-links" aria-label="Pages de confiance">
      <a href="/auteurs/redaction-four-a-nu/">La rédaction</a>
      <a href="/methode/">La méthode</a>
      <a href="/transparence/">La transparence commerciale</a>
      <a href="/corrections/">Les corrections</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .feature-kicker,
  .side-story__meta,
  .dossier-card__type,
  .dossier-card__date {
    font-family: var(--font-data);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .editorial-hero {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(18rem, 4fr);
    gap: 0.75rem;
    padding-block: 1.5rem 2rem;
  }

  .lead-feature {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    min-height: 30rem;
    overflow: hidden;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .lead-feature__copy {
    display: flex;
    position: relative;
    z-index: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.75rem, 3vw, 2.75rem);
  }

  .lead-feature .feature-kicker,
  .choice-guide .feature-kicker,
  .rss-panel .feature-kicker {
    color: var(--color-reading);
  }

  .lead-feature h1 {
    max-width: 10ch;
    margin: auto 0 0.8rem;
    font-size: clamp(3.15rem, 4.8vw, 4.9rem);
    line-height: 0.91;
    letter-spacing: -0.04em;
  }

  .lead-feature__story-title {
    max-width: 28ch;
    margin: 0 0 0.8rem;
    color: var(--color-white);
    font-size: clamp(1.35rem, 2.1vw, 1.8rem);
    line-height: 1.05;
  }

  .lead-feature__mission {
    max-width: 38rem;
    margin: 0 0 1.25rem;
    color: var(--color-carbon-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .lead-feature__summary {
    max-width: 38rem;
    color: var(--color-carbon-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .lead-feature__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .lead-feature__filters span {
    min-height: 2rem;
    padding: 0.42rem 0.58rem;
    border: 1px solid var(--color-carbon-line);
    font-family: var(--font-data);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .feature-action {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    color: var(--color-white);
    background: var(--color-probe);
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease-out, background 160ms ease-out, transform 160ms ease-out;
  }

  .feature-action:hover {
    color: var(--color-carbon);
    background: var(--color-white);
    transform: translateY(-2px);
  }

  .lead-feature__visual {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-end;
    margin: 0;
    padding: 1.5rem 1.5rem 1rem 0;
  }

  .lead-feature__visual img {
    width: 100%;
    height: auto;
    filter: invert(1) grayscale(1) contrast(1.15);
    mix-blend-mode: screen;
  }

  .lead-feature__visual--documentary {
    padding: 0;
  }

  .lead-feature__visual-frame {
    flex: 1;
    min-height: 30rem;
    overflow: hidden;
  }

  .lead-feature__visual-frame img {
    width: 100%;
    height: 100%;
    min-height: 30rem;
    object-fit: cover;
    filter: none;
    mix-blend-mode: normal;
  }

  .lead-feature__visual--documentary figcaption {
    padding: 0.5rem 0.75rem;
    border: 0;
    background: var(--color-carbon);
  }

  .lead-feature__visual figcaption {
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-carbon-line);
    color: var(--color-carbon-muted);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .hero-side {
    display: grid;
    gap: 0.75rem;
  }

  .side-story {
    display: flex;
    min-height: 0;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-line);
    background: var(--color-steel-soft);
    text-decoration: none;
    transition: border-color 160ms ease-out, transform 160ms ease-out;
  }

  .side-story:hover {
    border-color: var(--color-probe);
    transform: translateY(-2px);
  }

  .side-story__meta {
    color: var(--color-probe);
  }

  .side-story h2 {
    max-width: 13ch;
    margin: auto 0 0.75rem;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 0.96;
  }

  .side-story p {
    color: var(--color-graphite);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .side-story__link {
    margin-top: auto;
    color: var(--color-probe);
    font-weight: 600;
  }

  .side-story--dark {
    color: var(--color-white);
    border-color: var(--color-carbon);
    background: var(--color-carbon);
  }

  .side-story--dark .side-story__meta,
  .side-story--dark .side-story__link {
    color: var(--color-reading);
  }

  .side-story--dark p {
    color: var(--color-carbon-muted);
  }

  .corpus-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-block: 1.1rem;
    border-block: 1px solid var(--color-line);
  }

  .corpus-strip > div {
    padding-inline: 1.25rem;
    border-right: 1px solid var(--color-line);
  }

  .corpus-strip > div:first-child {
    padding-left: 0;
  }

  .corpus-strip > div:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .corpus-strip strong,
  .corpus-strip span {
    display: block;
  }

  .corpus-strip strong {
    margin-bottom: 0.3rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    line-height: 1;
  }

  .corpus-strip span {
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .featured-dossiers,
  .new-dossiers,
  .reading-desk,
  .method-strip {
    padding-block: clamp(2.5rem, 3.5vw, 3rem);
  }

  .new-dossiers {
    display: grid;
    grid-template-columns: minmax(15rem, 4fr) minmax(0, 8fr);
    gap: 1.5rem;
    border-bottom: 1px solid var(--color-line);
  }

  .new-dossiers > header {
    align-self: end;
  }

  .new-dossiers > header h2 {
    max-width: 14ch;
    margin-bottom: 0.75rem;
    font-size: clamp(2.2rem, 3.5vw, 3.5rem);
    line-height: 0.98;
  }

  .new-dossiers > header > p:last-child {
    max-width: 33rem;
    margin-bottom: 0;
    color: var(--color-graphite);
    line-height: 1.55;
  }

  .new-dossiers__list {
    border-top: 1px solid var(--color-carbon);
  }

  .new-dossiers__list > a {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr);
    gap: 1rem;
    min-height: 10rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .new-dossiers__media {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-steel-soft);
  }

  .new-dossiers__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .new-dossiers__copy {
    display: grid;
    align-content: center;
    gap: 0.35rem;
    min-width: 0;
  }

  .new-dossiers__copy small,
  .new-dossiers__copy b {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .new-dossiers__copy strong {
    font-family: var(--font-display);
    font-size: clamp(1.45rem, 2vw, 2rem);
    line-height: 1;
  }

  .new-dossiers__copy > span {
    color: var(--color-graphite);
    font-size: 0.85rem;
