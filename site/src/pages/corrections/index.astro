---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { staticAlternates, staticRoute, type Locale } from "@/i18n/config";
import { CORRECTIONS_COPY } from "@/i18n/trust-pages";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = CORRECTIONS_COPY[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={staticRoute("corrections", locale)}
  alternatePaths={staticAlternates("corrections")}
  indexable={true}
>
  <div class="page-shell">
    <Breadcrumbs locale={locale} items={[{ label: copy.home, href: staticRoute("home", locale) }, { label: copy.breadcrumb }]} />
    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="page-intro__lede">{copy.lead}</p>
      </div>
      <p class="page-intro__aside">{copy.aside}</p>
    </header>

    <section class="correction-steps">
      {copy.steps.map((step, index) => (
        <article><span>{String(index + 1).padStart(2, "0")}</span><h2>{step.heading}</h2><p>{step.body}</p></article>
      ))}
    </section>

    <section class="correction-contact">
      <div>
        <p class="eyebrow">{copy.contactEyebrow}</p>
        <h2>{copy.contactHeading}</h2>
      </div>
      <div>
        <p>{copy.contactBody}</p>
        <a class="button-link" href="https://github.com/nclsppr/fouranu/issues/new" rel="external">{copy.contactLink}</a>
      </div>
    </section>

    <section class="correction-log" aria-labelledby="correction-log-title">
      <p class="eyebrow">{copy.logEyebrow}</p>
      <h2 id="correction-log-title">{copy.logHeading}</h2>
      <p>{copy.logBody}</p>
    </section>
  </div>
</BaseLayout>

<style>
  .correction-steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-carbon);
  }

  .correction-contact {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 4rem;
    padding: 2rem;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .correction-contact .eyebrow {
    color: var(--color-reading);
  }

  .correction-contact h2 {
    margin: 0;
    font-size: clamp(2.6rem, 4.8vw, 4.5rem);
    line-height: 0.96;
  }

  .correction-contact > div:last-child {
    align-self: end;
  }

  .correction-contact > div:last-child p {
    color: var(--color-carbon-muted);
    line-height: 1.65;
  }

  .correction-contact .button-link {
    color: var(--color-carbon);
    border-color: var(--color-reading);
    background: var(--color-reading);
  }

  .correction-log {
    max-width: 52rem;
    padding-block: 4rem 0;
  }

  .correction-log h2 {
    margin-bottom: 1rem;
    font-size: clamp(2.2rem, 4vw, 3.8rem);
    line-height: 1;
  }

  .correction-log > p:last-child {
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .correction-steps article {
    padding: 1.5rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .correction-steps article:last-child {
    border-right: 0;
  }

  .correction-steps span {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.75rem;
  }

  .correction-steps h2 {
    margin: 2rem 0 0.75rem;
    font-size: 2.4rem;
  }

  .correction-steps p {
    color: var(--color-graphite);
    line-height: 1.6;
  }

  @media (max-width: 64rem) {
    .correction-steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .correction-steps article:nth-child(2) {
      border-right: 0;
    }

    .correction-steps article:last-child {
      grid-column: 1 / -1;
      border-right: 0;
    }
  }

  @media (max-width: 48rem) {
    .correction-steps,
    .correction-contact {
      grid-template-columns: 1fr;
    }

    .correction-steps article {
      border-right: 0;
    }

    .correction-steps article:last-child {
      grid-column: auto;
    }

    .correction-steps h2 {
      margin-top: 1.5rem;
    }

    .correction-contact {
      gap: 1.5rem;
      margin-top: 3rem;
      padding: 1.5rem;
    }

    .correction-log {
      padding-block: 3rem 0;
    }
  }
</style>
