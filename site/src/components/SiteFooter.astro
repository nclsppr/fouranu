---
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import {
  staticRoute,
  type Locale,
  type StaticRouteId,
} from "@/i18n/config";
import { SHELL_COPY } from "@/i18n/common";

interface Props {
  locale: Locale;
  alternatePaths: Record<Locale, string>;
}

const { locale, alternatePaths } = Astro.props;
const copy = SHELL_COPY[locale];
const year = 2026;
const footerLinks = [
  { routeId: "method", label: copy.footerLinks.method },
  { routeId: "corrections", label: copy.footerLinks.corrections },
  { routeId: "transparency", label: copy.footerLinks.transparency },
  { routeId: "privacy", label: copy.footerLinks.privacy },
  { routeId: "legal", label: copy.footerLinks.legal },
  { routeId: "contact", label: copy.footerLinks.contact },
  { routeId: "about", label: copy.footerLinks.about },
] as const satisfies readonly { routeId: StaticRouteId; label: string }[];
---

<footer class="site-footer">
  <div class="page-shell site-footer__grid">
    <div class="site-footer__identity">
      <a
        class="site-footer__brand"
        href={staticRoute("home", locale)}
        aria-label={copy.homeAria}
      >
        <img
          src="/brand/logo-fouranu.png"
          width="480"
          height="172"
          alt="Four à Nu"
          loading="lazy"
        />
      </a>
      <LanguageSwitcher
        locale={locale}
        alternatePaths={alternatePaths}
        variant="footer"
      />
    </div>

    <div class="site-footer__state">
      <span class="proof-dot" aria-hidden="true"></span>
      <p>{copy.footerState}</p>
    </div>

    <nav class="site-footer__links" aria-label={copy.footerNavAria}>
      {footerLinks.map((item) => (
        <a href={staticRoute(item.routeId, locale)}>{item.label}</a>
      ))}
    </nav>

    <div class="site-footer__bottom">
      <p class="site-footer__legal">© {year} Four à Nu · {copy.footerLegal}</p>
      <p class="site-footer__credit">
        {copy.footerCreditPrefix}{" "}
        <a href="https://nicolaspieper.com/" rel="author">NicolasPieper.com</a>
      </p>
    </div>
  </div>
</footer>
