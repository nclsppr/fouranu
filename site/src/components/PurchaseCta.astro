---
import type { PurchaseLink } from "@/data/purchase-links";
import { amazonAffiliateUrlForObject } from "@/data/commercial-objects.mjs";
import { affiliateRel, isAmazonLink, toAmazonAffiliateUrl } from "@/lib/amazon-affiliate.mjs";
import type { Locale } from "@/i18n/config";
import { PURCHASE_COPY, purchaseProductCopy } from "@/i18n/purchase";

interface Props {
  locale?: Locale;
  links: PurchaseLink[];
  variant: "primary" | "closing";
}

const { locale = "fr", links, variant } = Astro.props;
const copy = PURCHASE_COPY[locale];
const products = links.map((link) => {
  if (link.merchant !== "Amazon.fr" || !isAmazonLink(link.url)
    || link.url !== amazonAffiliateUrlForObject(link.objectId)) {
    throw new Error(`Destination affiliée non vérifiée : ${link.objectId}`);
  }
  return { link, ...purchaseProductCopy(link.objectId, locale) };
});
const title = variant === "closing" ? copy.closing : links.length > 1 ? copy.multiple : copy.single;
---

{products.length > 0 && <section id={variant === "primary" ? "acheter" : "acheter-fin"} class:list={["purchase-cta", `purchase-cta--${variant}`]} aria-label={copy.aria}>
  <p class="purchase-cta__eyebrow">{copy.eyebrow}</p>
  <p class="purchase-cta__title">{title}</p>
  <p class="purchase-cta__copy">{copy.guidance}</p>
  <p class="purchase-cta__disclosure">{copy.disclosure}</p>
  <ul class="purchase-cta__actions" role="list">
    {products.map(({ link, name, benefit }) => (
      <li class="purchase-cta__product">
        <div class="purchase-cta__context">
          <p class="purchase-cta__product-name">{name}</p>
          <p class="purchase-cta__benefit">{benefit}</p>
        </div>
        <a
          href={toAmazonAffiliateUrl(link.url)}
          rel={affiliateRel(link.url)}
          aria-label={`${copy.action} : ${name}`}
          data-affiliate="amazon"
          data-commercial-object={link.objectId}
          data-purchase-placement={variant}
        >
          {copy.action}
          <span aria-hidden="true">→</span>
        </a>
      </li>
    ))}
  </ul>
</section>}

<style>
  .purchase-cta {
    display: grid;
    gap: 0.75rem;
    max-width: var(--reading-width);
    min-width: 0;
    padding: clamp(1rem, 2.2vw, 1.5rem);
    border: 2px solid var(--color-carbon);
    scroll-margin-top: 1.5rem;
  }

  .purchase-cta--primary {
    margin-block: 0 1.75rem;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .purchase-cta--closing {
    margin-block: 2rem 0;
    background: var(--color-steel-soft);
  }

  .purchase-cta p { margin: 0; }

  .purchase-cta__eyebrow {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .purchase-cta--primary .purchase-cta__eyebrow { color: var(--color-reading); }

  .purchase-cta__title {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.25rem);
    font-weight: 600;
    line-height: 1.08;
  }

  .purchase-cta__copy,
  .purchase-cta__benefit {
    color: var(--color-graphite);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .purchase-cta__disclosure {
    color: var(--color-graphite);
    font-size: 0.75rem;
    line-height: 1.5;
  }

  .purchase-cta--primary :is(.purchase-cta__copy, .purchase-cta__benefit, .purchase-cta__disclosure) {
    color: var(--color-carbon-muted);
  }

  .purchase-cta .purchase-cta__actions {
    display: grid;
    margin: 0.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .purchase-cta .purchase-cta__product {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    gap: 1rem;
    align-items: center;
    margin: 0;
    padding-block: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .purchase-cta__product:last-child { padding-bottom: 0; }
  .purchase-cta--primary .purchase-cta__product { border-color: var(--color-carbon-line); }
  .purchase-cta__context { min-width: 0; }

  .purchase-cta .purchase-cta__product-name {
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .purchase-cta__title,
  .purchase-cta__product-name,
  .purchase-cta__benefit,
  .purchase-cta__actions a { overflow-wrap: anywhere; }

  .purchase-cta__actions a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.75rem;
    color: var(--color-white);
    background: var(--color-probe);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.4;
    text-decoration: none;
  }

  .purchase-cta__actions a > span { flex-shrink: 0; }
  .purchase-cta__actions a:hover { text-decoration: underline; text-decoration-thickness: 2px; }
  .purchase-cta--primary a:focus-visible { outline-color: var(--color-reading); }

  @media (min-width: 48.01rem) {
    .purchase-cta__actions a { white-space: nowrap; }
  }

  @media (max-width: 48rem) {
    .purchase-cta .purchase-cta__product { grid-template-columns: minmax(0, 1fr); gap: 0.75rem; }
    .purchase-cta__actions a { width: 100%; }
  }
</style>
