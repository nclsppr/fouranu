---
import { getCollection, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import AuthorPortrait from "@/components/AuthorPortrait.astro";
import { SITE } from "@/config/site";
import { isPublishedAnalysis } from "@/data/article-taxonomy";
import { PURCHASE_LINKS_BY_ARTICLE } from "@/data/purchase-links";
import { amazonAffiliateUrlForObject } from "@/data/commercial-objects.mjs";
import { affiliateRel } from "@/lib/amazon-affiliate.mjs";
import { localizedSite } from "@/i18n/common";
import { articleRoute, feedPath, staticAlternates, staticRoute, type ArticleId, type Locale } from "@/i18n/config";
import { HOME_COPY, HOME_FEATURED_ARTICLE_IDS } from "@/i18n/home";
import { assertMediaAllowedAtPath, assertResponsiveMediaAllowedAtPath } from "@/lib/media-rights.mjs";

interface Props { locale?: Locale; }
const { locale = "fr" } = Astro.props;
const copy = HOME_COPY[locale];
const localized = localizedSite(locale);
const homePath = staticRoute("home", locale);
const analyses = (await getCollection("analyses")).filter((entry) => entry.data.locale === locale && isPublishedAnalysis(entry));
function featured(articleId: ArticleId): CollectionEntry<"analyses"> {
  const entry = analyses.find((candidate) => candidate.data.articleId === articleId);
  if (!entry?.data.image) throw new Error(`${copy.requiredError} ${articleId}`);
  assertResponsiveMediaAllowedAtPath(entry.data.image.src, locale, "hub-list", homePath);
  return entry;
}
function purchaseLink(articleId: ArticleId) {
  const links = PURCHASE_LINKS_BY_ARTICLE[articleId];
  if (links?.length !== 1 || links[0].merchant !== "Amazon.fr"
    || links[0].url !== amazonAffiliateUrlForObject(links[0].objectId)) {
    throw new Error(`One exact affiliate offer is required for home feature ${articleId}`);
  }
  return links[0];
}
const lead = featured(HOME_FEATURED_ARTICLE_IDS.lead);
const leadPurchaseLink = purchaseLink(HOME_FEATURED_ARTICLE_IDS.lead);
const accessories = HOME_FEATURED_ARTICLE_IDS.accessories.map((id) => ({ entry: featured(id), label: copy.accessories.labels[id] }));
const ovens = HOME_FEATURED_ARTICLE_IDS.ovens.map((id) => ({ entry: featured(id), label: copy.ovens.labels[id], purchase: purchaseLink(id) }));
const authors = Object.values(localized.authors);
assertMediaAllowedAtPath("/brand/logo-fouranu.png", locale, "schema-image", homePath);
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite", "@id": `${SITE.url}/#website`, url: `${SITE.url}/`, name: SITE.name,
      alternateName: SITE.alternateName, inLanguage: ["fr-FR", "en", "de-DE"],
      description: localized.description, publisher: { "@id": `${SITE.url}/#organization` },
    },
    {
      "@type": "Organization", "@id": `${SITE.url}/#organization`, name: SITE.name,
      alternateName: SITE.alternateName, url: `${SITE.url}/`, description: copy.organizationDescription,
      publishingPrinciples: new URL(staticRoute("method", "fr"), SITE.url).toString(),
      logo: { "@type": "ImageObject", url: `${SITE.url}/brand/logo-fouranu.png`, contentUrl: `${SITE.url}/brand/logo-fouranu.png`, width: 480, height: 172 },
    },
  ],
};
---

<BaseLayout title={localized.title} socialTitle={copy.socialTitle} description={localized.description} canonical={homePath} alternatePaths={staticAlternates("home")} indexable={true} schema={schema}>
  <section class="editorial-hero page-shell" aria-labelledby="home-title">
    <div class="hero-copy">
      <p class="eyebrow">{copy.hero.kicker}</p>
      <h1 id="home-title">{copy.hero.title}</h1>
      <p class="hero-mission">{copy.hero.mission}</p>
      <div class="hero-actions">
        <a class="button-link" href="#nos-fours">{copy.hero.action} <span aria-hidden="true">→</span></a>
        <a class="text-action" href="#nos-accessoires">{copy.hero.accessoriesAction} <span aria-hidden="true">↗</span></a>
      </div>
      <a class="hero-team" href={staticRoute("authors", locale)}>
        <span class="hero-team__portraits" aria-hidden="true">
          {authors.map((author) => <AuthorPortrait portrait={author.portrait} variant="hub" />)}
        </span>
        <span><strong>Nicolas, Florian &amp; Magali</strong><span>{copy.hero.byline} <span aria-hidden="true">→</span></span></span>
      </a>
    </div>
    <article class="lead-feature">
      <figure class="lead-feature__visual lead-feature__visual--documentary">
        <a class="lead-feature__visual-frame" href={articleRoute(lead.data.articleId as ArticleId, locale)} aria-label={copy.hero.read}>
          <img src={lead.data.image!.src} srcset={`${lead.data.image!.src.replace("-1600.webp", "-960.webp")} 960w, ${lead.data.image!.src} 1600w`} sizes="(max-width: 48rem) 100vw, 44vw" alt={lead.data.image!.alt} width="1600" height="900" fetchpriority="high" />
        </a>
        <figcaption>{lead.data.image!.caption}</figcaption>
      </figure>
      <div class="lead-feature__copy">
        <p class="eyebrow">{copy.hero.featured}</p>
        <h2><a href={articleRoute(lead.data.articleId as ArticleId, locale)}>{lead.data.title}</a></h2>
        <p>{lead.data.summary}</p>
        <div class="home-purchase">
          <p class="home-purchase__disclosure"><a href={staticRoute("transparency", locale)}>{copy.purchase.disclosure}</a></p>
          <a class="button-link" href={leadPurchaseLink.url} rel={affiliateRel(leadPurchaseLink.url)} data-affiliate="amazon" data-commercial-object={leadPurchaseLink.objectId} data-purchase-placement="home-hero" aria-label={`${copy.purchase.action} : ${lead.data.model}`}>
            {copy.purchase.action} <span aria-hidden="true">↗</span>
          </a>
        </div>
        <a class="text-action" href={articleRoute(lead.data.articleId as ArticleId, locale)}>{copy.hero.read} <span aria-hidden="true">→</span></a>
      </div>
    </article>
  </section>

  <nav class="intent-nav page-shell" aria-label={copy.shortcuts.aria}>
    <a href={articleRoute("FOUR-007", locale)}><span aria-hidden="true">01</span>{copy.shortcuts.indoor}<b aria-hidden="true">→</b></a>
    <a href={articleRoute("FOUR-005", locale)}><span aria-hidden="true">02</span>{copy.shortcuts.outdoor}<b aria-hidden="true">→</b></a>
    <a href={articleRoute("FOUR-008", locale)}><span aria-hidden="true">03</span>{copy.shortcuts.budget}<b aria-hidden="true">→</b></a>
  </nav>

  <section class="accessories-section page-shell" id="nos-accessoires" aria-labelledby="accessories-title">
    <header class="section-heading">
      <div><p class="eyebrow">{copy.accessories.kicker}</p><h2 id="accessories-title">{copy.accessories.title}</h2></div>
      <div><p>{copy.accessories.summary}</p><a class="text-action" href={staticRoute("accessories", locale)}>{copy.accessories.action} <span aria-hidden="true">→</span></a></div>
    </header>
    <div class="accessories-grid">
      {accessories.map(({ entry, label }) => (
        <article class="accessory-card">
          <a class="accessory-card__image" href={articleRoute(entry.data.articleId as ArticleId, locale)} aria-label={label.title}>
            <img src={entry.data.image!.src} srcset={`${entry.data.image!.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image!.src} 1600w`} sizes="(max-width: 36rem) 100vw, (max-width: 64rem) 50vw, 25vw" alt={entry.data.image!.alt} width="960" height="540" loading="lazy" />
          </a>
          <div class="accessory-card__copy">
            <p class="byline">{copy.common.by} {localized.authors[entry.data.author].name}</p>
            <h3><a href={articleRoute(entry.data.articleId as ArticleId, locale)}>{label.title}</a></h3>
            <p>{label.summary}</p>
            <a class="text-action" href={articleRoute(entry.data.articleId as ArticleId, locale)}>{label.action} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}
    </div>
    <aside class="starter-kit">
      <div><p class="eyebrow">{copy.accessories.kitKicker}</p><h3>{copy.accessories.kitTitle}</h3><p>{copy.accessories.kitSummary}</p></div>
      <a class="button-link" href={articleRoute("FOUR-009", locale)}>{copy.accessories.kitAction} <span aria-hidden="true">→</span></a>
    </aside>
  </section>

  <section class="oven-section" id="nos-fours" aria-labelledby="ovens-title">
    <div class="page-shell">
      <header class="section-heading">
        <div><p class="eyebrow">{copy.ovens.kicker}</p><h2 id="ovens-title">{copy.ovens.title}</h2></div>
        <div><p>{copy.ovens.summary}</p><a class="text-action" href={staticRoute("ovens", locale)}>{copy.ovens.action} <span aria-hidden="true">→</span></a></div>
      </header>
      <div class="oven-grid">
        {ovens.map(({ entry, label, purchase }, index) => (
          <article class:list={["oven-card", index === 0 && "oven-card--lead"]}>
            <a class="oven-card__image" href={articleRoute(entry.data.articleId as ArticleId, locale)} aria-label={entry.data.title}>
              <img src={entry.data.image!.src} srcset={`${entry.data.image!.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image!.src} 1600w`} sizes={index === 0 ? "(max-width: 48rem) 100vw, 50vw" : "(max-width: 48rem) 100vw, (max-width: 64rem) 50vw, 25vw"} alt={entry.data.image!.alt} width="960" height="540" loading="lazy" />
            </a>
            <div class="oven-card__copy">
              <p class="eyebrow">{label}</p>
              <h3><a href={articleRoute(entry.data.articleId as ArticleId, locale)}>{entry.data.model}</a></h3>
              <p>{entry.data.summary}</p>
              <p class="byline">{copy.common.by} {localized.authors[entry.data.author].name}</p>
              <div class="home-purchase">
                <p class="home-purchase__disclosure"><a href={staticRoute("transparency", locale)}>{copy.purchase.disclosure}</a></p>
                <a class="button-link" href={purchase.url} rel={affiliateRel(purchase.url)} data-affiliate="amazon" data-commercial-object={purchase.objectId} data-purchase-placement="home-oven" aria-label={`${copy.purchase.action} : ${entry.data.model}`}>
                  {copy.purchase.action} <span aria-hidden="true">↗</span>
                </a>
              </div>
              <a class="text-action" href={articleRoute(entry.data.articleId as ArticleId, locale)}>{copy.ovens.read} <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
      <p class="affiliate-note">{copy.transparency.disclosure} <a href={staticRoute("transparency", locale)}>{copy.transparency.commerce}</a>.</p>
    </div>
  </section>

  <section class="decision-section page-shell" aria-labelledby="comparison-title">
    <article class="decision-feature">
      <p class="eyebrow">{copy.comparison.kicker}</p>
      <h2 id="comparison-title">{copy.comparison.title}</h2>
      <p>{copy.comparison.summary}</p>
      <a class="button-link" href={articleRoute("FOUR-010", locale)}>{copy.comparison.action} <span aria-hidden="true">→</span></a>
    </article>
    <aside class="finder-feature">
      <span class="finder-feature__mark" aria-hidden="true">?</span>
      <h2>{copy.comparison.finderTitle}</h2>
      <p>{copy.comparison.finderSummary}</p>
      <a class="text-action" href={`${staticRoute("ovens", locale)}#trouver-mon-four`}>{copy.comparison.finderAction} <span aria-hidden="true">→</span></a>
    </aside>
  </section>

  <section class="journal-section page-shell" aria-labelledby="journal-title">
    <div><p class="eyebrow">{copy.journal.kicker}</p><h2 id="journal-title">{copy.journal.title}</h2><p>{copy.journal.summary}</p></div>
    <div class="journal-links"><span class="guide-count"><strong>{analyses.length}</strong> {copy.common.guides}</span><a class="text-action" href={staticRoute("authors", locale)}>{copy.journal.action} <span aria-hidden="true">→</span></a><a href={feedPath(locale)}>{copy.journal.rss}</a></div>
  </section>

  <aside class="transparency-note page-shell">
    <h2>{copy.transparency.title}</h2>
    <p>{copy.transparency.body}</p>
    <a class="text-action" href={staticRoute("method", locale)}>{copy.transparency.method} <span aria-hidden="true">→</span></a>
  </aside>
</BaseLayout>

<style>
  .editorial-hero { display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(0, 1fr); gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(2rem, 5vw, 4.5rem); }
  .hero-copy h1 { max-width: 13ch; margin: 1.5rem 0; font-size: clamp(3.5rem, 6.6vw, 6.3rem); line-height: .95; letter-spacing: -.045em; }
  .hero-mission { max-width: 40rem; margin: 0; color: var(--color-graphite); font-size: clamp(1rem, 1.4vw, 1.17rem); line-height: 1.7; }
  .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.5rem; margin-block: 1.8rem 2rem; }
  .button-link { gap: 1rem; justify-content: space-between; max-width: 100%; }
  h1, h2, h3, .button-link, .text-action { overflow-wrap: anywhere; }
  .text-action { display: inline-flex; align-items: center; gap: .7rem; min-height: 2.75rem; color: var(--color-probe); font-weight: 600; text-underline-offset: .25em; }
  .hero-team { display: flex; gap: .85rem; align-items: center; width: fit-content; text-decoration: none; }
  .hero-team__portraits { display: flex; flex-shrink: 0; padding-right: .45rem; }
  .hero-team__portraits :global(img) { width: 2.65rem; height: 2.65rem; border: 2px solid var(--color-white); border-radius: 50%; margin-right: -.45rem; }
  .hero-team strong, .hero-team > span:last-child > span { display: block; font-size: .8rem; line-height: 1.5; }
  .hero-team > span:last-child > span { color: var(--color-graphite); }
  .lead-feature { min-width: 0; background: var(--color-steel-soft); border-bottom: 3px solid var(--color-probe); }
  .lead-feature__visual { margin: 0; }
  .lead-feature__visual-frame { display: block; overflow: hidden; aspect-ratio: 16 / 9; }
  .lead-feature__visual-frame img { width: 100%; height: 100%; object-fit: cover; }
  .lead-feature__visual--documentary figcaption { padding: .65rem 1.25rem; color: var(--color-graphite); font-size: .73rem; line-height: 1.5; border-bottom: 1px solid var(--color-line); }
  .lead-feature__copy { padding: 1.4rem clamp(1.3rem, 2.5vw, 2rem) 1.2rem; }
  .lead-feature h2 { margin: .8rem 0; font-size: clamp(1.85rem, 2.7vw, 2.7rem); line-height: 1.03; }
  .lead-feature h2 a, .accessory-card h3 a, .oven-card h3 a { text-decoration: none; }
  .lead-feature h2 a:hover, .accessory-card h3 a:hover, .oven-card h3 a:hover { color: var(--color-probe); text-decoration: underline; text-underline-offset: .12em; }
  .lead-feature__copy > p:not(.eyebrow) { color: var(--color-graphite); line-height: 1.6; font-size: .9rem; }
  .intent-nav { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-block: 1px solid var(--color-carbon); }
  .intent-nav a { display: flex; gap: .8rem; align-items: center; min-height: 5rem; padding: 1rem 1.5rem; font-weight: 600; text-decoration: none; }
  .intent-nav a + a { border-left: 1px solid var(--color-line); }
  .intent-nav a > span { color: var(--color-probe); font-family: var(--font-data); font-size: .72rem; }
  .intent-nav b { margin-left: auto; color: var(--color-probe); }
  .intent-nav a:hover { background: var(--color-steel-soft); }
  .accessories-section, .decision-section { padding-block: clamp(3rem, 6vw, 5.5rem); scroll-margin-top: 1.5rem; }
  .section-heading { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(1.5rem, 5vw, 5rem); align-items: end; margin-bottom: 2.25rem; }
  .section-heading h2 { max-width: 18ch; margin: 1rem 0 0; font-size: clamp(2.7rem, 4.4vw, 4.5rem); line-height: .98; letter-spacing: -.025em; }
  .section-heading > div:last-child > p { max-width: 38rem; margin: 0 0 .5rem; color: var(--color-graphite); line-height: 1.7; }
  .accessories-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1.25rem; }
  .accessory-card { display: flex; flex-direction: column; min-width: 0; border-bottom: 1px solid var(--color-line); }
  .accessory-card__image { display: block; overflow: hidden; aspect-ratio: 4 / 3; background: var(--color-steel-soft); }
  .accessory-card__image img, .oven-card__image img { width: 100%; height: 100%; object-fit: cover; transition: transform 180ms ease-out; }
  .accessory-card__image:hover img, .oven-card__image:hover img { transform: scale(1.025); }
  .accessory-card__copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: 1.25rem 0 1rem; }
  .byline { margin: 0 0 .65rem; color: var(--color-graphite); font-family: var(--font-data); font-size: .72rem; }
  .accessory-card h3 { margin: 0; font-size: clamp(1.9rem, 2.6vw, 2.5rem); line-height: 1.03; }
  .accessory-card__copy > p:not(.byline) { margin: .8rem 0; color: var(--color-graphite); font-size: .91rem; line-height: 1.6; }
  .accessory-card .text-action { margin-top: auto; }
  .starter-kit { display: flex; justify-content: space-between; align-items: center; gap: 2rem; margin-top: 2.5rem; padding: 1.6rem 2rem; border-left: 3px solid var(--color-probe); background: var(--color-steel-soft); }
  .starter-kit h3 { max-width: 40ch; margin: .65rem 0; font-size: clamp(1.8rem, 3vw, 2.5rem); line-height: 1.08; }
  .starter-kit p:not(.eyebrow) { max-width: 55rem; margin: 0; color: var(--color-graphite); line-height: 1.6; }
  .starter-kit .button-link { flex-shrink: 0; }
  .oven-section { padding-block: clamp(3rem, 6vw, 5.5rem); background: var(--color-steel-soft); scroll-margin-top: 1.5rem; }
  .oven-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); align-items: stretch; gap: 2rem 1.5rem; }
  .oven-card { display: flex; flex-direction: column; min-width: 0; background: var(--color-white); }
  .oven-card--lead { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: center; }
  .oven-card__image { display: block; overflow: hidden; aspect-ratio: 16 / 9; }
  .oven-card__copy { display: flex; flex: 1; flex-direction: column; align-items: flex-start; padding: 1.3rem 1.5rem 1rem; }
  .oven-card .eyebrow { font-size: .65rem; }
  .oven-card h3 { margin: .85rem 0; font-size: clamp(1.8rem, 2.4vw, 2.45rem); line-height: 1.04; }
  .oven-card__copy > p:not(.eyebrow, .byline) { margin: 0 0 1rem; color: var(--color-graphite); font-size: .89rem; line-height: 1.6; }
  .oven-card .text-action { padding-block: .3rem; font-size: .86rem; }
  .home-purchase { width: 100%; margin-top: auto; padding-top: .45rem; }
  .home-purchase__disclosure { margin: 0 0 .4rem; font-size: .72rem; line-height: 1.5; }
  .home-purchase__disclosure a { color: var(--color-graphite); text-underline-offset: .2em; }
  .home-purchase .button-link { width: 100%; min-height: 3rem; font-size: .86rem; line-height: 1.35; text-align: left; }
  .home-purchase .button-link > span { flex-shrink: 0; }
  .lead-feature__copy > .text-action { margin-top: .3rem; font-size: .86rem; }
  .affiliate-note { max-width: 65rem; margin: 1.7rem 0 0; color: var(--color-graphite); font-size: .76rem; line-height: 1.65; }
  .affiliate-note a { color: var(--color-probe); }
  .decision-section { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 1.5rem; }
  .decision-feature, .finder-feature { padding: clamp(1.75rem, 4vw, 3.25rem); }
  .decision-feature { color: var(--color-white); background: var(--color-carbon); }
  .decision-feature .eyebrow { color: var(--color-reading); }
  .decision-feature h2, .finder-feature h2 { max-width: 18ch; margin: 1.25rem 0; font-size: clamp(2.5rem, 4vw, 4rem); line-height: .98; }
  .decision-feature > p:not(.eyebrow) { color: var(--color-carbon-muted); line-height: 1.65; }
  .decision-feature .button-link { margin-top: .75rem; }
  .decision-feature :focus-visible { outline-color: var(--color-reading); }
  .finder-feature { border: 1px solid var(--color-line); }
  .finder-feature__mark { color: var(--color-probe); font-family: var(--font-display); font-size: 3.5rem; font-weight: 600; line-height: 1; }
  .finder-feature > p { color: var(--color-graphite); line-height: 1.65; }
  .journal-section { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 3rem; padding-block: 2.5rem; border-block: 1px solid var(--color-carbon); }
  .journal-section h2 { max-width: 23ch; margin: 1rem 0; font-size: clamp(2.3rem, 3.7vw, 3.6rem); line-height: 1; }
  .journal-section p:not(.eyebrow) { max-width: 48rem; color: var(--color-graphite); line-height: 1.7; }
  .journal-links { display: flex; flex-direction: column; justify-content: center; align-items: flex-start; gap: .5rem; }
  .guide-count { color: var(--color-graphite); }
  .guide-count strong { color: var(--color-carbon); font-family: var(--font-display); font-size: 4rem; line-height: 1.2; }
  .journal-links > a:last-child { display: inline-flex; align-items: center; min-height: 2.75rem; color: var(--color-graphite); font-size: .86rem; }
  .transparency-note { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr) auto; gap: 2rem; align-items: start; padding-block: 2.5rem 1rem; }
  .transparency-note h2 { max-width: 21ch; margin: 0; font-size: 1.6rem; line-height: 1.1; }
  .transparency-note p { margin: 0; color: var(--color-graphite); font-size: .85rem; line-height: 1.7; }
  .transparency-note .text-action { font-size: .85rem; }
  @media (min-width: 48.01rem) {
    .home-purchase .button-link { white-space: nowrap; overflow-wrap: normal; }
  }
  @media (min-width: 64.01rem) and (max-width: 79.99rem) {
    .oven-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 64rem) {
    .editorial-hero { gap: 2rem; }
    .hero-copy h1 { font-size: clamp(3rem, 6.7vw, 5rem); }
    .accessories-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem 1.5rem; }
    .oven-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .oven-card--lead { grid-row: auto; grid-column: 1 / -1; display: grid; grid-template-columns: 1fr 1fr; }
    .intent-nav a { padding-inline: .8rem; font-size: .9rem; }
    .starter-kit { align-items: flex-start; flex-direction: column; gap: 1rem; }
    .transparency-note { grid-template-columns: 1fr 1.3fr; }
    .transparency-note .text-action { grid-column: 2; }
  }
  @media (max-width: 48rem) {
