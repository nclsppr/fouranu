---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import AuthorPortrait from "@/components/AuthorPortrait.astro";
import { SITE } from "@/config/site";

const canonical = new URL(SITE.editorialAuthor.url, SITE.url).toString();
const analyses = (await getCollection("analyses"))
  .filter((entry) => entry.data.status === "publishable" && entry.data.indexable);
const authors = Object.entries(SITE.authors).map(([id, author]) => ({
  id,
  ...author,
  articleCount: analyses.filter((entry) => entry.data.author === id).length,
}));
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": `${canonical}#profile`,
  url: canonical,
  name: SITE.editorialAuthor.name,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: authors.map((author, index) => ({
      "@type": "ListItem",
      position: index + 1,
      item: {
        "@type": "Person",
        "@id": `${new URL(author.url, SITE.url).toString()}#person`,
        name: author.name,
        url: new URL(author.url, SITE.url).toString(),
        image: new URL(author.portrait.large, SITE.url).toString(),
      },
    })),
  },
};
---

<BaseLayout
  title="Nicolas, Florian & Magali | Rédaction Four à Nu"
  description="Les trois signatures éditoriales des dossiers Four à Nu : Nicolas, Florian et Magali."
  indexable={true}
  schema={schema}
>
  <div class="page-shell">
    <Breadcrumbs items={[{ label: "Accueil", href: "/" }, { label: "À propos", href: "/a-propos/" }, { label: "Rédaction" }]} />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">La rédaction</p>
        <h1>Nicolas, Florian & Magali.</h1>
        <p class="page-intro__lede">
          Trois parcours différents, une même méthode : chaque dossier indique
          sa personne référente, tandis que ses sources et ses limites restent
          relues collectivement.
        </p>
      </div>
      <p class="page-intro__aside">Les signatures ne servent pas à décorer une page. Elles mènent à une personne, à son parcours et aux dossiers qu’elle suit au sein de la rédaction.</p>
    </header>

    <section class="author-scope" aria-labelledby="author-scope-title">
      <div>
        <p class="eyebrow">Trois signatures</p>
        <h2 id="author-scope-title">Trois façons de regarder la soirée.</h2>
      </div>
      <div class="author-names">
        {authors.map((author) => (
          <article id={author.id}>
            <AuthorPortrait portrait={author.portrait} variant="hub" />
            <p>{author.role}</p>
            <h3>{author.name}</h3>
            <p>{author.summary}</p>
            <a href={author.url}>
              Découvrir {author.name} · {author.articleCount} dossiers
            </a>
          </article>
        ))}
      </div>
    </section>

    <section class="author-controls" aria-label="Contrôles éditoriaux">
      <article><span>01</span><h2>Avant publication</h2><p>Les sources, les chiffres, les liens et les limites sont vérifiés avant que le guide soit mis en ligne.</p></article>
      <article><span>02</span><h2>À la mise à jour</h2><p>La gamme, la version du produit, les prix datés, les liens externes et la conclusion sont relus ensemble.</p></article>
      <article><span>03</span><h2>Après un signalement</h2><p>La source et la portée de l'erreur sont vérifiées. Une correction de fond indique sa date, son motif et son effet.</p></article>
    </section>

    <nav class="author-links" aria-label="Politiques éditoriales associées">
      <a href="/methode/">Méthode et niveaux de preuve</a>
      <a href="/transparence/">Transparence commerciale</a>
      <a href="/corrections/">Politique de correction</a>
    </nav>
  </div>
</BaseLayout>

<style>
  .author-scope {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 2rem;
    padding-block: clamp(3rem, 5vw, 4.5rem);
  }

  .author-scope h2 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    line-height: 0.96;
  }

  .author-scope > div:last-child {
    max-width: none;
    color: var(--color-graphite);
    font-size: 1.04rem;
    line-height: 1.7;
  }

  .author-names {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-carbon);
  }

  .author-names article {
    display: flex;
    min-height: 21rem;
    flex-direction: column;
    align-items: flex-start;
    padding: 1.1rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: 1.5rem;
  }

  .author-names article:last-child {
    border-right: 0;
  }

  .author-names h3 {
    margin: 0.35rem 0 0.8rem;
    font-size: 2rem;
  }

  .author-names p {
    margin: 0;
    color: var(--color-graphite);
  }

  .author-names article > p:first-of-type {
    margin-top: 1.25rem;
    font-family: var(--font-data);
    font-size: 0.72rem;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .author-names a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: auto;
    padding-top: 1rem;
    color: var(--color-probe);
    font-weight: 600;
  }

  .author-controls {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-carbon);
  }

  .author-controls article {
    min-height: 14rem;
    padding: 1.5rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .author-controls article:last-child {
    border-right: 0;
  }

  .author-controls span {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.75rem;
  }

  .author-controls h2 {
    margin: 2.5rem 0 0.8rem;
    font-size: 2rem;
  }

  .author-controls p {
    color: var(--color-graphite);
    line-height: 1.6;
  }

  .author-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    margin-top: clamp(2.5rem, 4vw, 4rem);
    padding: 1rem;
    border-top: 2px solid var(--color-probe);
    border-bottom: 1px solid var(--color-line);
  }

  .author-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-probe);
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .author-scope,
    .author-controls,
    .author-names {
      grid-template-columns: 1fr;
    }

    .author-names article {
      min-height: auto;
      border-right: 0;
    }

    .author-names a {
      margin-top: 1rem;
    }

    .author-controls article {
      min-height: auto;
      border-right: 0;
    }

    .author-controls h2 {
      margin-top: 2.5rem;
    }
  }
</style>
