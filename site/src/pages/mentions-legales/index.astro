---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { staticAlternates, staticRoute, type Locale } from "@/i18n/config";
import { LEGAL_COPY } from "@/i18n/trust-pages";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = LEGAL_COPY[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={staticRoute("legal", locale)}
  alternatePaths={staticAlternates("legal")}
  indexable={true}
>
  <div class="page-shell">
    <Breadcrumbs locale={locale} items={[{ label: copy.home, href: staticRoute("home", locale) }, { label: copy.breadcrumb }]} />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="page-intro__lede">{copy.lead}</p>
      </div>
      <p class="page-intro__aside">{copy.aside}</p>
    </header>

    <section class="legal-grid" aria-label={copy.gridAria}>
      <article>
        <p class="eyebrow">{copy.publisherEyebrow}</p>
        <h2>Four à Nu</h2>
        <p>{copy.publisherBody}</p>
        <p>{copy.publisherContact}</p>
        <a href={staticRoute("contact", locale)}>{copy.contactLink}</a>
        <br />
        <a href="https://www.legifrance.gouv.fr/codes/section_lc/JORFTEXT000000801164/LEGISCTA000006117684/" rel="external">{copy.lawLink}</a>
      </article>

      <article>
        <p class="eyebrow">{copy.hostingEyebrow}</p>
        <h2>Cloudflare, Inc.</h2>
        <address>
          101 Townsend Street<br />
          San Francisco, CA 94107<br />
          {copy.country}<br />
          <a href="tel:+16503198930">+1 (650) 319-8930</a><br />
          <a href="mailto:support@cloudflare.com">support@cloudflare.com</a>
        </address>
        <a href="https://www.cloudflare.com/policies/terms/" rel="external">{copy.cloudflareLink}</a>
      </article>

      <article>
        <p class="eyebrow">{copy.contentEyebrow}</p>
        <h2>{copy.contentHeading}</h2>
        <p>{copy.contentBody}</p>
      </article>
    </section>
  </div>
</BaseLayout>

<style>
  .legal-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    padding-block: 4rem;
    border-top: 1px solid var(--color-carbon);
  }

  .legal-grid article {
    padding: 1.5rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .legal-grid article:last-child {
    border-right: 0;
  }

  .legal-grid h2 {
    margin: 2rem 0 0.75rem;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1;
  }

  .legal-grid p,
  .legal-grid address {
    color: var(--color-graphite);
    font-style: normal;
    line-height: 1.65;
  }

  .legal-grid a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-probe);
    font-weight: 600;
  }

  @media (max-width: 64rem) {
    .legal-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .legal-grid article:nth-child(2) {
      border-right: 0;
    }

    .legal-grid article:last-child {
      grid-column: 1 / -1;
      border-right: 0;
    }
  }

  @media (max-width: 48rem) {
    .legal-grid {
      grid-template-columns: 1fr;
      padding-block: 3rem;
    }

    .legal-grid article {
      border-right: 0;
    }

    .legal-grid article:last-child {
      grid-column: auto;
    }

    .legal-grid h2 {
      margin-top: 1.5rem;
    }
  }
</style>
