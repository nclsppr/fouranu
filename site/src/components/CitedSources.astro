---
import evidenceCsv from "@/data/evidence.csv?raw";
import {
  affiliateRel,
  isAmazonLink,
  toAmazonAffiliateUrl,
} from "@/lib/amazon-affiliate.mjs";
import { LOCALE_INFO, type Locale } from "@/i18n/config";
import { PROOF_COPY } from "@/i18n/common";

interface Props {
  locale?: Locale;
  evidenceIds: string[];
}

const headers = [
  "evidence_id",
  "product_version",
  "source_type",
  "source_title",
  "publisher",
  "source_url",
  "published_on",
  "checked_on",
  "timecode_start",
  "timecode_end",
  "evidence_class",
  "observation",
  "conditions",
  "sponsorship",
  "corroborating_ids",
  "confidence",
  "article_ids",
] as const;

type Header = (typeof headers)[number];
type Evidence = Record<Header, string>;

function parseCsv(input: string): string[][] {
  const rows: string[][] = [];
  let row: string[] = [];
  let field = "";
  let quoted = false;

  const finishRow = () => {
    row.push(field);
    if (row.some((value) => value.length > 0)) rows.push(row);
    row = [];
    field = "";
  };

  for (let index = 0; index < input.length; index += 1) {
    const character = input[index];

    if (quoted) {
      if (character === '"' && input[index + 1] === '"') {
        field += '"';
        index += 1;
      } else if (character === '"') {
        quoted = false;
      } else {
        field += character;
      }
      continue;
    }

    if (character === '"') {
      if (field.length > 0) throw new Error("Guillemet CSV inattendu dans evidence.csv.");
      quoted = true;
    } else if (character === ",") {
      row.push(field);
      field = "";
    } else if (character === "\n") {
      finishRow();
    } else if (character === "\r") {
      if (input[index + 1] === "\n") index += 1;
      finishRow();
    } else {
      field += character;
    }
  }

  if (quoted) throw new Error("Champ CSV non fermé dans evidence.csv.");
  if (field.length > 0 || row.length > 0) finishRow();
  return rows;
}

const rows = parseCsv(evidenceCsv);
const csvHeaders = rows.shift();
if (!csvHeaders || csvHeaders.join(",") !== headers.join(",")) {
  throw new Error("Schéma inattendu pour evidence.csv.");
}

const evidenceById = new Map<string, Evidence>();
for (const [index, values] of rows.entries()) {
  if (values.length !== headers.length) {
    throw new Error(`Ligne ${index + 2} invalide dans evidence.csv : ${values.length} colonnes.`);
  }
  const record = Object.fromEntries(
    headers.map((header, column) => [header, values[column]]),
  ) as Evidence;
  if (evidenceById.has(record.evidence_id)) {
    throw new Error(`Preuve dupliquée dans evidence.csv : ${record.evidence_id}.`);
  }
  evidenceById.set(record.evidence_id, record);
}

const { locale = "fr", evidenceIds } = Astro.props;
const copy = {
  fr: {
    eyebrow: "Références", title: "Sources de cet article", references: "références",
    show: "Voir la liste", hide: "Masquer la liste",
    intro: "Ouvrez une référence pour retrouver son lien, sa date de contrôle et, selon la nature de la source, l’observation publiable ou ses conditions.",
    amazonIntro: "Les références Amazon.fr sont ouvertes via un lien affilié : un achat éligible peut rémunérer Four à Nu, sans modifier la source enregistrée ni notre lecture.",
    checked: "Vérifié le", passage: "Passage", conditions: "Conditions :", relationships: "Relations signalées :",
    source: "Ouvrir la source", amazonSource: "Ouvrir sur Amazon.fr — lien affilié",
    amazonObservation: "Référence et fiche exacte contrôlées à la date indiquée. Relisez l’offre Amazon.fr avant toute commande : vendeur, variante, contenu et disponibilité peuvent évoluer.",
    registryObservation: "",
    originalObservation: "Observation :",
    originalConditions: "Conditions :",
    conclusion: (product: string) => `Conclusion sur ${product}`,
  },
  en: {
    eyebrow: "References", title: "Sources for this article", references: "references",
    show: "Show list", hide: "Hide list",
    intro: "Open a reference to find its link, verification date, source class, confidence level and any recorded commercial relationship.",
    amazonIntro: "Amazon.fr references open through an affiliate link: an eligible purchase may support Four à Nu without changing the recorded source or our interpretation.",
    checked: "Checked", passage: "Passage", conditions: "Conditions:", relationships: "Disclosed relationships:",
    source: "Open source", amazonSource: "Open on Amazon.fr — affiliate link",
    amazonObservation: "The exact reference and listing were checked on the stated date. Recheck the Amazon.fr offer before ordering: seller, variant, contents and availability may change.",
    registryObservation: "The source record and its original French observation remain preserved in the canonical evidence register. We do not silently translate that evidence note; this page translates the editorial analysis and links back to the source.",
    originalObservation: "Original French observation:",
    originalConditions: "Original French conditions:",
    conclusion: (product: string) => `Conclusion about ${product}`,
  },
  de: {
    eyebrow: "Referenzen", title: "Quellen dieses Artikels", references: "Referenzen",
    show: "Liste anzeigen", hide: "Liste ausblenden",
    intro: "Öffnen Sie eine Referenz, um Link, Prüfdatum, Quellenklasse, Vertrauensniveau und dokumentierte Geschäftsbeziehungen nachzuvollziehen.",
    amazonIntro: "Referenzen zu Amazon.fr werden über einen Partnerlink geöffnet: Ein qualifizierter Kauf kann Four à Nu unterstützen, ohne die gespeicherte Quelle oder unsere Einordnung zu verändern.",
    checked: "Geprüft am", passage: "Stelle", conditions: "Bedingungen:", relationships: "Offengelegte Beziehungen:",
    source: "Quelle öffnen", amazonSource: "Auf Amazon.fr öffnen — Partnerlink",
    amazonObservation: "Die genaue Referenz und das Angebot wurden am genannten Datum geprüft. Prüfen Sie vor einer Bestellung bei Amazon.fr erneut Verkäufer, Variante, Inhalt und Verfügbarkeit.",
    registryObservation: "Der Quelldatensatz und seine ursprüngliche französische Beobachtung bleiben im kanonischen Evidenzregister erhalten. Diese Evidenznotiz wird nicht stillschweigend übersetzt; diese Seite übersetzt die redaktionelle Analyse und verlinkt die Quelle.",
    originalObservation: "Französische Originalbeobachtung:",
    originalConditions: "Französische Originalbedingungen:",
    conclusion: (product: string) => `Schlussfolgerung zu ${product}`,
  },
}[locale];
const uniqueIds = [...new Set(evidenceIds)];
for (const evidenceId of uniqueIds) {
  if (!/^EV-\d{4}$/.test(evidenceId)) {
    throw new Error(`Identifiant de preuve invalide : ${evidenceId}.`);
  }
}

const citedEvidence = uniqueIds.map((evidenceId) => {
  const record = evidenceById.get(evidenceId);
  if (!record) throw new Error(`Preuve citée mais absente du registre : ${evidenceId}.`);
  return record;
});
const hasAmazonSource = citedEvidence.some((record) => isAmazonLink(record.source_url));

const classLabels: Record<string, string> = PROOF_COPY[locale].names;
const confidenceLabels: Record<string, Record<string, string>> = {
  fr: { high: "confiance haute", medium: "confiance moyenne", low: "confiance faible" },
  en: { high: "high confidence", medium: "medium confidence", low: "low confidence" },
  de: { high: "hohe Sicherheit", medium: "mittlere Sicherheit", low: "geringe Sicherheit" },
};
const relationshipLabels: Record<string, string> = {
  affiliate: "liens affiliés",
  "affiliate-links": "liens affiliés",
  "arc-lite-origin-not-disclosed": "origine de l’Arc Lite non précisée",
  "arc-lite-supplied-by-gozney": "Arc Lite fourni par Gozney",
  "collaboration-with-ooni": "collaboration avec Ooni",
  "core-supplied-by-ooni": "Halo Core fourni par Ooni",
  "launch-exclusivity": "exclusivité commerciale au lancement",
  "loaned-by-ooni": "unité prêtée par Ooni",
  "loan-or-sponsorship-not-detected": "aucun prêt ou sponsoring repéré",
  "loan-or-sponsorship-not-disclosed": "prêt ou sponsoring non précisé",
  "merchant-links": "liens marchands",
  merchant: "activité marchande",
  "no-loan-or-sponsorship-detected": "aucun prêt ou sponsoring repéré",
  "ooni-ambassador": "ambassadeur Ooni",
  "ooni-collaboration": "collaboration Ooni",
  "paid-partnership-with-ooni": "partenariat rémunéré avec Ooni",
  "paid-promotion": "promotion rémunérée",
  "product-sold-by-publisher": "produit vendu par la source",
  "promo-code": "code promotionnel",
  "review-unit-free": "unité fournie gratuitement",
  "review-unit-supplied-by-ooni": "appareil fourni par Ooni",
  "self-purchased": "unité achetée par la source",
  "tracked-merchant-link": "lien marchand suivi",
  "tread-purchased-by-publisher": "Tread acheté par la source",
  "unit-origin-not-disclosed": "origine de l'unité non précisée",
};
const dateFormatter = new Intl.DateTimeFormat(LOCALE_INFO[locale].intlLocale, {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

function formatDate(value: string) {
  return dateFormatter.format(new Date(`${value}T00:00:00Z`));
}

function timecodeInSeconds(value: string) {
  const parts = value.split(":").map(Number);
  if (parts.some((part) => !Number.isInteger(part) || part < 0) || parts.length > 3) {
    throw new Error(`Timecode invalide dans evidence.csv : ${value}.`);
  }
  return parts.reduce((total, part) => total * 60 + part, 0);
}

function sourceHref(record: Evidence) {
  if (!record.source_url) return undefined;
  const url = new URL(record.source_url);
  if (
    record.timecode_start &&
    (url.hostname === "youtube.com" ||
      url.hostname === "www.youtube.com" ||
      url.hostname === "youtu.be")
  ) {
    url.searchParams.set("t", `${timecodeInSeconds(record.timecode_start)}s`);
  }
  return isAmazonLink(url.toString())
    ? toAmazonAffiliateUrl(url.toString())
    : url.toString();
}

function sourceTitle(record: Evidence) {
  if (record.source_title) return record.source_title;
  if (record.source_type === "fouranu") {
    return copy.conclusion(record.product_version);
  }
  return record.product_version;
}

function sourcePublisher(record: Evidence) {
  if (record.publisher) return record.publisher;
  if (record.source_type === "fouranu") return "Four à Nu";
  return undefined;
}

function relationships(record: Evidence) {
  return record.sponsorship
    .split(";")
    .filter(Boolean)
    .map((value) => {
      if (locale === "en") return value.replaceAll("-", " ");
      if (locale === "de") {
        if (/self-purchased|purchased-by/.test(value)) return "von der Quelle gekauftes Gerät";
        if (/not-disclosed/.test(value)) return "Bereitstellung oder Sponsoring nicht offengelegt";
        if (/no-loan|not-detected/.test(value)) return "kein Darlehen oder Sponsoring festgestellt";
        if (/paid|promotion/.test(value)) return "bezahlte Partnerschaft oder Werbung";
        if (/supplied|loaned|review-unit/.test(value)) return "vom Hersteller bereitgestelltes oder geliehenes Gerät";
        if (/ambassador|collaboration/.test(value)) return "Zusammenarbeit oder Markenbeziehung";
        if (/affiliate|merchant|promo-code|tracked/.test(value)) return "kommerzielle Links oder Aktivität";
        if (value === "launch-exclusivity") return "kommerzielle Exklusivität zum Marktstart";
      }
      const label = relationshipLabels[value];
      if (!label) throw new Error(`Relation éditoriale sans libellé public : ${value}.`);
      return label;
    });
}
---

{citedEvidence.length > 0 && (
  <section class="cited-sources" aria-labelledby="cited-sources-title">
    <details class="cited-sources__disclosure">
      <summary class="cited-sources__summary">
        <span class="cited-sources__heading">
          <span class="eyebrow">{copy.eyebrow}</span>
          <h2 id="cited-sources-title">{copy.title}</h2>
        </span>
        <span class="cited-sources__toggle">
          <span>{citedEvidence.length} {copy.references}</span>
          <span class="cited-sources__action cited-sources__action--closed">{copy.show}</span>
          <span class="cited-sources__action cited-sources__action--open">{copy.hide}</span>
        </span>
      </summary>

      <p class="cited-sources__intro">
        {copy.intro}
        {hasAmazonSource && (
          <span>
            {" "}{copy.amazonIntro}
          </span>
        )}
      </p>

      <ol class="cited-sources__list">
        {citedEvidence.map((record) => {
          const href = sourceHref(record);
          const affiliate = href ? isAmazonLink(href) : false;
          const amazonSource = isAmazonLink(record.source_url);
          const publisher = sourcePublisher(record);
          const relationshipNotes = relationships(record);
          return (
            <li id={`preuve-${record.evidence_id}`} data-evidence-id={record.evidence_id}>
              <details class="cited-source">
                <summary>
                  <span class="cited-source__title">{sourceTitle(record)}</span>
                  <span class="cited-source__meta">
                    <span>{classLabels[record.evidence_class] ?? record.evidence_class}</span>
                    {publisher && <span>{publisher}</span>}
                    {record.timecode_start && <span>{record.timecode_start}</span>}
                  </span>
                </summary>
                <div class="cited-source__detail">
                  <p class="cited-source__checked">
                    {copy.checked} <time datetime={record.checked_on}>{formatDate(record.checked_on)}</time>
                    {record.timecode_start && (
                      <span>
                        · {copy.passage} {record.timecode_start}
                        {record.timecode_end && `–${record.timecode_end}`}
                      </span>
                    )}
                    <span> · {confidenceLabels[locale][record.confidence] ?? record.confidence}</span>
                  </p>
                  {amazonSource ? (
                    <p class="cited-source__observation">
                      {copy.amazonObservation}
                    </p>
                  ) : locale !== "fr" ? (
                    <>
                      <p class="cited-source__registry-note">{copy.registryObservation}</p>
                      {record.observation && (
                        <p class="cited-source__observation" lang="fr">
                          <strong>{copy.originalObservation}</strong> {record.observation}
                        </p>
                      )}
                      {record.conditions && (
                        <p class="cited-source__conditions" lang="fr">
                          <strong>{copy.originalConditions}</strong> {record.conditions}
                        </p>
                      )}
                    </>
                  ) : (
                    <p class="cited-source__observation">
                      {record.observation}
                    </p>
                  )}
                  {locale === "fr" && !amazonSource && record.conditions && (
                    <p class="cited-source__conditions"><strong>{copy.conditions}</strong> {record.conditions}</p>
                  )}
                  {relationshipNotes.length > 0 && (
                    <p class="cited-source__relationships">
                      <strong>{copy.relationships}</strong> {relationshipNotes.join(" · ")}
                    </p>
                  )}
                  {href && (
                    <a
                      class="cited-source__link"
                      href={href}
                      rel={affiliateRel(href)}
                      data-affiliate={affiliate ? "amazon" : undefined}
                    >
                      {affiliate ? copy.amazonSource : copy.source}
                      {" "}<span aria-hidden="true">↗</span>
                    </a>
                  )}
                </div>
              </details>
            </li>
          );
        })}
      </ol>
    </details>
  </section>
)}

<style>
  .cited-sources {
    grid-column: 2 / span 10;
    margin-top: 0;
    padding-top: 2rem;
    border-top: 1px solid var(--color-carbon);
  }

  .cited-sources__disclosure,
  .cited-source {
    margin: 0;
  }

  .cited-sources__summary {
    display: grid;
    grid-template-columns: minmax(12rem, 1fr) auto;
    gap: 1.5rem;
    align-items: center;
    min-height: 4.5rem;
    padding-block: 0.65rem;
    cursor: pointer;
    list-style: none;
  }

  .cited-sources__summary::-webkit-details-marker,
  .cited-source > summary::-webkit-details-marker {
    display: none;
  }

  .cited-sources__heading .eyebrow {
    display: block;
    margin-bottom: 0.25rem;
  }

  .cited-sources__heading h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.8rem);
    line-height: 1;
  }

  .cited-sources__toggle {
    display: grid;
    grid-template-columns: auto auto;
    gap: 0.25rem 1rem;
    align-items: center;
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    text-align: right;
    text-transform: uppercase;
  }

  .cited-sources__toggle::after {
    grid-column: 2;
    grid-row: 1 / span 2;
    content: "+";
    color: var(--color-probe);
    font-size: 1rem;
  }

  .cited-sources__action {
    color: var(--color-probe);
    font-weight: 500;
  }

  .cited-sources__action--open {
    display: none;
  }

  .cited-sources__disclosure[open] > .cited-sources__summary {
    border-bottom: 1px solid var(--color-line);
  }

  .cited-sources__disclosure[open] > .cited-sources__summary .cited-sources__toggle::after {
    content: "−";
  }

  .cited-sources__disclosure[open] .cited-sources__action--closed {
    display: none;
  }

  .cited-sources__disclosure[open] .cited-sources__action--open {
    display: inline;
  }

  .cited-sources__intro {
    max-width: 42rem;
    margin: 0;
    padding-block: 0.75rem;
    color: var(--color-graphite);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .cited-sources__list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
  }

  .cited-sources__list > li {
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: 1.5rem;
  }

  .cited-source > summary {
    display: grid;
    grid-template-columns: minmax(14rem, 4fr) minmax(12rem, 2fr) 1rem;
    gap: 1rem;
    align-items: center;
    min-height: 3.25rem;
    padding-block: 0.5rem;
    cursor: pointer;
    list-style: none;
  }

  .cited-source > summary::after {
    content: "+";
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 1rem;
    text-align: right;
  }

  .cited-source[open] > summary::after {
    content: "−";
  }

  .cited-source > summary:hover .cited-source__title {
    color: var(--color-probe);
  }

  .cited-source__meta {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.2rem 0.55rem;
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .cited-source__title {
    font-family: var(--font-display);
    font-size: clamp(1rem, 1.6vw, 1.28rem);
    font-weight: 600;
    line-height: 1.12;
    transition: color 140ms ease-out;
  }

  .cited-source__detail {
    display: grid;
    grid-template-columns: minmax(10rem, 2fr) minmax(14rem, 4fr) 1rem;
    gap: 0.6rem 1rem;
    padding: 0 0 0.9rem;
  }

  .cited-source__checked {
    grid-column: 1;
    margin: 0;
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .cited-source__observation,
  .cited-source__registry-note,
  .cited-source__conditions,
  .cited-source__relationships {
    grid-column: 2;
    max-width: 52rem;
    margin: 0;
    color: var(--color-graphite);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  .cited-source__conditions,
  .cited-source__registry-note,
  .cited-source__relationships {
    font-size: 0.75rem;
  }

  .cited-source__registry-note {
    padding-left: 0.75rem;
    border-left: 2px solid var(--color-probe);
  }

  .cited-source__conditions strong,
  .cited-source__relationships strong {
    color: var(--color-carbon);
  }

  .cited-source__link {
    grid-column: 2;
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    justify-self: start;
    color: var(--color-probe);
    font-size: 0.75rem;
    font-weight: 600;
  }

  @media (max-width: 75rem) {
    .cited-sources {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 48rem) {
    .cited-sources {
      padding-top: 1.5rem;
    }

    .cited-sources__summary {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.75rem;
    }

    .cited-sources__toggle {
      grid-template-columns: auto;
    }

    .cited-sources__toggle::after {
      grid-column: 1;
      grid-row: 1;
    }

    .cited-sources__toggle > span:first-child {
      grid-column: 1;
      grid-row: 2;
    }

    .cited-sources__action {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .cited-source > summary {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.35rem 0.75rem;
      min-height: 3.75rem;
    }

    .cited-source__title,
    .cited-source__meta {
      grid-column: 1;
    }

    .cited-source__meta {
      justify-content: flex-start;
    }

    .cited-source > summary::after {
      grid-column: 2;
      grid-row: 1 / span 2;
    }

    .cited-source__detail {
      grid-template-columns: 1fr;
      padding-bottom: 1rem;
    }

    .cited-source__checked,
    .cited-source__observation,
    .cited-source__conditions,
    .cited-source__relationships,
    .cited-source__link {
      grid-column: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cited-source__title {
      transition: none;
    }
  }
</style>
