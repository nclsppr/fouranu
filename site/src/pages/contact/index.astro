---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { staticAlternates, staticRoute, type Locale } from "@/i18n/config";
import { CONTACT_COPY } from "@/i18n/trust-pages";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = CONTACT_COPY[locale];
const contactUrls = [
  "https://github.com/nclsppr/fouranu/issues/new",
  "https://www.cloudflare.com/trust-hub/reporting-abuse/",
] as const;
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={staticRoute("contact", locale)}
  alternatePaths={staticAlternates("contact")}
  indexable={true}
>
  <div class="page-shell">
    <Breadcrumbs locale={locale} items={[{ label: copy.home, href: staticRoute("home", locale) }, { label: copy.breadcrumb }]} />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="page-intro__lede">{copy.lead}</p>
      </div>
      <p class="page-intro__aside">{copy.aside}</p>
    </header>

    <section class="contact-grid" aria-label={copy.channelsAria}>
      {copy.channels.map((channel, index) => (
        <article>
          <p class="eyebrow">{channel.eyebrow}</p>
          <h2>{channel.heading}</h2>
          <p>{channel.body}</p>
          <a href={contactUrls[index]} rel="external">{channel.link}</a>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-block: 4rem;
    border-top: 1px solid var(--color-carbon);
  }

  .contact-grid article {
    padding: 1.5rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .contact-grid article:last-child {
    border-right: 0;
  }

  .contact-grid h2 {
    margin: 2rem 0 0.75rem;
    font-size: clamp(2rem, 3.4vw, 3rem);
    line-height: 1;
  }

  .contact-grid p {
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .contact-grid a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-probe);
    font-weight: 600;
  }

  @media (max-width: 48rem) {
    .contact-grid {
      grid-template-columns: 1fr;
      padding-block: 3rem;
    }

    .contact-grid article {
      border-right: 0;
    }

    .contact-grid h2 {
      margin-top: 1.5rem;
    }
  }
</style>
