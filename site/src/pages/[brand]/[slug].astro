---
import { getCollection, render, type CollectionEntry } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import CitedSources from "@/components/CitedSources.astro";
import ProofLabel from "@/components/ProofLabel.astro";
import { SITE } from "@/config/site";

export async function getStaticPaths() {
  const analyses = await getCollection("analyses");
  return analyses.map((entry) => ({
    params: { brand: entry.data.brand, slug: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"analyses">;
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const articleHeadings = headings.filter((heading) => heading.depth === 2);
const dateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "2-digit",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});
const publishedAt = dateFormatter.format(entry.data.publishedAt);
const updatedAt = dateFormatter.format(entry.data.updatedAt);
const canonical = new URL(`/${entry.data.brand}/${entry.id}/`, SITE.url).toString();
const evidenceIds = entry.data.evidenceIds;
const brandLabel = entry.data.brand === "gozney" ? "Gozney" : "Ooni";
const words = (entry.body ?? "")
  .replace(/```[\s\S]*?```/g, " ")
  .replace(/<[^>]*>/g, " ")
  .replace(/[#*_[\]()`>|-]/g, " ")
  .split(/\s+/)
  .filter(Boolean).length;
const readingMinutes = Math.max(1, Math.ceil(words / 220));
const articleImage = new URL(entry.data.image.src, SITE.url).toString();
const typeLabels = {
  guide: "Guide d'achat",
  decision: "Comparatif par usage",
  model: "Analyse de modèle",
};
const author = SITE.authors[entry.data.author];
const canonicalAuthor = new URL(author.url, SITE.url).toString();
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  "@id": `${canonical}#article`,
  url: canonical,
  headline: entry.data.title,
  description: entry.data.description,
  image: articleImage,
  wordCount: words,
  timeRequired: `PT${readingMinutes}M`,
  datePublished: entry.data.publishedAt.toISOString(),
  dateModified: entry.data.updatedAt.toISOString(),
  inLanguage: SITE.language,
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": canonical,
  },
  author: {
    "@type": "Person",
    name: author.name,
    url: canonicalAuthor,
  },
  publisher: {
    "@type": "Organization",
    "@id": `${SITE.url}/#organization`,
    name: SITE.name,
    url: `${SITE.url}/`,
  },
  isPartOf: {
    "@type": "WebSite",
    "@id": `${SITE.url}/#website`,
  },
  publishingPrinciples: `${SITE.url}/methode/`,
};
---

<BaseLayout
  title={`${entry.data.title} | Four à Nu`}
  description={entry.data.description}
  image={entry.data.image.src}
  imageAlt={entry.data.image.alt}
  imageWidth={1600}
  imageHeight={900}
  indexable={entry.data.indexable}
  pageType="article"
  authorName={author.name}
  publishedAt={entry.data.publishedAt}
  modifiedAt={entry.data.updatedAt}
  schema={schema}
>
  <div class="page-shell">
    <Breadcrumbs
      items={[
        { label: "Accueil", href: "/" },
        { label: brandLabel, href: `/${entry.data.brand}/` },
        { label: entry.data.title },
      ]}
    />

    <article class="article-shell">
      <header class="article-header">
        <p class="eyebrow">{typeLabels[entry.data.type]} · Analyse documentaire</p>
        <h1>{entry.data.title}</h1>
        <p class="article-header__summary">{entry.data.summary}</p>

        <div class="article-byline">
          <p>
            Par <a rel="author" href={author.url}>{author.name}</a>
          </p>
          <p>
            Publié le <time datetime={entry.data.publishedAt.toISOString()}>{publishedAt}</time>
          </p>
          <p>
            Mis à jour le <time datetime={entry.data.updatedAt.toISOString()}>{updatedAt}</time>
          </p>
          <p>{readingMinutes} min de lecture</p>
        </div>
      </header>

      <figure class="article-lead-media">
        <img
          src={entry.data.image.src}
          srcset={`${entry.data.image.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image.src} 1600w`}
          sizes="(max-width: 48rem) 100vw, 42vw"
          alt={entry.data.image.alt}
          width="1600"
          height="900"
          fetchpriority="high"
        />
        <figcaption>{entry.data.image.caption}</figcaption>
      </figure>

      <aside class="article-facts" aria-label="Repères éditoriaux">
        <dl>
          <div><dt>Nature</dt><dd>Analyse documentaire</dd></div>
          <div><dt>Sources citées</dt><dd><a href="#cited-sources-title">{evidenceIds.length}</a></dd></div>
          {entry.data.model && <div><dt>Produit</dt><dd>{entry.data.model}</dd></div>}
          <div><dt>Dossier</dt><dd>{entry.data.articleId}</dd></div>
        </dl>
        <div class="article-facts__proofs">
          {entry.data.evidenceTypes.map((code) => <ProofLabel code={code} />)}
        </div>
      </aside>

      <div class="article-reading-grid">
        <aside class="article-toc" aria-labelledby="article-toc-title">
          <p id="article-toc-title">Dans ce dossier</p>
          <ol>
            {articleHeadings.map((heading) => (
              <li><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
          <a class="article-toc__method" href="/methode/">Comment nous travaillons</a>
        </aside>

        <div class="article-body">
          <div class="documentary-notice">
            <strong>Analyse documentaire</strong>
            <span>
              Ce dossier confronte des données fabricant, des mesures publiées
              et des observations attribuées. Les protocoles et relations
              commerciales connus sont indiqués avec les sources.
            </span>
            <a href="#cited-sources-title">Consulter la bibliographie complète</a>
          </div>
          <Content />

          <aside class="article-limitations" aria-labelledby="limitations-title">
            <h2 id="limitations-title">Ce que le corpus ne permet pas de trancher</h2>
            <ul>
              {entry.data.limitations.map((limitation) => <li>{limitation}</li>)}
            </ul>
          </aside>
        </div>
      </div>

      <CitedSources evidenceIds={evidenceIds} />

      <footer class="article-author">
        <div>
          <p class="eyebrow">Responsabilité éditoriale</p>
          <h2>{author.name}</h2>
        </div>
        <div>
          <p>
            Cette signature couvre la sélection des sources, leur attribution,
            la comparaison des protocoles et la formulation des limites. Une
            correction importante reste datée et expliquée.
          </p>
          <a href={author.url}>Voir les signatures de la rédaction</a>
          <a href="/corrections/">Consulter la politique de correction</a>
        </div>
      </footer>
    </article>
  </div>
</BaseLayout>

<style>
  .article-shell {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    padding-block: clamp(2rem, 4.5vw, 4rem);
  }

  .article-header {
    grid-column: 1 / span 7;
    grid-row: 1;
  }

  .article-header h1 {
    max-width: 15ch;
    margin-bottom: 1.5rem;
    font-size: clamp(3.2rem, 5.6vw, 5.7rem);
    line-height: 0.94;
  }

  .article-header__summary {
    max-width: 46rem;
    color: var(--color-graphite);
    font-size: clamp(1.12rem, 2vw, 1.35rem);
    line-height: 1.52;
  }

  .article-byline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.25rem;
    margin-top: 1.25rem;
    padding-top: 0.8rem;
    border-top: 1px solid var(--color-line);
  }

  .article-byline p {
    margin: 0;
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .article-byline a {
    color: var(--color-probe);
    font-weight: 500;
  }

  .article-lead-media {
    grid-column: 8 / -1;
    grid-row: 1;
    position: relative;
    min-width: 0;
    min-height: 22rem;
    margin: 0;
    overflow: hidden;
    background: var(--color-steel-soft);
  }

  .article-lead-media img {
    width: 100%;
    height: 100%;
    min-height: 22rem;
    object-fit: cover;
  }

  .article-lead-media figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 0.65rem 0.8rem;
    color: var(--color-carbon-muted);
    background: color-mix(in srgb, var(--color-carbon) 88%, transparent);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .article-facts {
    grid-column: 1 / -1;
    grid-row: 2;
    display: flex;
    align-items: center;
    gap: 1rem 1.5rem;
    padding-block: 0.65rem;
    border-block: 1px solid var(--color-line);
  }

  .article-facts dl {
    display: grid;
    grid-auto-columns: minmax(9rem, 1fr);
    grid-auto-flow: column;
    flex: 1;
    margin: 0;
  }

  .article-facts dl > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 1rem;
    padding-inline: 0.85rem;
    border-right: 1px solid var(--color-line);
  }

  .article-facts dl > div:first-child {
    padding-left: 0;
  }

  .article-facts dt,
  .article-facts dd {
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.4;
    text-transform: uppercase;
  }

  .article-facts dt {
    color: var(--color-graphite);
  }

  .article-facts dd {
    max-width: 11rem;
    margin: 0;
    text-align: right;
  }

  .article-facts__proofs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    justify-content: flex-end;
  }

  .article-reading-grid {
    grid-column: 1 / -1;
    grid-row: 3;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    margin-top: clamp(1.25rem, 3vw, 2.5rem);
    padding-top: clamp(1.25rem, 3vw, 2.5rem);
    border-top: 1px solid var(--color-carbon);
  }

  .article-toc {
    grid-column: 1 / span 3;
    align-self: start;
    position: sticky;
    top: 1.5rem;
  }

  .article-toc > p {
    margin-bottom: 0.75rem;
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .article-toc ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
    list-style: none;
    counter-reset: toc;
  }

  .article-toc li {
    counter-increment: toc;
    border-bottom: 1px solid var(--color-line);
  }

  .article-toc li a {
    display: grid;
    grid-template-columns: 1.8rem 1fr;
    gap: 0.5rem;
    padding-block: 0.75rem;
    color: var(--color-graphite);
    font-size: 0.78rem;
    line-height: 1.45;
    text-decoration: none;
  }

  .article-toc li a::before {
    content: counter(toc, decimal-leading-zero);
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.75rem;
  }

  .article-toc li a:hover {
    color: var(--color-probe);
  }

  .article-toc__method {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin-top: 1rem;
    color: var(--color-probe);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .article-body {
    grid-column: 4 / span 7;
    min-width: 0;
    font-size: 1.08rem;
    line-height: 1.74;
  }

  .article-body > :global(*) {
    max-width: var(--reading-width);
  }

  .article-body :global(h2) {
    scroll-margin-top: 2rem;
  }

  .documentary-notice {
    display: grid;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
    padding: 1rem 1.15rem;
    border-left: 3px solid var(--color-probe);
    background: var(--color-steel-soft);
  }

  .documentary-notice strong {
    font-family: var(--font-display);
    font-size: 1.25rem;
  }

  .documentary-notice span {
    color: var(--color-graphite);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .documentary-notice a {
    justify-self: start;
    color: var(--color-probe);
    font-size: 0.78rem;
    font-weight: 600;
  }

  .article-limitations {
    margin-top: 2.5rem;
    padding: 1.5rem;
    border-top: 2px solid var(--color-carbon);
    border-bottom: 1px solid var(--color-line);
    background: var(--color-steel-soft);
  }

  .article-limitations h2 {
    margin: 0 0 1rem;
    font-size: clamp(1.8rem, 3vw, 2.5rem);
  }

  .article-limitations ul {
    margin-bottom: 0;
    color: var(--color-graphite);
  }

  .article-author {
    grid-column: 2 / span 10;
    display: grid;
    grid-template-columns: 4fr 6fr;
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 4.5rem);
    padding: clamp(1.5rem, 3.5vw, 2.75rem);
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .article-author .eyebrow {
    color: var(--color-reading);
  }

  .article-author h2 {
    margin: 0;
    font-size: clamp(2.4rem, 4vw, 4rem);
    line-height: 0.96;
  }

  .article-author > div:last-child {
    align-self: end;
  }

  .article-author > div:last-child p {
    color: var(--color-carbon-muted);
    line-height: 1.65;
  }

  .article-author a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin: 0.5rem 1.2rem 0 0;
    color: var(--color-reading);
  }

  @media (max-width: 64rem) {
    .article-header {
      grid-column: 1 / span 7;
    }

    .article-lead-media {
      grid-column: 8 / -1;
    }

    .article-toc {
      grid-column: 1 / span 4;
    }

    .article-body {
      grid-column: 5 / -1;
    }

    .article-facts {
      align-items: flex-start;
    }

    .article-facts dl {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .article-facts dl > div {
      padding: 0.35rem 0.75rem;
      border-right: 1px solid var(--color-line);
    }
  }

  @media (max-width: 48rem) {
    .article-shell,
    .article-reading-grid,
    .article-author {
      grid-template-columns: 1fr;
    }

    .article-header,
    .article-lead-media,
    .article-facts,
    .article-reading-grid,
    .article-toc,
    .article-body,
    .article-author {
      grid-column: 1;
    }

    .article-header {
      grid-row: 1;
    }

    .article-lead-media {
      grid-row: 2;
      min-height: 0;
      aspect-ratio: 16 / 10;
    }

    .article-lead-media img {
      min-height: 0;
    }

    .article-facts {
      grid-row: 3;
      display: grid;
      padding-block: 0.5rem;
    }

    .article-reading-grid {
      grid-row: 4;
    }

    .article-header h1 {
      font-size: clamp(3rem, 15vw, 4.6rem);
    }

    .article-facts {
      margin-top: 0;
    }

    .article-reading-grid {
      gap: 1.5rem;
    }

    .article-toc {
      position: static;
      overflow-x: auto;
      padding-bottom: 0.35rem;
    }

    .article-toc ol {
      display: flex;
      width: max-content;
      max-width: none;
    }

    .article-toc li {
      width: min(15rem, 72vw);
      border-right: 1px solid var(--color-line);
    }

    .article-toc li a {
      min-height: 4rem;
      align-items: center;
      padding: 0.65rem;
    }

    .article-author {
      gap: 1.5rem;
    }
  }
</style>
