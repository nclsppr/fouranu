---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { SITE } from "@/config/site";
import { articlePath, isPublishedAnalysis } from "@/data/article-taxonomy";

const modelDossiers = (await getCollection("analyses"))
  .filter(isPublishedAnalysis)
  .filter(
    (entry) =>
      entry.data.locale === "fr" &&
      entry.data.brand === "fours" &&
      entry.data.category === "oven",
  )
  .sort((a, b) => a.data.articleId.localeCompare(b.data.articleId));

if (modelDossiers.length !== 5) {
  throw new Error(
    `Le guide Fours à pizza exige cinq dossiers multimarques, ${modelDossiers.length} trouvé(s).`,
  );
}

const canonical = new URL("/fours-a-pizza/", SITE.url).toString();
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      url: canonical,
      name: "Choisir un four à pizza selon son usage",
      description:
        "Guide de choix et dossiers multimarques sur les fours à pizza intérieurs et extérieurs.",
      inLanguage: SITE.language,
      isPartOf: { "@id": `${SITE.url}/#website` },
      mainEntity: { "@id": `${canonical}#dossiers` },
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#dossiers`,
      numberOfItems: modelDossiers.length,
      itemListElement: modelDossiers.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: new URL(articlePath(entry.data.brand, entry.id), SITE.url).toString(),
        name: entry.data.title,
      })),
    },
  ],
};
---

<BaseLayout
  title="Choisir un four à pizza selon son usage | Four à Nu"
  description="Commencez par le lieu, l'énergie, le rythme des fournées et le budget total avant de comparer les marques de fours à pizza."
  indexable={true}
  schema={schema}
>
  <div class="page-shell">
    <Breadcrumbs items={[{ label: "Accueil", href: "/" }, { label: "Fours à pizza" }]} />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">Guide de choix</p>
        <h1>Comment choisir un four à pizza selon son usage&nbsp;?</h1>
        <p class="page-intro__lede">
          Quatre contraintes éliminent plus de mauvais choix qu'un classement
          général. Elles permettent de réduire la gamme avant de comparer les
          caractéristiques et les observations publiées.
        </p>
      </div>
      <p class="page-intro__aside">
        Ce guide ne remplace pas les consignes du fabricant, du logement ou du
        raccordement. La sécurité locale passe avant toute préférence d'énergie.
      </p>
    </header>

    <div class="constraint-list">
      <section id="lieu">
        <span>01 · Lieu</span>
        <div>
          <h2>Où le four peut-il fonctionner&nbsp;?</h2>
          <p>
            L'intérieur, le balcon, la terrasse et le jardin n'ouvrent pas les
            mêmes options. Les règles du logement et les consignes du fabricant
            passent avant le goût pour un combustible.
          </p>
        </div>
        <p class="constraint-list__check">À relever : intérieur ou extérieur, ventilation, prise, gaz autorisé, stockage.</p>
      </section>

      <section id="energie">
        <span>02 · Énergie</span>
        <div>
          <h2>Combien d'attention voulez-vous donner au feu&nbsp;?</h2>
          <p>
            Le gaz simplifie le réglage. L'électrique répond à certains usages
            intérieurs. Le multi-combustible ajoute des choix, mais aussi des
            gestes et de l'entretien. Ce sont des différences d'usage, pas un
            classement de goût.
          </p>
        </div>
        <a href="/ooni/gaz-electrique-ou-multicombustible/">Voir l'analyse Ooni <span aria-hidden="true">↗</span></a>
      </section>

      <section id="debit">
        <span>03 · Rythme</span>
        <div>
          <h2>Une grande ouverture ne raconte pas toute la cadence.</h2>
          <p>
            Le diamètre de la pizza, la marge pour la tourner et la récupération
            de la sole entre deux cuissons doivent être séparés. Les sources
            disponibles ne permettent pas encore de comparer la cadence dans
            les mêmes conditions.
          </p>
        </div>
        <p class="constraint-list__check">À relever : diamètre habituel, nombre de convives, séries fréquentes ou occasionnelles.</p>
      </section>

      <section id="cout">
        <span>04 · Coût</span>
        <div>
          <h2>Le prix du four n'est pas le prix de l'installation.</h2>
          <p>
            Une pelle, une table stable, une housse, un détendeur ou un brûleur
            additionnel peuvent changer l'écart entre deux modèles. Les prix et
            promotions seront datés au lieu d'être figés dans une fausse bonne affaire.
          </p>
        </div>
        <p class="constraint-list__check">À relever : équipement déjà possédé, rangement, combustible et pièces nécessaires.</p>
      </section>
    </div>

    <section class="model-dossiers" aria-labelledby="model-dossiers-title">
      <header class="model-dossiers__head">
        <p class="eyebrow">Cinq modèles · intérieur et extérieur</p>
        <h2 id="model-dossiers-title">Ouvrez le dossier qui correspond à votre contrainte.</h2>
        <p>
          Chaque page sépare les annonces du fabricant, les mesures tierces et
          notre conclusion. Aucun classement général&nbsp;: le lieu, l'énergie et
          les gestes à accepter restent le point de départ.
        </p>
      </header>

      <div class="model-dossiers__list">
        {modelDossiers.map((entry) => (
          <a class="model-dossier" href={articlePath(entry.data.brand, entry.id)}>
            <span class="model-dossier__image">
              <img
                src={entry.data.image.src}
                srcset={`${entry.data.image.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image.src} 1600w`}
                sizes="(max-width: 48rem) 100vw, 36vw"
                alt={entry.data.image.alt}
                width="1600"
                height="900"
                loading="lazy"
              />
            </span>
            <span class="model-dossier__copy">
              <span class="eyebrow">{entry.data.model}</span>
              <strong>{entry.data.title}</strong>
              <span>{entry.data.summary}</span>
              <span class="model-dossier__meta">
                Par {SITE.authors[entry.data.author].name}
                <b>Lire le dossier <span aria-hidden="true">↗</span></b>
              </span>
            </span>
          </a>
        ))}
      </div>
    </section>

    <aside class="next-step">
      <p class="eyebrow">Marques documentées</p>
      <h2>Continuez avec les gammes complètes.</h2>
      <p>Ces cinq dossiers multimarques complètent les neuf fours Ooni et les sept fours Gozney déjà couverts. Les comparatifs restent regroupés lorsqu’une page commune répond mieux à la décision, comme pour l’Arc Lite et le Tread.</p>
      <div class="next-step__links">
        <a class="button-link" href="/ooni/">Explorer Ooni</a>
        <a class="button-link button-link--quiet" href="/gozney/">Découvrir Gozney</a>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  .constraint-list {
    border-top: 1px solid var(--color-carbon);
  }

  .constraint-list section {
    display: grid;
    grid-template-columns: 1fr 5fr 3fr;
    gap: 1.5rem;
    padding-block: 2rem;
    border-bottom: 1px solid var(--color-line);
    scroll-margin-top: 2rem;
  }

  .constraint-list section > span,
  .constraint-list__check {
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .constraint-list h2 {
    max-width: 19ch;
    margin-bottom: 0.5rem;
    font-size: clamp(2rem, 4vw, 3.5rem);
    line-height: 1;
  }

  .constraint-list section > div p {
    max-width: 48rem;
    margin-bottom: 0;
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .constraint-list section > a {
    display: inline-flex;
    min-height: 2.75rem;
    align-self: end;
    align-items: center;
    color: var(--color-probe);
    font-weight: 600;
  }

  .model-dossiers {
    padding-block: clamp(3.5rem, 7vw, 6rem);
    border-bottom: 1px solid var(--color-carbon);
  }

  .model-dossiers__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    align-items: end;
    margin-bottom: 2rem;
  }

  .model-dossiers__head .eyebrow {
    grid-column: 1 / -1;
  }

  .model-dossiers__head h2 {
    grid-column: 1 / span 8;
    max-width: 15ch;
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 5rem);
    line-height: 0.96;
  }

  .model-dossiers__head > p:last-child {
    grid-column: 9 / -1;
    max-width: 60ch;
    margin: 0;
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .model-dossiers__list {
    border-top: 1px solid var(--color-carbon);
  }

  .model-dossier {
    display: grid;
    grid-template-columns: minmax(16rem, 5fr) minmax(0, 7fr);
    gap: 1.5rem;
    min-height: 2.75rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .model-dossier:focus-visible {
    outline: 2px solid var(--color-probe);
    outline-offset: 4px;
  }

  .model-dossier__image {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 9;
    background: var(--color-steel-soft);
  }

  .model-dossier__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 180ms ease;
  }

  .model-dossier__copy {
    display: grid;
    align-content: start;
    gap: 0.9rem;
  }

  .model-dossier__copy strong {
    max-width: 18ch;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 4.2rem);
    font-weight: 600;
    line-height: 0.96;
  }

  .model-dossier__copy > span:not(.eyebrow, .model-dossier__meta) {
    max-width: 60ch;
    color: var(--color-graphite);
    font-family: var(--font-body);
    line-height: 1.6;
  }

  .model-dossier__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    margin-top: 0.25rem;
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .model-dossier__meta b {
    color: var(--color-probe);
    font-weight: 600;
  }

  .model-dossier:hover .model-dossier__image img {
    transform: scale(1.015);
  }

  @media (prefers-reduced-motion: reduce) {
    .model-dossier__image img {
      transition: none;
    }

    .model-dossier:hover .model-dossier__image img {
      transform: none;
    }
  }

  .next-step {
    display: grid;
    grid-template-columns: 4fr 4fr 3fr;
    gap: 1.5rem;
    align-items: end;
    margin-top: 4rem;
    padding: 2rem;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .next-step .eyebrow {
    grid-column: 1 / -1;
    color: var(--color-reading);
  }

  .next-step h2 {
    margin: 0;
    font-size: clamp(2.6rem, 5vw, 4.5rem);
    line-height: 0.95;
  }

  .next-step > p:not(.eyebrow) {
    margin: 0;
    color: var(--color-carbon-muted);
    line-height: 1.6;
  }

  .next-step .button-link {
    color: var(--color-carbon);
    border-color: var(--color-reading);
    background: var(--color-reading);
  }

  .next-step__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .next-step .button-link--quiet {
    color: var(--color-white);
    border-color: var(--color-carbon-line);
    background: transparent;
  }

  .next-step .button-link--quiet:hover {
    color: var(--color-carbon);
    border-color: var(--color-reading);
    background: var(--color-reading);
  }

  @media (max-width: 64rem) {
    .constraint-list section {
      grid-template-columns: 4.5rem minmax(0, 1fr);
    }

    .constraint-list__check,
    .constraint-list section > a {
      grid-column: 2;
      justify-self: start;
    }

    .constraint-list section > a {
      align-self: start;
    }
  }

  @media (max-width: 48rem) {
    .constraint-list section,
    .next-step,
    .model-dossiers__head,
    .model-dossier {
      grid-template-columns: 1fr;
    }

    .constraint-list section {
      gap: 1rem;
      padding-block: 1.5rem;
    }

    .constraint-list__check,
    .constraint-list section > a {
      grid-column: 1;
    }

    .next-step .eyebrow {
      grid-column: 1;
    }

    .model-dossiers__head .eyebrow,
    .model-dossiers__head h2,
    .model-dossiers__head > p:last-child {
      grid-column: 1;
    }

    .model-dossier {
      gap: 1rem;
    }

    .next-step {
      margin-top: 3rem;
      padding: 1.5rem;
    }
  }
</style>
