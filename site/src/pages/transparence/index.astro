---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { staticAlternates, staticRoute, type Locale } from "@/i18n/config";
import { TRANSPARENCY_COPY } from "@/i18n/trust-pages";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = TRANSPARENCY_COPY[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={staticRoute("transparency", locale)}
  alternatePaths={staticAlternates("transparency")}
  indexable={true}
>
  <div class="page-shell">
    <Breadcrumbs locale={locale} items={[{ label: copy.home, href: staticRoute("home", locale) }, { label: copy.breadcrumb }]} />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="page-intro__lede">{copy.lead}</p>
      </div>
      <p class="page-intro__aside">{copy.asideBeforePartner}<strong>{copy.partnerId}</strong>{copy.asideAfterPartner}</p>
    </header>

    <section class="transparency-rules" aria-label={copy.rulesAria}>
      {copy.rules.map((rule, index) => (
        <article><span>{String(index + 1).padStart(2, "0")}</span><h2>{rule.heading}</h2><p>{rule.body}</p></article>
      ))}
    </section>

    <section class="transparency-status">
      <div><p class="eyebrow">{copy.statusEyebrow}</p><h2>{copy.statusHeading}</h2></div>
      <div><p><strong>{copy.disclosure}</strong>{copy.statusBody}</p><a href={staticRoute("method", locale)}>{copy.methodLink}</a></div>
    </section>
  </div>
</BaseLayout>

<style>
  .transparency-rules {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-block: 4rem;
  }

  .transparency-rules article {
    padding: 1.5rem;
    border-top: 1px solid var(--color-line);
    border-right: 1px solid var(--color-line);
  }

  .transparency-rules article:nth-child(even) {
    border-right: 0;
  }

  .transparency-rules span {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.75rem;
  }

  .transparency-rules h2 {
    margin: 2rem 0 0.75rem;
    font-size: clamp(2rem, 3.3vw, 3rem);
    line-height: 1;
  }

  .transparency-rules p {
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .transparency-rules code {
    font-family: var(--font-data);
    font-size: 0.82em;
  }

  .transparency-status {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 2rem;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .transparency-status .eyebrow,
  .transparency-status a {
    color: var(--color-reading);
  }

  .transparency-status h2 {
    margin: 0;
    font-size: clamp(2.7rem, 5vw, 4.7rem);
    line-height: 0.95;
  }

  .transparency-status > div:last-child {
    align-self: end;
  }

  .transparency-status p {
    color: var(--color-carbon-muted);
    line-height: 1.65;
  }

  .transparency-status a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
  }

  @media (max-width: 48rem) {
    .transparency-rules,
    .transparency-status {
      grid-template-columns: 1fr;
    }

    .transparency-rules article {
      border-right: 0;
    }

    .transparency-rules h2 {
      margin-top: 1.5rem;
    }

    .transparency-rules {
      padding-block: 3rem;
    }

    .transparency-status {
      gap: 1.5rem;
      padding: 1.5rem;
    }
  }
</style>
