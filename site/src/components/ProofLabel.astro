---
interface Props {
  code: "FAB" | "T-MES" | "T-OBS" | "FAN-SYN" | "FAN-INF";
}

const { code } = Astro.props;
const names = {
  FAB: "Donnée fabricant",
  "T-MES": "Mesure tierce",
  "T-OBS": "Observation tierce",
  "FAN-SYN": "Synthèse Four à Nu",
  "FAN-INF": "Inférence éditoriale Four à Nu",
} as const;
const labels = {
  FAB: "Annonce",
  "T-MES": "Mesure publiée",
  "T-OBS": "Observation publiée",
  "FAN-SYN": "Synthèse",
  "FAN-INF": "Conclusion",
} as const;
---

<span
  class="proof-label"
  aria-label={names[code]}
  title={names[code]}
>
  {labels[code]}
</span>
