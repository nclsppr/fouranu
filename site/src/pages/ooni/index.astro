---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { SITE } from "@/config/site";
import { isPublishedAnalysis } from "@/data/article-taxonomy";
import {
  LOCALE_INFO,
  articleRoute,
  staticAlternates,
  staticRoute,
  type ArticleId,
  type Locale,
} from "@/i18n/config";
import { localizedSite } from "@/i18n/common";
import { HUB_COPY } from "@/i18n/hubs";
import {
  assertResponsiveMediaAllowedAtPath,
  mediaAllowedInLocale,
} from "@/lib/media-rights.mjs";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = HUB_COPY.ooni[locale];
const localized = localizedSite(locale);

const analyses = (await getCollection("analyses"))
  .filter((entry) => entry.data.locale === locale)
  .filter(isPublishedAnalysis)
  .filter((entry) => entry.data.brand === "ooni");
const modelEntries = analyses.filter(
  (entry) => entry.data.category === "oven" && entry.data.type === "model",
);
const equipmentEntries = analyses.filter((entry) => entry.data.category === "mixer");
const haloComparison = equipmentEntries.find((entry) => entry.data.articleId === "OONI-040");
const rangeGuide = analyses.find((entry) => entry.data.articleId === "OONI-001");
const entriesByArticleId = new Map(modelEntries.map((entry) => [entry.data.articleId, entry]));
const dateFormatter = new Intl.DateTimeFormat(LOCALE_INFO[locale].intlLocale, {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});

const rangeDefinitions = [
  {
    id: "koda",
    name: "Koda",
    articleIds: ["OONI-010", "OONI-011", "OONI-012", "OONI-013", "OONI-014"],
  },
  {
    id: "karu",
    name: "Karu",
    articleIds: ["OONI-015", "OONI-016", "OONI-017"],
  },
  {
    id: "volt",
    name: "Volt",
    articleIds: ["OONI-018"],
  },
] as const;
const ranges = rangeDefinitions.map((range) => ({
  ...range,
  energy: copy.energies[range.id],
  models: range.articleIds.map((articleId) => {
    const entry = entriesByArticleId.get(articleId);
    if (!entry) throw new Error(`Dossier Ooni ${locale} absent : ${articleId}`);
    return entry;
  }),
}));

if (modelEntries.length !== 9) {
  throw new Error(`La page Ooni exige neuf fiches modèle, ${modelEntries.length} trouvée(s).`);
}

if (equipmentEntries.length !== 1 || !haloComparison) {
  throw new Error("La page Ooni exige exactement le comparatif Halo Core ou Halo Pro.");
}

if (!rangeGuide) {
  throw new Error("Le guide de gamme Ooni est requis pour la page et son aperçu social.");
}
for (const entry of analyses) {
  assertResponsiveMediaAllowedAtPath(entry.data.image!.src, locale, "hub-list", staticRoute("ooni", locale));
}
const useRangeSocialImage =
  mediaAllowedInLocale(rangeGuide.data.image!.assetId, locale, "open-graph")
  && mediaAllowedInLocale(rangeGuide.data.image!.assetId, locale, "twitter");

const canonical = new URL(staticRoute("ooni", locale), SITE.url).toString();
const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      "@id": `${canonical}#collection`,
      url: canonical,
      name: copy.schemaName,
      description: copy.schemaDescription,
      inLanguage: localized.language,
      isPartOf: { "@id": `${SITE.url}/#website` },
      mainEntity: { "@id": `${canonical}#models` },
      hasPart: { "@id": `${canonical}#equipment` },
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#equipment`,
      numberOfItems: equipmentEntries.length,
      itemListElement: equipmentEntries.map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: new URL(articleRoute(entry.data.articleId as ArticleId, locale), SITE.url).toString(),
        name: entry.data.title,
      })),
    },
    {
      "@type": "ItemList",
      "@id": `${canonical}#models`,
      numberOfItems: modelEntries.length,
      itemListElement: ranges.flatMap((range) => range.models).map((entry, index) => ({
        "@type": "ListItem",
        position: index + 1,
        url: new URL(articleRoute(entry.data.articleId as ArticleId, locale), SITE.url).toString(),
        name: entry.data.title,
      })),
    },
  ],
};
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  image={useRangeSocialImage ? rangeGuide.data.image!.src : localized.socialImage}
  imageAlt={useRangeSocialImage ? rangeGuide.data.image!.alt : undefined}
  imageWidth={useRangeSocialImage ? 1600 : 1200}
  imageHeight={useRangeSocialImage ? 900 : 630}
  canonical={canonical}
  alternatePaths={staticAlternates("ooni")}
  indexable={true}
  schema={schema}
>
  <div class="page-shell">
    <Breadcrumbs
      locale={locale}
      items={[
        { label: copy.home, href: staticRoute("home", locale) },
        { label: "Ooni" },
      ]}
    />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">{copy.introEyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="page-intro__lede">{copy.lead}</p>
      </div>
      <p class="page-intro__aside">{copy.aside}</p>
    </header>

    <section class="lead-analysis" aria-labelledby="lead-analysis-title">
      <p class="eyebrow">{copy.leadEyebrow}</p>
      <h2 id="lead-analysis-title">{copy.leadHeading}</h2>
      <div>
        <a class="link-row" href={articleRoute("OONI-001", locale)}>
          <span class="link-row__title">{copy.rangeGuideTitle}</span>
          <span class="link-row__meta">{copy.rangeGuideMeta}</span>
          <span class="link-row__arrow" aria-hidden="true">↗</span>
        </a>
        <a class="link-row" href={articleRoute("OONI-004", locale)}>
          <span class="link-row__title">{copy.energyGuideTitle}</span>
          <span class="link-row__meta">{copy.energyGuideMeta}</span>
          <span class="link-row__arrow" aria-hidden="true">↗</span>
        </a>
      </div>
    </section>

    <section class="equipment" aria-labelledby="equipment-title">
      <header>
        <p class="eyebrow">{copy.equipmentEyebrow}</p>
        <h2 id="equipment-title">{copy.equipmentHeading}</h2>
        <p>{copy.equipmentBody}</p>
      </header>

      <div class="equipment__list">
        {equipmentEntries.map((entry) => (
          <a href={articleRoute(entry.data.articleId as ArticleId, locale)}>
            <span class="equipment__image">
              <img
                src={entry.data.image!.src}
                srcset={`${entry.data.image!.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image!.src} 1600w`}
                sizes="(max-width: 48rem) 100vw, 12rem"
                alt={entry.data.image!.alt}
                width="960"
                height="540"
                loading="lazy"
              />
            </span>
            <span class="equipment__copy">
              <strong>{entry.data.title}</strong>
              <small>{entry.data.summary}</small>
              <b>{copy.equipmentRead} <span aria-hidden="true">↗</span></b>
            </span>
          </a>
        ))}
      </div>
    </section>

    <section class="ranges" aria-labelledby="ranges-title">
      <div class="ranges__head">
        <p class="eyebrow">{copy.rangesEyebrow}</p>
        <h2 id="ranges-title">{copy.rangesHeading}</h2>
        <p>{copy.rangesBody}</p>
      </div>

      {ranges.map((range) => (
        <article class="range" id={range.id}>
          <header>
            <span>{String(range.models.length).padStart(2, "0")}</span>
            <h3>{range.name}</h3>
            <p>{range.energy}</p>
          </header>
          <div class="range__models">
            {range.models.map((entry) => (
              <a href={articleRoute(entry.data.articleId as ArticleId, locale)}>
                <span class="range__model-image">
                  <img
                    src={entry.data.image!.src}
                    srcset={`${entry.data.image!.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image!.src} 1600w`}
                    sizes="7.5rem"
                    alt=""
                    width="320"
                    height="180"
                    loading="lazy"
                  />
                </span>
                <span class="range__model-copy">
                  <strong>{entry.data.model}</strong>
                  <small>{entry.data.summary}</small>
                </span>
                <time datetime={entry.data.updatedAt.toISOString()}>
                  {copy.updated} {dateFormatter.format(entry.data.updatedAt)}
                </time>
                <span class="range__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
          </div>
        </article>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  .lead-analysis {
    padding-block: 3rem;
    border-bottom: 1px solid var(--color-line);
  }

  .equipment {
    display: grid;
    grid-template-columns: minmax(15rem, 4fr) minmax(0, 8fr);
    gap: 1.5rem;
    padding-block: 3rem;
    border-bottom: 1px solid var(--color-line);
  }

  .equipment > header {
    align-self: end;
  }

  .equipment > header h2 {
    max-width: 13ch;
    margin-bottom: 0.75rem;
    font-size: clamp(2.4rem, 4vw, 4rem);
    line-height: 0.98;
  }

  .equipment > header > p:last-child {
    max-width: 32rem;
    margin-bottom: 0;
    color: var(--color-graphite);
    line-height: 1.55;
  }

  .equipment__list {
    border-top: 1px solid var(--color-carbon);
  }

  .equipment__list > a {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr);
    gap: 1rem;
    min-height: 11rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .equipment__image {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-steel-soft);
  }

  .equipment__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .equipment__copy {
    display: grid;
    align-content: center;
    gap: 0.5rem;
  }

  .equipment__copy strong {
    font-family: var(--font-display);
    font-size: clamp(1.7rem, 2.5vw, 2.5rem);
    line-height: 1;
  }

  .equipment__copy small {
    color: var(--color-graphite);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .equipment__copy b {
    color: var(--color-probe);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .lead-analysis h2 {
    max-width: 18ch;
    margin-bottom: 1.25rem;
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 0.98;
  }

  .ranges {
    padding-top: 3rem;
  }

  .ranges__head {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .ranges__head .eyebrow {
    grid-column: 1 / -1;
  }

  .ranges__head h2 {
    grid-column: 1 / span 7;
    margin: 0;
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 0.95;
  }

  .ranges__head > p:last-child {
    grid-column: 9 / -1;
    align-self: end;
    margin: 0;
    color: var(--color-graphite);
  }

  .range {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 1.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--color-carbon);
    scroll-margin-top: 2rem;
  }

  .range header {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    align-content: start;
    gap: 0.2rem 1rem;
  }

  .range header > span,
  .range header p,
  .range__models span {
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .range header h3 {
    margin: 0;
    font-size: clamp(2.5rem, 5vw, 4.5rem);
    line-height: 0.9;
  }

  .range header p {
    grid-column: 2;
    margin: 0;
  }

  .range__models {
    border-top: 1px solid var(--color-line);
  }

  .range__models a {
    display: grid;
    grid-template-columns: 7.5rem minmax(0, 1fr) minmax(9rem, auto) auto;
    gap: 1rem;
    align-items: center;
    min-height: 6rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .range__model-copy {
    display: grid;
    gap: 0.35rem;
  }

  .range__model-image {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    background: var(--color-steel-soft);
  }

  .range__model-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .range__model-copy strong {
    font-family: var(--font-display);
    font-size: 1.45rem;
  }

  .range__model-copy small {
    max-width: 58ch;
    color: var(--color-graphite);
    font-family: var(--font-body);
    font-size: 0.84rem;
    line-height: 1.5;
    text-transform: none;
  }

  .range__models time,
  .range__arrow {
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.4;
    text-align: right;
    text-transform: uppercase;
  }

  .range__models a:hover strong,
  .range__models a:hover .range__arrow {
    color: var(--color-probe);
  }

  @media (max-width: 48rem) {
    .equipment,
    .ranges__head,
    .range {
      grid-template-columns: 1fr;
    }

    .equipment__list > a {
      grid-template-columns: 8rem minmax(0, 1fr);
      min-height: 8rem;
    }

    .equipment__copy small {
      display: -webkit-box;
      overflow: hidden;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .ranges__head .eyebrow,
    .ranges__head h2,
    .ranges__head > p:last-child {
      grid-column: 1;
    }

    .range {
      gap: 1.25rem;
    }

    .range__models a {
      grid-template-columns: 6rem minmax(0, 1fr) auto;
      min-height: 0;
      padding-block: 0.8rem;
    }

    .range__models time {
      grid-column: 2;
      grid-row: 2;
      text-align: left;
    }

    .range__arrow {
      grid-column: 3;
      grid-row: 1 / span 2;
    }

    .range__model-image {
      grid-row: 1 / span 2;
    }
  }
</style>
