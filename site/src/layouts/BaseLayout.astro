---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-sans-condensed/latin-600.css";
import "@fontsource/ibm-plex-sans-condensed/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import sansRegularWoff2 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import condensedSemiboldWoff2 from "@fontsource/ibm-plex-sans-condensed/files/ibm-plex-sans-condensed-latin-600-normal.woff2?url";
import "@/styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import { INDEXING_ENABLED, SITE } from "@/config/site";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string | false;
  indexable?: boolean;
  pageType?: "website" | "article";
  authorName?: string;
  publishedAt?: Date | string;
  modifiedAt?: Date | string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = SITE.title,
  description = SITE.description,
  image = SITE.socialImage,
  imageAlt = "Four à Nu, fours à pizza sources à l'appui",
  imageWidth = 1200,
  imageHeight = 630,
  canonical: canonicalOverride,
  indexable = false,
  pageType = "website",
  authorName = SITE.editorialAuthor.name,
  publishedAt,
  modifiedAt,
  schema,
} = Astro.props;

if (!title.trim()) throw new Error("BaseLayout exige un titre non vide.");
if (!description.trim()) throw new Error("BaseLayout exige une description non vide.");

const canonical = canonicalOverride === false
  ? undefined
  : new URL(canonicalOverride ?? Astro.url.pathname, SITE.url).toString();
const socialImage = new URL(image, SITE.url).toString();
const socialImageType = image.endsWith(".webp")
  ? "image/webp"
  : image.endsWith(".jpg") || image.endsWith(".jpeg")
    ? "image/jpeg"
    : "image/png";
const allowIndexing = INDEXING_ENABLED && indexable;
const robots = allowIndexing
  ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  : "noindex, follow";
const articleModifiedTime = modifiedAt
  ? new Date(modifiedAt).toISOString()
  : undefined;
const articlePublishedTime = publishedAt
  ? new Date(publishedAt).toISOString()
  : undefined;
const serializedSchema = schema
  ? JSON.stringify(schema).replaceAll("<", "\\u003c")
  : undefined;
---

<!doctype html>
<html lang={SITE.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="application/rss+xml" title="Four à Nu" href="/rss.xml" />
    <link rel="preload" href={sansRegularWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={condensedSemiboldWoff2} as="font" type="font/woff2" crossorigin="anonymous" />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={SITE.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {pageType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {pageType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {pageType === "article" && (
      <meta property="article:author" content={authorName} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {serializedSchema && <script is:inline type="application/ld+json" set:html={serializedSchema} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <SiteHeader />
    <main id="contenu">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
