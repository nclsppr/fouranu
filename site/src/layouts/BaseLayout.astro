---
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-sans-condensed/latin-600.css";
import "@fontsource/ibm-plex-sans-condensed/latin-700.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import sansRegularWoff2 from "@fontsource/ibm-plex-sans/files/ibm-plex-sans-latin-400-normal.woff2?url";
import condensedSemiboldWoff2 from "@fontsource/ibm-plex-sans-condensed/files/ibm-plex-sans-condensed-latin-600-normal.woff2?url";
import "@/styles/global.css";
import SiteHeader from "@/components/SiteHeader.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import ShareActions from "@/components/ShareActions.astro";
import { FIXED_INDEXABLE_ROUTES, INDEXING_ENABLED, SITE } from "@/config/site";
import {
  LOCALES,
  LOCALE_INFO,
  alternatePathsForCurrentPath,
  feedPath,
  localeFromPath,
  staticRoute,
  staticRouteIdFromPath,
  type Locale,
} from "@/i18n/config";
import { SHELL_COPY, localizedSite } from "@/i18n/common";

interface Props {
  title?: string;
  socialTitle?: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string | false;
  indexable?: boolean;
  pageType?: "website" | "article";
  authorName?: string;
  authorUrl?: string;
  articleSection?: string;
  publishedAt?: Date | string;
  modifiedAt?: Date | string;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  alternatePaths?: Record<Locale, string> | false;
}

const locale = localeFromPath(Astro.url.pathname);
const localeInfo = LOCALE_INFO[locale];
const localized = localizedSite(locale);
const shellCopy = SHELL_COPY[locale];
const {
  title = localized.title,
  socialTitle: socialTitleOverride,
  description = localized.description,
  image = SITE.socialImage,
  imageAlt = shellCopy.defaultImageAlt,
  imageWidth = 1200,
  imageHeight = 630,
  canonical: canonicalOverride,
  indexable = false,
  pageType = "website",
  authorName = localized.editorialAuthor.name,
  authorUrl,
  articleSection,
  publishedAt,
  modifiedAt: modifiedAtOverride,
  schema,
  alternatePaths: alternatePathsOverride,
} = Astro.props;

if (!title.trim()) throw new Error("BaseLayout exige un titre non vide.");
if (!description.trim()) throw new Error("BaseLayout exige une description non vide.");

const canonical = canonicalOverride === false
  ? undefined
  : new URL(canonicalOverride ?? Astro.url.pathname, SITE.url).toString();
const alternatePaths = alternatePathsOverride === false
  ? false
  : alternatePathsOverride ?? alternatePathsForCurrentPath(Astro.url.pathname);
const alternateUrls = alternatePaths === false
  ? undefined
  : Object.fromEntries(
      LOCALES.map((alternateLocale) => [
        alternateLocale,
        new URL(alternatePaths[alternateLocale], SITE.url).toString(),
      ]),
    ) as Record<Locale, string>;
const socialImage = new URL(image, SITE.url).toString();
const socialTitle = socialTitleOverride ?? title.replace(/\s+\|\s+Four à Nu$/, "");
const socialImageType = image.endsWith(".webp")
  ? "image/webp"
  : image.endsWith(".jpg") || image.endsWith(".jpeg")
    ? "image/jpeg"
    : "image/png";
const allowIndexing = INDEXING_ENABLED && indexable;
const robots = allowIndexing
  ? "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
  : "noindex, follow";
const fixedRouteId = staticRouteIdFromPath(Astro.url.pathname);
const fixedRouteModifiedAt = fixedRouteId
  ? FIXED_INDEXABLE_ROUTES.find(
      (route) => route.path === staticRoute(fixedRouteId, "fr"),
    )?.modified
  : undefined;
const modifiedAt = modifiedAtOverride ?? fixedRouteModifiedAt;
const articleModifiedTime = modifiedAt
  ? new Date(modifiedAt).toISOString()
  : undefined;
const articlePublishedTime = publishedAt
  ? new Date(publishedAt).toISOString()
  : undefined;
const serializedSchema = schema
  ? JSON.stringify(schema).replaceAll("<", "\\u003c")
  : undefined;
const pageSchema = canonical
  ? {
      "@context": "https://schema.org",
      "@type": "WebPage",
      "@id": canonical,
      url: canonical,
      name: socialTitle,
      description,
      inLanguage: localeInfo.htmlLanguage,
      isPartOf: { "@id": `${SITE.url}/#website` },
      primaryImageOfPage: {
        "@type": "ImageObject",
        url: socialImage,
        contentUrl: socialImage,
        width: imageWidth,
        height: imageHeight,
        caption: imageAlt,
      },
      ...(articleModifiedTime ? { dateModified: articleModifiedTime } : {}),
      ...(articlePublishedTime ? { datePublished: articlePublishedTime } : {}),
    }
  : undefined;
const serializedPageSchema = pageSchema
  ? JSON.stringify(pageSchema).replaceAll("<", "\\u003c")
  : undefined;
---

<!doctype html>
<html lang={localeInfo.htmlLanguage} prefix="og: https://ogp.me/ns# article: https://ogp.me/ns/article#">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light" />
    <meta name="theme-color" content="#FFFFFF" />
    <meta name="robots" content={robots} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={authorName} />
    {canonical && <link rel="canonical" href={canonical} />}
    {alternateUrls && LOCALES.map((alternateLocale) => (
      <link
        rel="alternate"
        hreflang={LOCALE_INFO[alternateLocale].htmlLanguage}
        href={alternateUrls[alternateLocale]}
      />
    ))}
    {alternateUrls && <link rel="alternate" hreflang="x-default" href={alternateUrls.fr} />}
    <link rel="icon" href="/favicon-fouranu-v2.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-v2.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="image_src" href={socialImage} />
    <link rel="alternate" type="application/rss+xml" title="Four à Nu" href={feedPath(locale)} />
    <link rel="preload" href={sansRegularWoff2} as="font" type="font/woff2" crossorigin="anonymous" />
    <link rel="preload" href={condensedSemiboldWoff2} as="font" type="font/woff2" crossorigin="anonymous" />

    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content={localeInfo.openGraphLocale} />
    {LOCALES.filter((alternateLocale) => alternateLocale !== locale).map((alternateLocale) => (
      <meta property="og:locale:alternate" content={LOCALE_INFO[alternateLocale].openGraphLocale} />
    ))}
    <meta property="og:title" content={socialTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:secure_url" content={socialImage} />
    <meta property="og:image:type" content={socialImageType} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:image:alt" content={imageAlt} />
    {pageType === "article" && articleModifiedTime && (
      <meta property="article:modified_time" content={articleModifiedTime} />
    )}
    {pageType === "article" && articlePublishedTime && (
      <meta property="article:published_time" content={articlePublishedTime} />
    )}
    {pageType === "article" && (
      <meta property="article:author" content={authorUrl ?? new URL(localized.editorialAuthor.url, SITE.url).toString()} />
    )}
    {pageType === "article" && articleSection && (
      <meta property="article:section" content={articleSection} />
    )}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={socialTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content={imageAlt} />

    {serializedPageSchema && <script is:inline type="application/ld+json" set:html={serializedPageSchema} />}
    {serializedSchema && <script is:inline type="application/ld+json" set:html={serializedSchema} />}
  </head>
  <body>
    <a class="skip-link" href="#contenu">{shellCopy.skipLink}</a>
    <SiteHeader locale={locale} alternatePaths={alternatePaths || alternatePathsForCurrentPath(Astro.url.pathname)} />
    <main id="contenu">
      <slot />
      {canonical && <ShareActions locale={locale} title={socialTitle} description={description} url={canonical} />}
    </main>
    <SiteFooter locale={locale} alternatePaths={alternatePaths || alternatePathsForCurrentPath(Astro.url.pathname)} />
  </body>
</html>
