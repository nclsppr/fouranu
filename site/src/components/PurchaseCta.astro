---
import type { PurchaseLink } from "@/data/purchase-links";
import { amazonAffiliateUrlForObject } from "@/data/commercial-objects.mjs";
import {
  affiliateRel,
  isAmazonLink,
  toAmazonAffiliateUrl,
} from "@/lib/amazon-affiliate.mjs";
import type { Locale } from "@/i18n/config";

interface Props {
  locale?: Locale;
  links: PurchaseLink[];
  variant: "primary" | "closing";
}

const { locale = "fr", links, variant } = Astro.props;
const copy = {
  fr: {
    aria: "Liens d’achat", eyebrow: "Où l’acheter",
    compareAmazon: "Comparer les modèles sur Amazon.fr", seeAmazon: "Voir le modèle sur Amazon.fr",
    choice: "Votre choix est fait ?",
    amazonCopy: "Vous partez vers Amazon.fr. Vérifiez le vendeur, le prix, le modèle exact, les accessoires inclus et le stock avant de commander.",
    amazonDisclosure: "Liens affiliés Amazon. En tant que Partenaire Amazon, je réalise un bénéfice sur les achats remplissant les conditions requises.",
  },
  en: {
    aria: "Purchase links", eyebrow: "Where to buy",
    compareAmazon: "Compare the models on Amazon.fr", seeAmazon: "View the model on Amazon.fr",
    choice: "Made your choice?",
    amazonCopy: "You are leaving for Amazon.fr, the French marketplace. Check the seller, price, exact model, included accessories and stock before ordering.",
    amazonDisclosure: "Amazon affiliate links. As an Amazon Associate, I earn from qualifying purchases.",
  },
  de: {
    aria: "Kauflinks", eyebrow: "Wo kaufen",
    compareAmazon: "Modelle auf Amazon.fr vergleichen", seeAmazon: "Modell auf Amazon.fr ansehen",
    choice: "Steht Ihre Wahl fest?",
    amazonCopy: "Sie wechseln zu Amazon.fr, dem französischen Marktplatz. Prüfen Sie vor der Bestellung Verkäufer, Preis, genaues Modell, enthaltenes Zubehör und Bestand.",
    amazonDisclosure: "Amazon-Partnerlinks. Als Amazon-Partner verdiene ich an qualifizierten Verkäufen.",
  },
}[locale];
for (const link of links) {
  if (link.merchant !== "Amazon.fr" || !isAmazonLink(link.url)
    || link.url !== amazonAffiliateUrlForObject(link.objectId)) {
    throw new Error(`Destination affiliée non vérifiée : ${link.objectId}`);
  }
}
const titles = {
  primary: links.length > 1 ? copy.compareAmazon : copy.seeAmazon,
  closing: copy.choice,
};

const localizedObjectNames: Record<Exclude<Locale, "fr">, Record<string, string>> = {
  en: {
    "ooni-peel-perforated-30": "Ooni 30 cm perforated pizza peel",
    "ooni-peel-classic-30": "Ooni 30 cm classic pizza peel",
    "ooni-peel-bamboo-30": "Ooni 30 cm bamboo pizza peel",
    "weber-peel-6691": "Weber 6691 pizza peel",
    "dreamfarm-scizza": "Dreamfarm Scizza pizza scissors",
    "triangle-50491": "Triangle 50491 pizza scissors",
    "gefu-pezzo-12641": "GEFU Pezzo 12641 pizza scissors",
    "fackelmann-pizza-scissors-25": "Fackelmann 25 cm pizza scissors",
    "ooni-infrared-thermometer": "Ooni digital infrared thermometer",
    "bosch-universaltemp": "Bosch UniversalTemp thermometer",
    "thermopro-tp30": "ThermoPro TP30 infrared thermometer",
    "tilswall-w301": "Tilswall W301 infrared thermometer",
    "ziipa-minola": "ZiiPa Minola dough box",
    "gilac-dough-box-9l": "Gilac compact 9-litre dough box",
    "hendi-880975": "HENDI 880975 GN 1/1 dough box",
    "gilac-dough-box-15l": "Gilac professional 15-litre dough box",
  },
  de: {
    "ooni-peel-perforated-30": "perforierten Ooni-Pizzaschieber 30 cm",
    "ooni-peel-classic-30": "klassischen Ooni-Pizzaschieber 30 cm",
    "ooni-peel-bamboo-30": "Ooni-Bambus-Pizzaschieber 30 cm",
    "weber-peel-6691": "Weber-Pizzaschieber 6691",
    "dreamfarm-scizza": "Dreamfarm-Scizza-Pizzaschere",
    "triangle-50491": "Triangle-Pizzaschere 50491",
    "gefu-pezzo-12641": "GEFU-Pezzo-Pizzaschere 12641",
    "fackelmann-pizza-scissors-25": "Fackelmann-Pizzaschere 25 cm",
    "ooni-infrared-thermometer": "digitales Ooni-Infrarotthermometer",
    "bosch-universaltemp": "Bosch-UniversalTemp-Thermometer",
    "thermopro-tp30": "ThermoPro-TP30-Infrarotthermometer",
    "tilswall-w301": "Tilswall-W301-Infrarotthermometer",
    "ziipa-minola": "ZiiPa-Minola-Teigbox",
    "gilac-dough-box-9l": "kompakte Gilac-Teigbox mit 9 Litern",
    "hendi-880975": "HENDI-Teigbox 880975 GN 1/1",
    "gilac-dough-box-15l": "professionelle Gilac-Teigbox mit 15 Litern",
  },
};

function localizedLinkLabel(link: PurchaseLink): string {
  if (locale === "fr") return link.label;
  const product = localizedObjectNames[locale][link.objectId] ?? link.label
    .replace(/^Voir\s+(?:l[’']|le |la |les )?/, "")
    .replace(/\s+(?:chez|sur)\s+(?:Amazon\.fr|Gozney|Ooni)$/, "");
  if (locale === "en") return `View ${product} on Amazon.fr`;
  return `${product} auf Amazon.fr ansehen`;
}
---

{links.length > 0 && <section class:list={["purchase-cta", `purchase-cta--${variant}`]} aria-label={copy.aria}>
  <p class="purchase-cta__eyebrow">{copy.eyebrow}</p>
  <p class="purchase-cta__title">{titles[variant]}</p>
  <p class="purchase-cta__copy">
    {copy.amazonCopy}
  </p>
  <p class="purchase-cta__disclosure">{copy.amazonDisclosure}</p>
  <div class="purchase-cta__actions">
    {links.map((link) => (
      <a
        href={toAmazonAffiliateUrl(link.url)}
        rel={affiliateRel(link.url)}
        data-affiliate="amazon"
        data-commercial-object={link.objectId}
        data-purchase-placement={variant}
      >
        {localizedLinkLabel(link)}
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>}

<style>
  .purchase-cta {
    display: grid;
    gap: 0.85rem;
    max-width: var(--reading-width);
    padding: clamp(1rem, 2.2vw, 1.5rem);
    border: 2px solid var(--color-carbon);
  }

  .purchase-cta--primary {
    margin-block: 0 1.75rem;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .purchase-cta--closing {
    margin-block: 2rem 0;
    background: var(--color-steel-soft);
  }

  .purchase-cta__eyebrow,
  .purchase-cta__title,
  .purchase-cta__copy,
  .purchase-cta__disclosure {
    margin: 0;
  }

  .purchase-cta__eyebrow {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .purchase-cta--primary .purchase-cta__eyebrow {
    color: var(--color-reading);
  }

  .purchase-cta__title {
    font-family: var(--font-display);
    font-size: clamp(1.65rem, 3vw, 2.5rem);
    font-weight: 600;
    line-height: 1;
  }

  .purchase-cta__copy {
    max-width: 56ch;
    color: var(--color-graphite);
    font-size: 0.9rem;
    line-height: 1.55;
  }

  .purchase-cta--primary .purchase-cta__copy {
    color: var(--color-carbon-muted);
  }

  .purchase-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .purchase-cta__actions a {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.72rem 1rem;
    color: var(--color-white);
    background: var(--color-probe);
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
  }

  .purchase-cta__actions a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .purchase-cta__disclosure {
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.66rem;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .purchase-cta--primary .purchase-cta__disclosure {
    color: var(--color-carbon-muted);
  }

  @media (max-width: 48rem) {
    .purchase-cta__actions {
      display: grid;
    }

    .purchase-cta__actions a {
      width: 100%;
    }
  }
</style>
