  class="brand-mark"
  width={size}
  height={size}
  viewBox="0 0 256 256"
  aria-hidden={decorative ? "true" : undefined}
  role={decorative ? undefined : "img"}
  aria-label={decorative ? undefined : "Four à Nu"}
>
  <g fill="none" stroke="currentColor" stroke-width="20" stroke-linecap="square" stroke-linejoin="miter">
    <path d="M36 220V36H220V180"></path>
    <path d="M76 220V177C76 145.52 101.52 120 133 120C164.48 120 190 145.52 190 177V220"></path>
    <path d="M212 220H228"></path>
  </g>
</svg>
