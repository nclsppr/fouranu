---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import { staticAlternates, staticRoute, type Locale } from "@/i18n/config";
import { ABOUT_COPY } from "@/i18n/trust-pages";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = ABOUT_COPY[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={staticRoute("about", locale)}
  alternatePaths={staticAlternates("about")}
  indexable={true}
>
  <div class="page-shell">
    <Breadcrumbs locale={locale} items={[{ label: copy.home, href: staticRoute("home", locale) }, { label: copy.breadcrumb }]} />
    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="page-intro__lede">{copy.lead}</p>
      </div>
      <p class="page-intro__aside">{copy.aside}</p>
    </header>

    <section class="about-copy">
      <h2>{copy.whyHeading}</h2>
      <div>
        {copy.whyParagraphs.map((paragraph) => <p>{paragraph}</p>)}
        <a href={staticRoute("method", locale)}>{copy.methodLink} <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="about-values" aria-label={copy.valuesAria}>
      {copy.values.map((value, index) => (
        <article><span>{String(index + 1).padStart(2, "0")}</span><h2>{value.heading}</h2><p>{value.body}</p></article>
      ))}
    </section>

    <section class="about-links">
      <div><p class="eyebrow">{copy.whoEyebrow}</p><h2>{copy.whoHeading}</h2></div>
      <div>
        <p>{copy.whoBody}</p>
        <a href={staticRoute("authors", locale)}>{copy.authorsLink}</a>
        <a href={staticRoute("transparency", locale)}>{copy.transparencyLink}</a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .about-copy {
    display: grid;
    grid-template-columns: 5fr 6fr;
    gap: 2rem;
    padding-block: 4rem;
  }

  .about-copy h2 {
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 4.8rem);
    line-height: 0.96;
  }

  .about-copy > div {
    max-width: 44rem;
    color: var(--color-graphite);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .about-copy a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-probe);
    font-weight: 600;
  }

  .about-values {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--color-carbon);
  }

  .about-values article {
    padding: 1.5rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .about-values article:last-child {
    border-right: 0;
  }

  .about-values span {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.75rem;
  }

  .about-values h2 {
    margin: 2rem 0 0.75rem;
    font-size: 2.2rem;
    line-height: 1.02;
  }

  .about-values p,
  .about-links p {
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .about-links {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 4rem;
    padding: 2rem;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .about-links .eyebrow,
  .about-links a {
    color: var(--color-reading);
  }

  .about-links h2 {
    margin: 0;
    font-size: clamp(2.7rem, 5vw, 4.7rem);
    line-height: 0.95;
  }

  .about-links p {
    color: var(--color-carbon-muted);
  }

  .about-links a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    margin: 0.5rem 1.2rem 0 0;
  }

  @media (max-width: 64rem) {
    .about-values {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .about-values article:nth-child(2) {
      border-right: 0;
    }

    .about-values article:last-child {
      grid-column: 1 / -1;
      border-right: 0;
    }
  }

  @media (max-width: 48rem) {
    .about-copy,
    .about-values,
    .about-links {
      grid-template-columns: 1fr;
    }

    .about-copy {
      padding-block: 3rem;
    }

    .about-values article {
      border-right: 0;
    }

    .about-values article:last-child {
      grid-column: auto;
    }

    .about-values h2 {
      margin-top: 1.5rem;
    }

    .about-links {
      gap: 1.5rem;
      margin-top: 3rem;
      padding: 1.5rem;
    }
  }
</style>
