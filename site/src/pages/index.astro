---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import RelatedDecisions from "@/components/RelatedDecisions.astro";
import { SITE } from "@/config/site";
import {
  ARTICLE_BRANDS,
  isPublishedAnalysis,
} from "@/data/article-taxonomy";
import { localizedSite } from "@/i18n/common";
import {
  articleRoute,
  feedPath,
  LOCALE_INFO,
  staticAlternates,
  staticRoute,
  type ArticleId,
  type Locale,
} from "@/i18n/config";
import { HOME_COPY, HOME_FEATURED_ARTICLE_IDS } from "@/i18n/home";
import {
  assertMediaAllowedAtPath,
  assertResponsiveMediaAllowedAtPath,
} from "@/lib/media-rights.mjs";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = HOME_COPY[locale];
const localized = localizedSite(locale);
const homePath = staticRoute("home", locale);
const allAnalyses = (await getCollection("analyses")).filter((entry) => entry.data.locale === locale);
const analyses = allAnalyses
  .filter(isPublishedAnalysis)
  .sort((a, b) =>
    b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf() ||
    a.data.articleId.localeCompare(b.data.articleId)
  );
const lead = analyses.find((entry) => entry.data.articleId === HOME_FEATURED_ARTICLE_IDS.lead);
const energyGuide = analyses.find((entry) => entry.data.articleId === HOME_FEATURED_ARTICLE_IDS.energy);
const models = analyses.filter(
  (entry) =>
    entry.data.brand === "ooni" &&
    entry.data.category === "oven" &&
    entry.data.type === "model",
);
const newDossiers = HOME_FEATURED_ARTICLE_IDS.newDossiers
  .map((articleId) => analyses.find((entry) => entry.data.articleId === articleId))
  .filter((entry) => entry !== undefined);
const accessoryGuides = HOME_FEATURED_ARTICLE_IDS.accessories
  .map((articleId) => {
    const entry = analyses.find((candidate) => candidate.data.articleId === articleId);
    return entry ? { entry, label: copy.accessories.labels[articleId] } : undefined;
  })
  .filter((guide) => guide !== undefined);
const featuredModels = HOME_FEATURED_ARTICLE_IDS.models
  .map((articleId) => models.find((entry) => entry.data.articleId === articleId))
  .filter((entry) => entry !== undefined);
const remainingModels = models.filter(
  (entry) => !HOME_FEATURED_ARTICLE_IDS.models.includes(entry.data.articleId as typeof HOME_FEATURED_ARTICLE_IDS.models[number]),
);
const citedEvidenceCount = new Set(
  analyses.flatMap((entry) => entry.data.evidenceIds),
).size;
const latestUpdate = new Date(
  Math.max(...analyses.map((entry) => entry.data.updatedAt.valueOf())),
);
const shortDateFormatter = new Intl.DateTimeFormat(LOCALE_INFO[locale].intlLocale, {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
  timeZone: "UTC",
});
const longDateFormatter = new Intl.DateTimeFormat(LOCALE_INFO[locale].intlLocale, {
  day: "numeric",
  month: "long",
  year: "numeric",
  timeZone: "UTC",
});

if (
  !lead ||
  !energyGuide ||
  featuredModels.length !== HOME_FEATURED_ARTICLE_IDS.models.length ||
  newDossiers.length !== HOME_FEATURED_ARTICLE_IDS.newDossiers.length ||
  accessoryGuides.length !== HOME_FEATURED_ARTICLE_IDS.accessories.length
) {
  throw new Error(copy.requiredError);
}
const illustratedEntries = [lead, ...accessoryGuides.map(({ entry }) => entry), ...newDossiers, ...models];
for (const entry of illustratedEntries) {
  if (!entry.data.image) throw new Error(`${copy.requiredError} ${entry.data.articleId}: image`);
  assertResponsiveMediaAllowedAtPath(entry.data.image.src, locale, "hub-list", homePath);
}
assertMediaAllowedAtPath("/brand/logo-fouranu.png", locale, "schema-image", homePath);

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      alternateName: SITE.alternateName,
      inLanguage: ["fr-FR", "en", "de-DE"],
      description: localized.description,
      publisher: { "@id": `${SITE.url}/#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${SITE.url}/#organization`,
      name: SITE.name,
      alternateName: SITE.alternateName,
      url: `${SITE.url}/`,
      description: copy.organizationDescription,
      publishingPrinciples: new URL(staticRoute("method", "fr"), SITE.url).toString(),
      logo: {
        "@type": "ImageObject",
        url: `${SITE.url}/brand/logo-fouranu.png`,
        contentUrl: `${SITE.url}/brand/logo-fouranu.png`,
        width: 480,
        height: 172,
      },
    },
  ],
};
---

<BaseLayout
  title={localized.title}
  socialTitle={copy.socialTitle}
  description={localized.description}
  canonical={homePath}
  alternatePaths={staticAlternates("home")}
  indexable={true}
  schema={schema}
>
  <section class="editorial-hero page-shell" aria-labelledby="home-title">
    <article class="lead-feature">
      <div class="lead-feature__copy">
        <h1 id="home-title">{copy.hero.title}</h1>
        <p class="lead-feature__mission">
          {copy.hero.mission}
        </p>
        <h2 class="lead-feature__story-title">{lead.data.title}</h2>
        <p class="lead-feature__summary">{lead.data.summary}</p>
        <div class="lead-feature__filters" aria-label={copy.hero.criteriaAria}>
          {copy.hero.criteria.map((criterion) => <span>{criterion}</span>)}
        </div>
        <a class="feature-action" href={`${staticRoute("ovens", locale)}#trouver-mon-four`}>
          {copy.hero.action}
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <figure class="lead-feature__visual lead-feature__visual--documentary">
        <div class="lead-feature__visual-frame">
          <img
            src={lead.data.image!.src}
            srcset={`${lead.data.image!.src.replace("-1600.webp", "-960.webp")} 960w, ${lead.data.image!.src} 1600w`}
            sizes="(max-width: 40rem) 100vw, 42vw"
            alt={lead.data.image!.alt}
            width="1600"
            height="900"
            fetchpriority="high"
          />
        </div>
        <figcaption>{lead.data.image!.caption}</figcaption>
      </figure>
    </article>

    <div class="hero-side">
      <a class="side-story" href={articleRoute(energyGuide.data.articleId as ArticleId, locale)}>
        <span class="side-story__meta">{copy.sideStories.energyMeta}</span>
        <h2>{energyGuide.data.title}</h2>
        <p>{energyGuide.data.summary}</p>
        <span class="side-story__link">{copy.sideStories.energyAction} <span aria-hidden="true">→</span></span>
      </a>

      <a class="side-story side-story--dark" href={staticRoute("ovens", locale)}>
        <span class="side-story__meta">{copy.sideStories.choiceMeta}</span>
        <h2>{copy.sideStories.choiceTitle}</h2>
        <p>{copy.sideStories.choiceSummary}</p>
        <span class="side-story__link">{copy.sideStories.choiceAction} <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>

  <div class="page-shell"><RelatedDecisions locale={locale} /></div>

  <section class="corpus-strip page-shell" aria-label={copy.corpus.aria}>
    <div>
      <strong>{analyses.length}</strong>
      <span>{copy.corpus.guides}</span>
    </div>
    <div>
      <strong>{citedEvidenceCount}</strong>
      <span>{copy.corpus.evidence}</span>
    </div>
    <div>
      <strong>{copy.corpus.noRating}</strong>
      <span>{copy.corpus.usageFirst}</span>
    </div>
    <div>
      <strong>{longDateFormatter.format(latestUpdate)}</strong>
      <span>{copy.corpus.lastUpdate}</span>
    </div>
  </section>

  <section class="accessories-doorway" aria-labelledby="accessories-doorway-title">
    <div class="accessories-doorway__grid page-shell">
      <header class="accessories-doorway__intro">
        <p class="feature-kicker">{copy.accessories.kicker}</p>
        <h2 id="accessories-doorway-title">{copy.accessories.title}</h2>
        <p>
          {copy.accessories.summary}
        </p>
        <a class="feature-action" href={staticRoute("accessories", locale)}>
          {copy.accessories.action}
          <span aria-hidden="true">→</span>
        </a>
      </header>

      <nav class="accessories-doorway__list" aria-label={copy.accessories.navAria}>
        {accessoryGuides.map(({ entry, label }, index) => (
          <a href={articleRoute(entry.data.articleId as ArticleId, locale)}>
            <span class="accessories-doorway__media">
              <img
                src={entry.data.image!.src}
                srcset={`${entry.data.image!.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image!.src} 1600w`}
                sizes="(max-width: 40rem) 7rem, (max-width: 56rem) 9rem, 10rem"
                alt=""
                width="960"
                height="540"
                loading="lazy"
              />
            </span>
            <span class="accessories-doorway__copy">
              <small>{String(index + 1).padStart(2, "0")} · {copy.accessories.guideType}</small>
              <strong>{label}</strong>
              <span>{entry.data.summary}</span>
              <b>{copy.common.by} {localized.authors[entry.data.author].name}</b>
            </span>
            <span class="accessories-doorway__arrow" aria-hidden="true">→</span>
          </a>
        ))}
      </nav>
    </div>
  </section>

  {newDossiers.length > 0 && (
    <section class="new-dossiers page-shell" aria-labelledby="new-dossiers-title">
      <header>
        <p class="feature-kicker">{copy.newDossiers.kicker}</p>
        <h2 id="new-dossiers-title">{copy.newDossiers.title}</h2>
        <p>
          {copy.newDossiers.summary}
        </p>
      </header>

      <div class="new-dossiers__list">
        {newDossiers.map((entry) => (
          <a href={articleRoute(entry.data.articleId as ArticleId, locale)}>
            <span class="new-dossiers__media">
              <img
                src={entry.data.image!.src}
                srcset={`${entry.data.image!.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image!.src} 1600w`}
                sizes="(max-width: 48rem) 100vw, 11rem"
                alt={entry.data.image!.alt}
                width="960"
                height="540"
                loading="lazy"
              />
            </span>
            <span class="new-dossiers__copy">
              <small>{ARTICLE_BRANDS[entry.data.brand].label} · {copy.categoryLabels[entry.data.category]}</small>
              <strong>{entry.data.title}</strong>
              <span>{entry.data.summary}</span>
              <b>{copy.common.by} {localized.authors[entry.data.author].name} · {copy.newDossiers.read} →</b>
            </span>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="featured-dossiers page-shell" aria-labelledby="featured-title">
    <header class="section-bar">
      <h2 id="featured-title">{copy.featured.title}</h2>
      <a href={staticRoute("ooni", locale)}>{copy.featured.seeAll} <span aria-hidden="true">→</span></a>
    </header>

    <div class="dossier-grid">
      {featuredModels.map((entry, index) => (
        <a class="dossier-card" href={articleRoute(entry.data.articleId as ArticleId, locale)}>
          <span class="dossier-card__media">
            <img
              src={entry.data.image!.src}
              srcset={`${entry.data.image!.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image!.src} 1600w`}
              sizes="(max-width: 32rem) 100vw, (max-width: 56rem) 50vw, 25vw"
              alt={entry.data.image!.alt}
              width="960"
              height="540"
              loading="lazy"
            />
            <span class="dossier-card__index">{String(index + 1).padStart(2, "0")}</span>
          </span>
          <span class="dossier-card__content">
            <span class="dossier-card__type">{copy.featured.cardType}</span>
            <h3>{entry.data.title}</h3>
            <span class="dossier-card__summary">{entry.data.summary}</span>
            <span class="dossier-card__meta">
              <span>{copy.common.by} {localized.authors[entry.data.author].name}</span>
              <span>{shortDateFormatter.format(entry.data.updatedAt)}</span>
            </span>
            <span class="dossier-card__link">{copy.featured.read} <span aria-hidden="true">→</span></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <section class="choice-guide">
    <div class="page-shell choice-guide__grid">
      <div class="choice-guide__intro">
        <p class="feature-kicker">{copy.choice.kicker}</p>
        <h2>{copy.choice.title}</h2>
        <p>
          {copy.choice.summary}
        </p>
        <a href={staticRoute("ovens", locale)}>{copy.choice.action} <span aria-hidden="true">→</span></a>
      </div>

      <nav aria-label={copy.choice.navAria}>
        {copy.choice.criteria.map((criterion, index) => (
          <a href={`${staticRoute("ovens", locale)}#${criterion.hash}`}>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <strong>{criterion.title}</strong>
            <small>{criterion.detail}</small>
            <b aria-hidden="true">→</b>
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="reading-desk page-shell" aria-labelledby="reading-title">
    <div class="reading-desk__list">
      <header class="section-bar">
        <h2 id="reading-title">{copy.reading.title}</h2>
        <a href={staticRoute("ooni", locale)}>{copy.reading.all} <span aria-hidden="true">→</span></a>
      </header>

      <div class="compact-list">
        {remainingModels.map((entry) => (
          <a href={articleRoute(entry.data.articleId as ArticleId, locale)}>
            <span class="compact-list__media">
              <img
                src={entry.data.image!.src}
                srcset={`${entry.data.image!.src.replace("-1600.webp", "-960.webp")} 960w, ${entry.data.image!.src} 1600w`}
                sizes="7.5rem"
                alt=""
                width="320"
                height="180"
                loading="lazy"
              />
            </span>
            <span class="compact-list__copy">
              <strong>{entry.data.title}</strong>
              <small>{entry.data.summary}</small>
              <small class="compact-list__byline">
                {copy.common.by} {localized.authors[entry.data.author].name} · {shortDateFormatter.format(entry.data.updatedAt)}
              </small>
            </span>
            <span aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </div>

    <aside class="rss-panel">
      <p class="feature-kicker">{copy.rss.kicker}</p>
      <h2>{copy.rss.title}</h2>
      <p>
        {copy.rss.summary}
      </p>
      <a class="feature-action" href={feedPath(locale)}>
        {copy.rss.action}
        <span aria-hidden="true">↗</span>
      </a>
      <small>{copy.rss.note}</small>
    </aside>
  </section>

  <section class="method-strip page-shell" aria-labelledby="method-title">
    <header class="section-bar">
      <div>
        <p class="feature-kicker">{copy.method.kicker}</p>
        <h2 id="method-title">{copy.method.title}</h2>
      </div>
      <a href={staticRoute("method", locale)}>{copy.method.action} <span aria-hidden="true">→</span></a>
    </header>

    <div class="method-grid">
      {copy.method.steps.map((step, index) => (
        <div>
          <span class="method-step">{String(index + 1).padStart(2, "0")}</span>
          <h3>{step.title}</h3>
          <p>{step.summary}</p>
        </div>
      ))}
    </div>

    <nav class="trust-links" aria-label={copy.method.trustAria}>
      <a href={staticRoute("authors", locale)}>{copy.method.editorialTeam}</a>
      <a href={staticRoute("method", locale)}>{copy.method.method}</a>
      <a href={staticRoute("transparency", locale)}>{copy.method.transparency}</a>
      <a href={staticRoute("corrections", locale)}>{copy.method.corrections}</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .feature-kicker,
  .side-story__meta,
  .dossier-card__type,
  .dossier-card__date {
    font-family: var(--font-data);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .editorial-hero {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(18rem, 4fr);
    gap: 0.75rem;
    padding-block: 1.5rem 2rem;
  }

  .lead-feature {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    min-height: 30rem;
    overflow: hidden;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .lead-feature__copy {
    display: flex;
    position: relative;
    z-index: 1;
    flex-direction: column;
    align-items: flex-start;
    padding: clamp(1.75rem, 3vw, 2.75rem);
  }

  .lead-feature .feature-kicker,
  .choice-guide .feature-kicker,
  .rss-panel .feature-kicker {
    color: var(--color-reading);
  }

  .lead-feature h1 {
    max-width: 10ch;
    margin: auto 0 0.8rem;
    font-size: clamp(3.15rem, 4.8vw, 4.9rem);
    line-height: 0.91;
    letter-spacing: -0.04em;
  }

  .lead-feature__story-title {
    max-width: 28ch;
    margin: 0 0 0.8rem;
    color: var(--color-white);
    font-size: clamp(1.35rem, 2.1vw, 1.8rem);
    line-height: 1.05;
  }

  .lead-feature__mission {
    max-width: 38rem;
    margin: 0 0 1.25rem;
    color: var(--color-carbon-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .lead-feature__summary {
    max-width: 38rem;
    color: var(--color-carbon-muted);
    font-size: 1rem;
    line-height: 1.55;
  }

  .lead-feature__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.5rem;
  }

  .lead-feature__filters span {
    min-height: 2rem;
    padding: 0.42rem 0.58rem;
    border: 1px solid var(--color-carbon-line);
    font-family: var(--font-data);
    font-size: 0.75rem;
    text-transform: uppercase;
  }

  .feature-action {
    display: inline-flex;
    min-height: 3rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1.5rem;
    padding: 0.75rem 1rem;
    color: var(--color-white);
    background: var(--color-probe);
    font-weight: 600;
    text-decoration: none;
    transition: color 160ms ease-out, background 160ms ease-out, transform 160ms ease-out;
  }

  .feature-action:hover {
    color: var(--color-carbon);
    background: var(--color-white);
    transform: translateY(-2px);
  }

  .lead-feature__visual {
    display: flex;
    min-width: 0;
    flex-direction: column;
    justify-content: flex-end;
    margin: 0;
    padding: 1.5rem 1.5rem 1rem 0;
  }

  .lead-feature__visual img {
    width: 100%;
    height: auto;
    filter: invert(1) grayscale(1) contrast(1.15);
    mix-blend-mode: screen;
  }

  .lead-feature__visual--documentary {
    padding: 0;
  }

  .lead-feature__visual-frame {
    flex: 1;
    min-height: 30rem;
    overflow: hidden;
  }

  .lead-feature__visual-frame img {
    width: 100%;
    height: 100%;
    min-height: 30rem;
    object-fit: cover;
    filter: none;
    mix-blend-mode: normal;
  }

  .lead-feature__visual--documentary figcaption {
    padding: 0.5rem 0.75rem;
    border: 0;
    background: var(--color-carbon);
  }

  .lead-feature__visual figcaption {
    padding-top: 0.75rem;
    border-top: 1px solid var(--color-carbon-line);
    color: var(--color-carbon-muted);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.45;
  }

  .hero-side {
    display: grid;
    gap: 0.75rem;
  }

  .side-story {
    display: flex;
    min-height: 0;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border: 1px solid var(--color-line);
    background: var(--color-steel-soft);
    text-decoration: none;
    transition: border-color 160ms ease-out, transform 160ms ease-out;
  }

  .side-story:hover {
    border-color: var(--color-probe);
    transform: translateY(-2px);
  }

  .side-story__meta {
    color: var(--color-probe);
  }

  .side-story h2 {
    max-width: 13ch;
    margin: auto 0 0.75rem;
    font-size: clamp(2rem, 3vw, 3rem);
    line-height: 0.96;
  }

  .side-story p {
    color: var(--color-graphite);
    font-size: 0.88rem;
    line-height: 1.55;
  }

  .side-story__link {
    margin-top: auto;
    color: var(--color-probe);
    font-weight: 600;
  }

  .side-story--dark {
    color: var(--color-white);
    border-color: var(--color-carbon);
    background: var(--color-carbon);
  }

  .side-story--dark .side-story__meta,
  .side-story--dark .side-story__link {
    color: var(--color-reading);
  }

  .side-story--dark p {
    color: var(--color-carbon-muted);
  }

  .corpus-strip {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    padding-block: 1.1rem;
    border-block: 1px solid var(--color-line);
  }

  .corpus-strip > div {
    padding-inline: 1.25rem;
    border-right: 1px solid var(--color-line);
  }

  .corpus-strip > div:first-child {
    padding-left: 0;
  }

  .corpus-strip > div:last-child {
    padding-right: 0;
    border-right: 0;
  }

  .corpus-strip strong,
  .corpus-strip span {
    display: block;
  }

  .corpus-strip strong {
    margin-bottom: 0.3rem;
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 2.5vw, 2.25rem);
    line-height: 1;
  }

  .corpus-strip span {
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.75rem;
    line-height: 1.45;
    text-transform: uppercase;
  }

  .featured-dossiers,
  .new-dossiers,
  .reading-desk,
  .method-strip {
    padding-block: clamp(2.5rem, 3.5vw, 3rem);
  }

  .accessories-doorway {
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .accessories-doorway__grid {
    display: grid;
    grid-template-columns: minmax(15rem, 4fr) minmax(0, 8fr);
    gap: clamp(2rem, 4vw, 4rem);
    padding-block: clamp(2.5rem, 4vw, 4rem);
  }

  .accessories-doorway .feature-kicker {
    color: var(--color-reading);
  }

  .accessories-doorway__intro {
    align-self: center;
  }

  .accessories-doorway__intro h2 {
    max-width: 10ch;
    margin: 1.5rem 0 1rem;
