---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import ProofLabel from "@/components/ProofLabel.astro";
import { staticAlternates, staticRoute, type Locale } from "@/i18n/config";
import { METHOD_COPY } from "@/i18n/trust-pages";

interface Props {
  locale?: Locale;
}

const { locale = "fr" } = Astro.props;
const copy = METHOD_COPY[locale];
---

<BaseLayout
  title={copy.title}
  description={copy.description}
  canonical={staticRoute("method", locale)}
  alternatePaths={staticAlternates("method")}
  indexable={true}
>
  <div class="page-shell">
    <Breadcrumbs locale={locale} items={[{ label: copy.home, href: staticRoute("home", locale) }, { label: copy.breadcrumb }]} />

    <header class="page-intro">
      <div class="page-intro__copy">
        <p class="eyebrow">{copy.eyebrow}</p>
        <h1>{copy.heading}</h1>
        <p class="page-intro__lede">{copy.lead}</p>
      </div>
      <p class="page-intro__aside">{copy.aside}</p>
    </header>

    <section class="method-grid" aria-labelledby="levels-title">
      <header>
        <p class="eyebrow">{copy.levelsEyebrow}</p>
        <h2 id="levels-title">{copy.levelsHeading}</h2>
      </header>

      <div class="method-grid__levels">
        {copy.levels.map((level) => (
          <article>
            <ProofLabel code={level.code} locale={locale} />
            <h3>{level.heading}</h3>
            <p>{level.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="principles" aria-label={copy.principlesAria}>
      {copy.principles.map((principle, index) => (
        <article>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h2>{principle.heading}</h2>
          <p>{principle.body}</p>
        </article>
      ))}
    </section>

    <section class="correction-link">
      <div>
        <p class="eyebrow">{copy.correctionEyebrow}</p>
        <h2>{copy.correctionHeading}</h2>
      </div>
      <div>
        <p>{copy.correctionBody}</p>
        <a href={staticRoute("corrections", locale)}>{copy.correctionLink} <span aria-hidden="true">→</span></a>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  .method-grid {
    display: grid;
    grid-template-columns: 4fr 8fr;
    gap: 1.5rem;
    padding-block: 3rem;
    border-bottom: 1px solid var(--color-line);
  }

  .method-grid header h2 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(2.8rem, 5vw, 4.5rem);
    line-height: 0.98;
  }

  .method-grid__levels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-top: 1px solid var(--color-carbon);
  }

  .method-grid__levels article {
    padding: 1.25rem;
    border-right: 1px solid var(--color-line);
    border-bottom: 1px solid var(--color-line);
  }

  .method-grid__levels article:nth-child(even) {
    border-right: 0;
  }

  .method-grid__levels article:last-child {
    grid-column: 1 / -1;
  }

  .method-grid__levels h3 {
    margin: 1rem 0 0.5rem;
    font-size: 1.65rem;
  }

  .method-grid__levels p {
    margin: 0;
    color: var(--color-graphite);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .principles {
    padding-block: 3rem;
  }

  .principles article {
    display: grid;
    grid-template-columns: 3rem minmax(18rem, 5fr) minmax(14rem, 3fr);
    gap: 1.5rem;
    padding-block: 1rem;
    border-top: 1px solid var(--color-line);
  }

  .principles article:last-child {
    border-bottom: 1px solid var(--color-line);
  }

  .principles span {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.75rem;
  }

  .principles h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.7rem);
    line-height: 1.04;
  }

  .principles p {
    margin: 0;
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .principles code {
    font-family: var(--font-data);
    font-size: 0.86em;
  }

  .correction-link {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    padding: 2rem;
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .correction-link .eyebrow {
    color: var(--color-reading);
  }

  .correction-link h2 {
    margin: 0;
    font-size: clamp(2.7rem, 5vw, 4.5rem);
    line-height: 0.95;
  }

  .correction-link > div:last-child {
    align-self: end;
  }

  .correction-link > div:last-child p {
    color: var(--color-carbon-muted);
    line-height: 1.65;
  }

  .correction-link a {
    display: inline-flex;
    min-height: 2.75rem;
    align-items: center;
    color: var(--color-reading);
  }

  @media (max-width: 48rem) {
    .method-grid,
    .method-grid__levels,
    .principles article,
    .correction-link {
      grid-template-columns: 1fr;
    }

    .method-grid {
      gap: 2rem;
      padding-block: 3rem;
    }

    .method-grid__levels article,
    .method-grid__levels article:nth-child(even) {
      border-right: 0;
    }

    .method-grid__levels article:last-child {
      grid-column: auto;
    }

    .principles article {
      gap: 0.8rem;
    }

    .principles {
      padding-block: 3rem;
    }

    .correction-link {
      gap: 1.5rem;
      padding: 1.5rem;
    }
  }
</style>
