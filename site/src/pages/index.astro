---
import { getCollection } from "astro:content";
import BaseLayout from "@/layouts/BaseLayout.astro";
import ProofLabel from "@/components/ProofLabel.astro";
import { SITE } from "@/config/site";

const analyses = (await getCollection("analyses"))
  .filter((entry) => entry.data.status === "publishable")
  .sort((a, b) => b.data.updatedAt.valueOf() - a.data.updatedAt.valueOf());
const lead = analyses.find((entry) => entry.id === "quel-four-ooni-choisir");
const energyGuide = analyses.find((entry) => entry.id === "gaz-electrique-ou-multicombustible");
const models = analyses.filter((entry) => entry.data.type === "model");
const modelDateFormatter = new Intl.DateTimeFormat("fr-FR", {
  day: "2-digit",
  month: "2-digit",
  year: "numeric",
  timeZone: "UTC",
});

if (!lead || !energyGuide) throw new Error("Les deux guides Ooni principaux sont requis.");

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: `${SITE.url}/`,
      name: SITE.name,
      alternateName: SITE.alternateName,
      inLanguage: SITE.language,
      description: SITE.description,
      publisher: { "@id": `${SITE.url}/#organization` },
    },
    {
      "@type": "Organization",
      "@id": `${SITE.url}/#organization`,
      name: SITE.name,
      alternateName: SITE.alternateName,
      url: `${SITE.url}/`,
      description:
        "Média francophone indépendant consacré aux fours à pizza, à leurs usages et à leur équipement.",
      publishingPrinciples: `${SITE.url}/methode/`,
    },
  ],
};
---

<BaseLayout indexable={true} schema={schema}>
  <section class="hero page-shell">
    <div class="hero__copy">
      <p class="eyebrow">Guide indépendant des fours à pizza</p>
      <h1>Choisir un four à pizza, <span>sans cuire les sources.</span></h1>
      <p class="hero__lede">
        Four à Nu confronte les fiches fabricant, les mesures publiées et les
        retours d'usage pour répondre aux vraies questions d'achat. Chaque
        affirmation importante garde son auteur, sa date et ses limites.
      </p>
      <div class="hero__actions">
        <a class="button-link" href="/ooni/quel-four-ooni-choisir/">Choisir un Ooni</a>
        <a class="button-link button-link--quiet" href="/fours-a-pizza/">Partir de mon usage</a>
      </div>
    </div>

    <figure class="hero-visual">
      <picture>
        <source
          srcset="/media/homepage-atelier-sketch-768.webp 768w, /media/homepage-atelier-sketch-1536.webp 1536w"
          sizes="(max-width: 768px) 100vw, 52vw"
          type="image/webp"
        />
        <img
          src="/media/homepage-atelier-sketch-1536.webp"
          alt="Croquis architectural d'un four à pizza contemporain posé sur une table métallique"
          width="1536"
          height="1024"
          fetchpriority="high"
        />
      </picture>
      <figcaption>
        Illustration originale assistée par IA, direction Four à Nu. Elle
        installe l'univers visuel et ne constitue pas une preuve produit.
      </figcaption>
    </figure>
  </section>

  <section class="front-page page-shell" aria-labelledby="front-page-title">
    <header class="section-heading">
      <div>
        <p class="eyebrow">À la une</p>
        <h2 id="front-page-title">Les deux décisions qui réduisent vraiment la gamme.</h2>
      </div>
      <p>Commencez par le lieu et l'énergie. Le diamètre, le poids et le débit viennent ensuite.</p>
    </header>

    <div class="front-page__grid">
      <a class="lead-story" href={`/ooni/${lead.id}/`}>
        <span class="story-kicker">Guide d'achat · Ooni</span>
        <h3>{lead.data.title}</h3>
        <p>{lead.data.summary}</p>
        <span class="story-link">Lire le guide <span aria-hidden="true">→</span></span>
      </a>

      <a class="secondary-story" href={`/ooni/${energyGuide.id}/`}>
        <span class="story-kicker">Comparatif par usage</span>
        <h3>{energyGuide.data.title}</h3>
        <p>{energyGuide.data.summary}</p>
        <span class="story-link">Comparer les énergies <span aria-hidden="true">→</span></span>
      </a>

      <aside class="front-page__method">
        <p class="eyebrow">Notre différence</p>
        <h3>La source reste visible jusqu'à la conclusion.</h3>
        <p>Les protocoles incompatibles ne sont pas moyennés. Les prêts, affiliations et collaborations connus restent attachés à chaque observation.</p>
        <a href="/methode/">Lire la méthode éditoriale</a>
      </aside>
    </div>
  </section>

  <section class="model-desk page-shell" aria-labelledby="model-desk-title">
    <header class="section-heading section-heading--compact">
      <div>
        <p class="eyebrow">Dossiers Ooni</p>
        <h2 id="model-desk-title">Neuf modèles, neuf contraintes distinctes.</h2>
      </div>
      <a href="/ooni/">Voir toute la gamme Ooni</a>
    </header>

    <div class="model-list">
      {models.map((entry, index) => (
        <a href={`/ooni/${entry.id}/`}>
          <span class="model-list__index">{String(index + 1).padStart(2, "0")}</span>
          <span>
            <strong>{entry.data.title}</strong>
            <small>{entry.data.summary}</small>
          </span>
          <span class="model-list__meta">Mis à jour le {modelDateFormatter.format(entry.data.updatedAt)}</span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="choice-map">
    <div class="page-shell choice-map__grid">
      <div>
        <p class="eyebrow">Choisir par contrainte</p>
        <h2>Le bon point de départ n'est pas toujours une marque.</h2>
      </div>
      <nav aria-label="Choisir un four à pizza par contrainte">
        <a href="/fours-a-pizza/#lieu"><span>01</span><strong>Lieu</strong><small>Intérieur, balcon, terrasse ou jardin</small></a>
        <a href="/fours-a-pizza/#energie"><span>02</span><strong>Énergie</strong><small>Électrique, gaz, bois ou charbon</small></a>
        <a href="/fours-a-pizza/#debit"><span>03</span><strong>Débit</strong><small>Une pizza ou une série pour les invités</small></a>
        <a href="/fours-a-pizza/#cout"><span>04</span><strong>Coût complet</strong><small>Four, table, pelle, énergie et entretien</small></a>
      </nav>
    </div>
  </section>

  <section class="trust-strip page-shell" aria-labelledby="trust-title">
    <div>
      <p class="eyebrow">Pourquoi faire confiance à Four à Nu</p>
      <h2 id="trust-title">Une méthode conçue pour être vérifiée.</h2>
    </div>
    <div class="trust-strip__proofs">
      <div><ProofLabel code="FAB" /><p>Une annonce reste attribuée au fabricant.</p></div>
      <div><ProofLabel code="T-MES" /><p>Une mesure tierce conserve ses conditions et son timecode.</p></div>
      <div><ProofLabel code="T-OBS" /><p>Une observation reste limitée à la session publiée.</p></div>
      <div><ProofLabel code="FAN-INF" /><p>Une inférence éditoriale expose ses prémisses et son incertitude.</p></div>
    </div>
    <nav aria-label="Pages de confiance">
      <a href="/auteurs/redaction-four-a-nu/">La rédaction</a>
      <a href="/methode/">La méthode</a>
      <a href="/transparence/">La transparence commerciale</a>
      <a href="/corrections/">Les corrections</a>
    </nav>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 1.5rem;
    align-items: center;
    padding-block: clamp(3.5rem, 7vw, 7rem) clamp(2rem, 5vw, 4rem);
  }

  .hero__copy {
    grid-column: 1 / span 6;
    position: relative;
    z-index: 1;
  }

  .hero h1 {
    max-width: 10ch;
    margin-bottom: 1.6rem;
    font-size: clamp(4rem, 7.6vw, 7rem);
    line-height: 0.89;
    letter-spacing: -0.045em;
  }

  .hero h1 span {
    color: var(--color-probe);
  }

  .hero__lede {
    max-width: 42rem;
    color: var(--color-graphite);
    font-size: clamp(1.08rem, 1.8vw, 1.28rem);
    line-height: 1.62;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }

  .hero-visual {
    grid-column: 7 / -1;
    margin: 0;
    min-width: 0;
  }

  .hero-visual img {
    width: 100%;
    height: auto;
  }

  .hero-visual figcaption {
    max-width: 38rem;
    margin-top: 0.75rem;
    padding-top: 0.65rem;
    border-top: 1px solid var(--color-line);
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.64rem;
    line-height: 1.55;
    text-transform: uppercase;
  }

  .front-page,
  .model-desk,
  .trust-strip {
    padding-block: clamp(4.5rem, 9vw, 8rem);
    border-top: 1px solid var(--color-carbon);
  }

  .section-heading {
    display: grid;
    grid-template-columns: 7fr 4fr;
    gap: 3rem;
    align-items: end;
    margin-bottom: 3rem;
  }

  .section-heading h2 {
    max-width: 15ch;
    margin: 0;
    font-size: clamp(3rem, 5.5vw, 5.4rem);
    line-height: 0.96;
  }

  .section-heading > p,
  .section-heading > a {
    max-width: 34rem;
    margin: 0;
    color: var(--color-graphite);
    line-height: 1.65;
  }

  .section-heading > a {
    color: var(--color-probe);
    font-weight: 600;
  }

  .front-page__grid {
    display: grid;
    grid-template-columns: 6fr 3fr 3fr;
    border-top: 1px solid var(--color-line);
  }

  .lead-story,
  .secondary-story,
  .front-page__method {
    display: flex;
    min-height: 26rem;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.5rem);
    border-right: 1px solid var(--color-line);
    text-decoration: none;
  }

  .front-page__method {
    border-right: 0;
  }

  .story-kicker {
    color: var(--color-probe);
    font-family: var(--font-data);
    font-size: 0.68rem;
    text-transform: uppercase;
  }

  .lead-story h3,
  .secondary-story h3,
  .front-page__method h3 {
    margin: auto 0 1rem;
    font-size: clamp(2rem, 3.4vw, 3.8rem);
    line-height: 0.98;
  }

  .secondary-story h3,
  .front-page__method h3 {
    font-size: clamp(1.7rem, 2.4vw, 2.5rem);
  }

  .lead-story p,
  .secondary-story p,
  .front-page__method p {
    color: var(--color-graphite);
    line-height: 1.6;
  }

  .story-link,
  .front-page__method a {
    color: var(--color-probe);
    font-weight: 600;
  }

  .lead-story:hover h3,
  .secondary-story:hover h3 {
    color: var(--color-probe);
  }

  .section-heading--compact h2 {
    max-width: 17ch;
  }

  .model-list {
    border-top: 1px solid var(--color-line);
  }

  .model-list a {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 12rem auto;
    gap: 1rem;
    align-items: center;
    min-height: 7.4rem;
    border-bottom: 1px solid var(--color-line);
    text-decoration: none;
  }

  .model-list__index,
  .model-list__meta {
    color: var(--color-graphite);
    font-family: var(--font-data);
    font-size: 0.66rem;
    text-transform: uppercase;
  }

  .model-list strong {
    display: block;
    margin-bottom: 0.35rem;
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    line-height: 1;
  }

  .model-list small {
    display: block;
    max-width: 52rem;
    color: var(--color-graphite);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .model-list a:hover strong,
  .model-list a:hover > span:last-child {
    color: var(--color-probe);
  }

  .choice-map {
    color: var(--color-white);
    background: var(--color-carbon);
  }

  .choice-map__grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(3rem, 8vw, 8rem);
    padding-block: clamp(5rem, 9vw, 8rem);
  }

  .choice-map .eyebrow {
    color: var(--color-reading);
  }

  .choice-map h2 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(3.2rem, 5.8vw, 5.8rem);
    line-height: 0.94;
  }

  .choice-map nav {
    border-top: 1px solid var(--color-graphite);
  }

  .choice-map nav a {
    display: grid;
    grid-template-columns: 2.5rem 8rem 1fr;
    gap: 1rem;
    align-items: baseline;
    min-height: 5.5rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-graphite);
    text-decoration: none;
  }

  .choice-map nav span,
  .choice-map nav small {
    color: var(--color-carbon-muted);
    font-family: var(--font-data);
    font-size: 0.68rem;
    line-height: 1.5;
    text-transform: uppercase;
  }

  .choice-map nav strong {
    font-family: var(--font-display);
    font-size: 1.8rem;
  }

  .choice-map nav a:hover strong {
    color: var(--color-reading);
  }

  .trust-strip {
    display: grid;
    grid-template-columns: 4fr 5fr 2fr;
    gap: 3rem;
  }

  .trust-strip h2 {
    max-width: 11ch;
    margin: 0;
    font-size: clamp(2.8rem, 4.5vw, 4.4rem);
    line-height: 0.97;
  }

  .trust-strip__proofs {
    border-top: 1px solid var(--color-line);
  }

  .trust-strip__proofs > div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-line);
  }

  .trust-strip__proofs p {
    margin: 0;
    color: var(--color-graphite);
    font-size: 0.84rem;
    line-height: 1.55;
  }

  .trust-strip nav {
    display: grid;
    align-content: start;
    gap: 0.8rem;
  }

  .trust-strip nav a {
    color: var(--color-probe);
    font-weight: 600;
  }

  @media (max-width: 64rem) {
    .hero__copy {
      grid-column: 1 / span 7;
    }

    .hero-visual {
      grid-column: 7 / -1;
    }

    .front-page__grid {
      grid-template-columns: 1fr 1fr;
    }

    .lead-story {
      grid-column: 1 / -1;
      min-height: 22rem;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .trust-strip {
      grid-template-columns: 1fr 1fr;
    }

    .trust-strip nav {
      grid-column: 1 / -1;
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 48rem) {
    .hero,
    .section-heading,
    .front-page__grid,
    .choice-map__grid,
    .trust-strip {
      grid-template-columns: 1fr;
    }

    .hero__copy,
    .hero-visual,
    .lead-story,
    .trust-strip nav {
      grid-column: 1;
    }

    .hero {
      gap: 2.5rem;
      padding-top: 3rem;
    }

    .hero h1 {
      font-size: clamp(3.6rem, 18vw, 5rem);
    }

    .hero-visual figcaption {
      font-size: 0.6rem;
    }

    .section-heading {
      gap: 1.5rem;
    }

    .lead-story,
    .secondary-story,
    .front-page__method {
      min-height: auto;
      border-right: 0;
      border-bottom: 1px solid var(--color-line);
    }

    .lead-story h3,
    .secondary-story h3,
    .front-page__method h3 {
      margin-top: 4rem;
    }

    .model-list a {
      grid-template-columns: 2rem 1fr auto;
      padding-block: 1rem;
    }

    .model-list__meta {
      grid-column: 2;
    }

    .model-list a > span:last-child {
      grid-column: 3;
      grid-row: 1 / span 2;
    }

    .choice-map nav a {
      grid-template-columns: 2rem 1fr;
    }

    .choice-map nav small {
      grid-column: 2;
    }

    .trust-strip nav {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
